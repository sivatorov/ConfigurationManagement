<Window x:Class="Configuration_Management.GroupSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Configuration_Management.ViewModels"
        mc:Ignorable="d"
        Title="Управление группами"
        Icon="{StaticResource AppIcon}"
        Width="600"
        MinWidth="520"
        MinHeight="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI"
        FontSize="13"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ Список групп ============ -->
        <GroupBox Grid.Row="0" Header="Группы информационных баз" Padding="8" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TreeView x:Name="GroupsTree"
                          Grid.Column="0"
                          Margin="0,0,12,0"
                          MinHeight="260"
                          BorderThickness="1"
                          BorderBrush="{DynamicResource BorderBrushColor}"
                          Background="Transparent"
                          Foreground="{DynamicResource TextPrimaryBrush}">
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type vm:GroupNodeViewModel}"
                                                  ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <Border Width="14" Height="14" CornerRadius="3" Margin="0,0,8,0"
                                        VerticalAlignment="Center">
                                    <Border.Background>
                                        <SolidColorBrush Color="{Binding Color}"/>
                                    </Border.Background>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding Group.Description}" FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.Resources>
                </TreeView>

                <!-- ============ Кнопки управления ============ -->
                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                    <Button Style="{DynamicResource ModernButton}" Width="120"
                            Margin="0,0,0,8" Click="OnAddRoot_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="➕" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Добавить" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{DynamicResource SecondaryButton}" Width="120"
                            Margin="0,0,0,8" Click="OnAddSubgroup_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="➕" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Подгруппу" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{DynamicResource SecondaryButton}" Width="120"
                            Margin="0,0,0,8" Click="OnEdit_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✎" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Изменить" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{DynamicResource SecondaryButton}" Width="120"
                            Click="OnDelete_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🗑" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Удалить" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- ============ Кнопки ============ -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,0">
            <Button Width="120" Height="34" Style="{DynamicResource ModernButton}"
                    Margin="0,0,10,0" IsDefault="True" Click="OnDone_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✔" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Готово" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Width="120" Height="34" Style="{DynamicResource SecondaryButton}" IsCancel="True">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✖" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Отмена" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>