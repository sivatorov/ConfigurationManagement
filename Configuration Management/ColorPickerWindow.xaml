<Window x:Class="Configuration_Management.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Выбор цвета"
        Icon="{StaticResource AppIcon}"
        Height="520" Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        FontSize="13"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <!-- Кнопка цвета палитры (фон задаётся в code-behind из Tag) -->
        <Style x:Key="PaletteColorButton" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ============ Предпросмотр цвета ============ -->
        <Border x:Name="ColorPreview" Grid.Row="0" Grid.ColumnSpan="2"
                Height="56" CornerRadius="6" Margin="0,0,0,12"
                BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1"/>

        <!-- ============ Палитра предустановленных цветов ============ -->
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="Палитра:" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
        <UniformGrid x:Name="PaletteGrid" Grid.Row="2" Grid.ColumnSpan="2" Rows="2" Columns="8"
                     Margin="0,0,0,12">
            <Button Style="{StaticResource PaletteColorButton}" Tag="#EF4444" Click="OnPaletteColor_Click"/>
            <Button Style="{StaticResource PaletteColorButton}" Tag="#F97316" Click="OnPaletteColor_Click"/>
            <Button Style="{StaticResource PaletteColorButton}" Tag="#F59E0B" Click="OnPaletteColor_Click"/>
            <Button Style="{StaticResource PaletteColorButton}" Tag="#EAB308" Click="OnPaletteColor_Click"/>
            <Button Style="{StaticResource PaletteColorButton}" Tag="#84CC16" Click="OnPaletteColor_Click"/>
            <Button Style="{StaticResource PaletteColorButton}" Tag="#22C55E" Click="OnPaletteColor_Click"/>
            <Button Style="{StaticResource PaletteColorButton}" Tag="#10B981" Click="OnPaletteColor_Click"/>
            <Button Style="{StaticResource PaletteColorButton}" Tag="#14B8A6" Click="OnPaletteColor_Click"/>
            <Button Style="{StaticResource PaletteColorButton}" Tag="#06B6D4" Click="OnPaletteColor_Click"/>
            <Button Style="{StaticResource PaletteColorButton}" Tag="#0EA5E9" Click="OnPaletteColor_Click"/>
            <Button Style="{StaticResource PaletteColorButton}" Tag="#3B82F6" Click="OnPaletteColor_Click"/>
            <Button Style="{StaticResource PaletteColorButton}" Tag="#2D6CDF" Click="OnPaletteColor_Click"/>
            <Button Style="{StaticResource PaletteColorButton}" Tag="#6366F1" Click="OnPaletteColor_Click"/>
            <Button Style="{StaticResource PaletteColorButton}" Tag="#8B5CF6" Click="OnPaletteColor_Click"/>
            <Button Style="{StaticResource PaletteColorButton}" Tag="#A855F7" Click="OnPaletteColor_Click"/>
            <Button Style="{StaticResource PaletteColorButton}" Tag="#D946EF" Click="OnPaletteColor_Click"/>
        </UniformGrid>

        <!-- ============ HEX ============ -->
        <TextBlock Grid.Row="3" Grid.Column="0" Text="HEX:" VerticalAlignment="Center" Margin="0,4"/>
        <TextBox x:Name="HexBox" Grid.Row="3" Grid.Column="1" Width="110" Padding="4,3"
                 Margin="8,4,0,4" TextChanged="OnHex_TextChanged"/>

        <!-- ============ RGB-слайдеры ============ -->
        <Grid Grid.Row="4" Grid.ColumnSpan="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="R" Foreground="#EF4444" FontWeight="Bold" VerticalAlignment="Center"/>
            <Slider x:Name="RedSlider" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="OnRgb_ValueChanged"/>
            <TextBlock x:Name="RedValue" Grid.Column="2" Text="0" TextAlignment="Right"
                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
        </Grid>
        <Grid Grid.Row="5" Grid.ColumnSpan="2" Margin="0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="G" Foreground="#10B981" FontWeight="Bold" VerticalAlignment="Center"/>
            <Slider x:Name="GreenSlider" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="OnRgb_ValueChanged"/>
            <TextBlock x:Name="GreenValue" Grid.Column="2" Text="0" TextAlignment="Right"
                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
        </Grid>
        <Grid Grid.Row="6" Grid.ColumnSpan="2" Margin="0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="B" Foreground="#2D6CDF" FontWeight="Bold" VerticalAlignment="Center"/>
            <Slider x:Name="BlueSlider" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="OnRgb_ValueChanged"/>
            <TextBlock x:Name="BlueValue" Grid.Column="2" Text="0" TextAlignment="Right"
                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
        </Grid>

        <!-- ============ Кнопки ============ -->
        <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Width="90" Style="{DynamicResource ModernButton}" Margin="0,0,8,0" IsDefault="True" Click="OnOk_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✔" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="OK" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Width="90" Style="{DynamicResource SecondaryButton}" IsCancel="True">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✖" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Отмена" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>