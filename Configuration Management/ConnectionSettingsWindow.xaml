<Window x:Class="Configuration_Management.ConnectionSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:Configuration_Management.Models"
        xmlns:conv="clr-namespace:Configuration_Management.Converters"
        mc:Ignorable="d"
        Title="Настройки подключения"
        Icon="{StaticResource AppIcon}"
        Width="520"
        MinHeight="560" MinWidth="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI"
        FontSize="13"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:GroupFullPathConverter x:Key="GroupFullPathConverter"/>

        <!-- Implicit-стили для корректного отображения в тёмной теме -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}"/>
        <Style TargetType="ComboBox" BasedOn="{StaticResource ModernComboBox}"/>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ Основные параметры -->
        <GroupBox Grid.Row="0" Header="Основные параметры" Padding="8" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Наименование:" VerticalAlignment="Center" Margin="0,4"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" Padding="4,3"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Группа:" VerticalAlignment="Center" Margin="0,4"/>
                <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,4" Padding="4,3"
                          ItemsSource="{Binding Groups}"
                          SelectedItem="{Binding SelectedGroup, UpdateSourceTrigger=PropertyChanged}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource GroupFullPathConverter}">
                                        <Binding Path="."/>
                                        <Binding Path="DataContext.Groups"
                                                 RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Описание:" VerticalAlignment="Center" Margin="0,4"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" Padding="4,3"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Версия платформы:" VerticalAlignment="Center" Margin="0,4"/>
                <Grid Grid.Row="3" Grid.Column="1" Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding PlatformVersion, UpdateSourceTrigger=PropertyChanged}"
                             Padding="4,3" VerticalContentAlignment="Center"
                             ToolTip="Введите версию платформы вручную (например, 8.3.24.1774)"/>
                    <Button Grid.Column="1" Content="📋" Margin="6,0,0,0" Padding="8,3"
                            Style="{DynamicResource SecondaryButton}" Click="OnPlatformSettings_Click"
                            ToolTip="Выбрать версию платформы из установленных"/>
                </Grid>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Режим запуска:" VerticalAlignment="Top" Margin="0,6"/>
                <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,2">
                    <RadioButton Content="Автоматический" IsChecked="{Binding IsAutoMode, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"/>
                    <RadioButton Content="Тонкий клиент" IsChecked="{Binding IsThinClient, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"/>
                    <RadioButton Content="Толстый клиент" IsChecked="{Binding IsThickClient, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"/>
                    <RadioButton Content="Веб-клиент" IsChecked="{Binding IsWebClient, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"/>
                </StackPanel>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Параметры запуска:" VerticalAlignment="Center" Margin="0,4"/>
                <Grid Grid.Row="5" Grid.Column="1" Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding LaunchParameters, UpdateSourceTrigger=PropertyChanged}"
                             Padding="4,3" VerticalContentAlignment="Center"
                             ToolTip="Дополнительные параметры командной строки 1С (например, /UC, /DisableStartupMessages)"/>
                    <Button Grid.Column="1" Content="⚙ Конфигуратор" Margin="6,0,0,0" Padding="8,3"
                            Style="{DynamicResource SecondaryButton}" Click="OnLaunchParameters_Click"/>
                </Grid>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="ID базы:" VerticalAlignment="Center" Margin="0,4"/>
                <Grid Grid.Row="6" Grid.Column="1" Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding Id}" Padding="4,3"
                             IsReadOnly="True" ToolTip="Уникальный идентификатор базы данных"/>
                    <Button Grid.Column="1" Content="📋" Margin="6,0,0,0" Padding="8,3"
                            Style="{DynamicResource SecondaryButton}" Click="OnCopyId_Click"
                            ToolTip="Скопировать ID базы в буфер обмена"/>
                </Grid>
            </Grid>
        </GroupBox>

        <!-- ============ Параметры подключения -->
        <GroupBox Grid.Row="1" Header="Параметры подключения" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Тип подключения:" VerticalAlignment="Top" Margin="0,6"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,2">
                    <RadioButton Content="На сервере 1С:Предприятия" Margin="0,2"
                                 IsChecked="{Binding IsClientServer, UpdateSourceTrigger=PropertyChanged}"/>
                    <RadioButton Content="В файловой информационной базе" Margin="0,2"
                                 IsChecked="{Binding IsFile, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- Клиент-серверные поля -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Сервер:" VerticalAlignment="Center" Margin="0,4"
                           Visibility="{Binding IsClientServer, Converter={StaticResource BoolToVis}}"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Server, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" Padding="4,3"
                         Visibility="{Binding IsClientServer, Converter={StaticResource BoolToVis}}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Имя базы:" VerticalAlignment="Center" Margin="0,4"
                           Visibility="{Binding IsClientServer, Converter={StaticResource BoolToVis}}"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DatabaseName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" Padding="4,3"
                         Visibility="{Binding IsClientServer, Converter={StaticResource BoolToVis}}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Порт сервера:" VerticalAlignment="Center" Margin="0,4"
                           Visibility="{Binding IsClientServer, Converter={StaticResource BoolToVis}}"/>
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" Padding="4,3"
                         Visibility="{Binding IsClientServer, Converter={StaticResource BoolToVis}}"/>

                <!-- Файловые поля -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Путь к файлу:" VerticalAlignment="Center" Margin="0,4"
                           Visibility="{Binding IsFile, Converter={StaticResource BoolToVis}}"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" Padding="4,3"
                         Visibility="{Binding IsFile, Converter={StaticResource BoolToVis}}"/>

                <!-- Аутентификация -->
                <CheckBox Grid.Row="4" Grid.Column="1" Content="Использовать аутентификацию ОС" Margin="0,4"
                         IsChecked="{Binding UseOsAuthentication, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Пользователь:" VerticalAlignment="Center" Margin="0,4"
                           Visibility="{Binding IsCredentialsVisible, Converter={StaticResource BoolToVis}}"/>
                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding User, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" Padding="4,3"
                         Visibility="{Binding IsCredentialsVisible, Converter={StaticResource BoolToVis}}"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="Пароль:" VerticalAlignment="Center" Margin="0,4"
                           Visibility="{Binding IsCredentialsVisible, Converter={StaticResource BoolToVis}}"/>
                <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" Padding="4,3"
                         Visibility="{Binding IsCredentialsVisible, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </GroupBox>

        <!-- ============ Кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Width="120" Height="34" Style="{DynamicResource ModernButton}"
                    Margin="0,0,10,0" IsDefault="True" Click="OnSave_Click"
                    IsEnabled="{Binding HasChanges}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="💾" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Сохранить" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Width="120" Height="34" Style="{DynamicResource SecondaryButton}" IsCancel="True">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✖" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Отмена" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>