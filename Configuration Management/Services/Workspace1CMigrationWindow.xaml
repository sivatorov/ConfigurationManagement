<Window x:Class="Configuration_Management.Services.Workspace1CMigrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:loc="clr-namespace:Configuration_Management.Localization"
        Title="{loc:Loc Workspace1C.Title}"
        Icon="{StaticResource AppIcon}"
        SizeToContent="Height"
        Width="560"
        MaxWidth="640"
        MinWidth="520"
        MinHeight="240"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        FontSize="13"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
    </Window.Resources>

    <Border Padding="0" CornerRadius="12" Background="{DynamicResource CardBackgroundBrush}">
        <Grid Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Иконка (общая для всех этапов диалога) -->
            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Margin="0,0,16,0"
                    VerticalAlignment="Top"
                    Background="{DynamicResource ItemHoverBrush}">
                <materialDesign:PackIcon Kind="CloudDownloadOutline"
                                         Width="24" Height="24" Foreground="{DynamicResource AccentBrush}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1">

                <!-- Этап 1: предложение перейти на Workspace 1C -->
                <StackPanel x:Name="OfferPanel">
                    <TextBlock x:Name="HeadingText" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="DialogText" Margin="0,10,0,0" TextWrapping="Wrap"/>

                    <!-- Кнопки: «Скачать» (основная), «Открыть страницу», «Позже» -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button x:Name="DownloadButton" Width="150" Height="34" Padding="0" IsDefault="True"
                                Background="#16A34A" BorderThickness="0" Cursor="Hand" Foreground="White"
                                Margin="0,0,10,0"
                                Click="OnDownloadClick">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="18,6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#15803D"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#166534"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock x:Name="DownloadText" Text="{loc:Loc Workspace1C.Download}" VerticalAlignment="Center"
                                       Foreground="White" FontWeight="Bold" FontSize="13"/>
                        </Button>
                        <Button x:Name="OpenPageButton" Width="150" Height="34"
                                Background="Transparent" BorderThickness="1.5"
                                BorderBrush="{DynamicResource BorderBrushColor}"
                                Cursor="Hand" Margin="0,0,10,0"
                                Click="OnOpenPageClick">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="8" Padding="14,6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock x:Name="OpenPageText" Text="{loc:Loc Workspace1C.OpenPage}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </Button>
                        <Button x:Name="LaterButton" Width="100" Height="34"
                                Background="Transparent" BorderThickness="1.5"
                                BorderBrush="{DynamicResource BorderBrushColor}"
                                Cursor="Hand"
                                Click="OnLaterClick">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="8" Padding="14,6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock x:Name="LaterText" Text="{loc:Loc Workspace1C.Later}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- Этап 2: скачивание с прогрессом в этом же окне -->
                <StackPanel x:Name="ProgressPanel" Visibility="Collapsed">
                    <TextBlock x:Name="ProgressHeadingText" FontSize="15" FontWeight="Bold"
                               Text="{loc:Loc Workspace1C.Downloading}" TextWrapping="Wrap"/>
                    <ProgressBar x:Name="ProgressBar" Height="6" Margin="0,16,0,0" Maximum="100"
                                 Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock x:Name="ProgressText" Margin="0,8,0,0" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>

                <!-- Этап 3: завершение — путь к файлу и кнопка «Открыть папку» -->
                <StackPanel x:Name="DonePanel" Visibility="Collapsed">
                    <TextBlock x:Name="DoneText" FontSize="13" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button x:Name="OpenFolderButton" Width="150" Height="34" Padding="0" IsDefault="True"
                                Background="#16A34A" BorderThickness="0" Cursor="Hand" Foreground="White"
                                Margin="0,0,10,0"
                                Click="OnOpenFolderClick">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="18,6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#15803D"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#166534"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock x:Name="OpenFolderText" Text="{loc:Loc Workspace1C.OpenFolder}" VerticalAlignment="Center"
                                       Foreground="White" FontWeight="Bold" FontSize="13"/>
                        </Button>
                        <Button x:Name="DoneCloseButton" Width="100" Height="34"
                                Background="Transparent" BorderThickness="1.5"
                                BorderBrush="{DynamicResource BorderBrushColor}"
                                Cursor="Hand"
                                Click="OnDoneCloseClick">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="8" Padding="14,6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="{loc:Loc Common.Close}"
                                       VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- Этап 4: ошибка — встроена в это же окно, чтобы при сбое
                     не открывалось дополнительное окно поверх. -->
                <StackPanel x:Name="ErrorPanel" Visibility="Collapsed">
                    <TextBlock x:Name="ErrorHeadingText" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"
                               Foreground="#DC2626"
                               Text="{loc:Loc Workspace1C.ErrorTitle}"/>
                    <TextBlock x:Name="ErrorText" Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Button x:Name="ErrorCloseButton" Width="100" Height="34" Margin="0,20,0,0"
                            HorizontalAlignment="Right"
                            Background="Transparent" BorderThickness="1.5"
                            BorderBrush="{DynamicResource BorderBrushColor}"
                            Cursor="Hand"
                            Click="OnDoneCloseClick">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8" Padding="14,6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="{loc:Loc Common.Close}"
                                   VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </Button>
                </StackPanel>

            </StackPanel>
        </Grid>
    </Border>
</Window>