<Window x:Class="Configuration_Management.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:Configuration_Management.Models"
        xmlns:vm="clr-namespace:Configuration_Management.ViewModels"
        xmlns:controls="clr-namespace:Configuration_Management.Controls"
        xmlns:loc="clr-namespace:Configuration_Management.Localization"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="{loc:Loc Settings.Title}"
        Icon="{StaticResource AppIcon}"
        Width="880"
        MinWidth="760"
        MinHeight="560"
        Height="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI"
        FontSize="13"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- «Голый» тумблер без подписи: переключает только сам выключатель,
             в отличие от SettingsToggle, где кликабельна вся строка. Используется
             в списке колонок, чтобы клик по названию лишь выбирал строку. -->
        <Style x:Key="ColumnVisibilitySwitch" TargetType="ToggleButton">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" CornerRadius="11" Background="#CBD5E1">
                            <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="White"
                                     HorizontalAlignment="Left" Margin="3,0,0,0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Implicit-стили для корректного отображения в тёмной теме -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}"/>
        <Style TargetType="ComboBox" BasedOn="{StaticResource ModernComboBox}"/>
        <Style TargetType="TreeViewItem" BasedOn="{StaticResource ModernTreeViewItem}"/>
        <Style TargetType="CheckBox" BasedOn="{StaticResource ModernMaterialCheckBox}">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Grid.RowSpan="2"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"/>
                            <Border Grid.Row="0" Background="{TemplateBinding Background}"
                                    Padding="12,8,12,0" Margin="8,0,0,0" HorizontalAlignment="Left">
                                <ContentPresenter ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
                                                  TextElement.FontWeight="SemiBold"
                                                  TextElement.FontSize="13"/>
                            </Border>
                            <ContentPresenter Grid.Row="1" Margin="{TemplateBinding Padding}"
                                              TextElement.Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- ===================== Стиль вкладок (слева, вертикальная панель) ===================== -->
        <Style x:Key="SettingsTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="TabStripPlacement" Value="Left"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Отступ снизу у списка вкладок — выделение последней не обрезается -->
                            <Border Grid.Column="0" Padding="0,4,8,12" Background="Transparent"
                                    ClipToBounds="False">
                                <StackPanel IsItemsHost="True" ClipToBounds="False"/>
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              ContentSource="SelectedContent"
                                              Margin="8,0,0,0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsTabItem" TargetType="TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Width" Value="235"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <!-- Полный фон + скругление; снизу запас Margin у TabItem, чтобы не обрезалось -->
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,3,0"
                                CornerRadius="8"
                                Width="{TemplateBinding Width}"
                                MinHeight="40"
                                SnapsToDevicePixels="True"
                                ClipToBounds="False"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                            </MultiTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TreeSelectedBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Горизонтальные вкладки второго уровня (Отображение → группы) -->
        <Style x:Key="SettingsSubTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="TabStripPlacement" Value="Top"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Полоса вкладок: равная ширина, общая линия снизу -->
                            <Border Grid.Row="0"
                                    BorderBrush="{DynamicResource BorderBrushColor}"
                                    BorderThickness="0,0,0,1"
                                    Margin="0,0,0,10">
                                <UniformGrid Rows="1" IsItemsHost="True"/>
                            </Border>
                            <ContentPresenter Grid.Row="1"
                                              ContentSource="SelectedContent"
                                              Margin="{TemplateBinding Padding}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsSubTabItem" TargetType="TabItem">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,10"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,3"
                                Margin="0,0,0,-1"
                                SnapsToDevicePixels="True"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </MultiTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <!-- Только нижняя акцентная линия — без заливки, чтобы не спорить с боковым меню -->
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="SettingsTabs" Grid.Row="0" Grid.RowSpan="2" Style="{StaticResource SettingsTabControl}"
                    HorizontalAlignment="Stretch">
            <TabControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical"/>
                </ItemsPanelTemplate>
            </TabControl.ItemsPanel>

            <!-- ============ Вкладка «Платформы» ============ -->
            <TabItem Style="{StaticResource SettingsTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Server" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                        <TextBlock Text="{loc:Loc Settings.TabPlatforms}" VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="4,12,4,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{loc:Loc Settings.Platforms.Intro}"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"
                               TextWrapping="Wrap"/>

                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TreeView x:Name="PlatformsTree" Grid.Column="0" MinHeight="180"
                                  Background="{DynamicResource CardBackgroundBrush}"
                                  BorderBrush="{DynamicResource BorderBrushColor}"
                                  BorderThickness="1"
                                  Padding="6,4"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ToolTip="{loc:Loc Settings.Platforms.TreeTooltip}">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate DataType="{x:Type models:PlatformVersionGroup}"
                                                          ItemsSource="{Binding Children}">
                                    <Border Margin="0,2" Padding="6,4" CornerRadius="4"
                                            Background="{DynamicResource ItemHoverBrush}"
                                            ToolTip="{Binding Path}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Grid.Column="0" Width="14" Height="14"
                                                                     Margin="0,2,8,0" VerticalAlignment="Top">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Setter Property="Kind" Value="Folder"/>
                                                        <Setter Property="Foreground" Value="#F59E0B"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Kind}" Value="Line">
                                                                <Setter Property="Kind" Value="Folder"/>
                                                                <Setter Property="Foreground" Value="#F59E0B"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Kind}" Value="BuildGroup">
                                                                <Setter Property="Kind" Value="FolderOpen"/>
                                                                <Setter Property="Foreground" Value="#3B82F6"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Kind}" Value="LeafX64">
                                                                <Setter Property="Kind" Value="CubeOutline"/>
                                                                <Setter Property="Foreground" Value="#22C55E"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Kind}" Value="LeafX32">
                                                                <Setter Property="Kind" Value="Cube"/>
                                                                <Setter Property="Foreground" Value="#8B5CF6"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Kind}" Value="Leaf">
                                                                <Setter Property="Kind" Value="Application"/>
                                                                <Setter Property="Foreground" Value="#0EA5E9"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Path}" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Path}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem" BasedOn="{StaticResource ModernTreeViewItem}">
                                    <Setter Property="IsExpanded" Value="True"/>
                                </Style>
                            </TreeView.ItemContainerStyle>
                        </TreeView>
                        <Button Grid.Column="1" Margin="6,0,0,0" Padding="10,6"
                                VerticalAlignment="Top"
                                Style="{DynamicResource SecondaryButton}"
                                Click="OnRefreshPlatforms_Click"
                                ToolTip="{loc:Loc Settings.Platforms.RefreshTooltip}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Foreground="#3B82F6" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc Settings.Platforms.Refresh}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBlock x:Name="StatusText" Grid.Row="2"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                               TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <!-- Дополнительные пути поиска -->
                    <GroupBox Grid.Row="3" Header="{loc:Loc Settings.AdditionalPaths}" Padding="10,8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0"
                                       Text="{loc:Loc Settings.AdditionalPaths.Hint}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <ListBox x:Name="AdditionalPathsList" Grid.Row="1"
                                     MinHeight="80" MaxHeight="140"
                                     Background="{DynamicResource CardBackgroundBrush}"
                                     BorderBrush="{DynamicResource BorderBrushColor}"
                                     BorderThickness="1"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     SelectionMode="Single"
                                     ToolTip="{loc:Loc Settings.AdditionalPaths.ListTooltip}"/>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Padding="10,6" Margin="0,0,8,0"
                                        Style="{DynamicResource SecondaryButton}"
                                        Click="OnAddPlatformPath_Click"
                                        ToolTip="{loc:Loc Settings.AdditionalPaths.AddTooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FolderPlus" Width="16" Height="16" Foreground="#22C55E" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{loc:Loc Settings.AdditionalPaths.Add}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Padding="10,6" Margin="0,0,8,0"
                                        Style="{DynamicResource SecondaryButton}"
                                        Click="OnEditPlatformPath_Click"
                                        ToolTip="{loc:Loc Settings.AdditionalPaths.EditTooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FolderEdit" Width="16" Height="16" Foreground="#F59E0B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{loc:Loc Common.Edit}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Padding="10,6"
                                        Style="{DynamicResource SecondaryButton}"
                                        Click="OnRemovePlatformPath_Click"
                                        ToolTip="{loc:Loc Settings.AdditionalPaths.RemoveTooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FolderRemove" Width="16" Height="16" Foreground="#EF4444" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{loc:Loc Common.Delete}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <!-- Разрядность по умолчанию -->
                    <GroupBox Grid.Row="4" Header="{loc:Loc Settings.DefaultArch}" Padding="10,8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0"
                                       Text="{loc:Loc Settings.DefaultArch.Hint}"/>
                            <ComboBox x:Name="DefaultArchComboBox" Grid.Column="1" Width="200"
                                      HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ============ Вкладка «Отображение» ============ -->
            <TabItem Style="{StaticResource SettingsTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Eye" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                        <TextBlock Text="{loc:Loc Settings.TabDisplay}" VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                    </StackPanel>
                </TabItem.Header>
                <TabControl Margin="0,4,0,0" Style="{StaticResource SettingsSubTabControl}">
                    <!-- Значки и кнопки -->
                    <TabItem Style="{StaticResource SettingsSubTabItem}">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="StarOutline" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"
                                                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                                <TextBlock Text="{loc:Loc Settings.Subtab.Icons}" VerticalAlignment="Center" ToolTip="{loc:Loc Settings.Subtab.IconsTooltip}"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                            </StackPanel>
                        </TabItem.Header>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,4,4,4">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Settings.Icons.Description}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <ToggleButton Style="{DynamicResource SettingsToggle}" x:Name="ShowFavoritesButtonCheck" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Star" Width="16" Height="16" Foreground="#FBBF24" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{loc:Loc Settings.Icons.FavoritesButton}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Style="{DynamicResource SettingsToggle}" x:Name="ShowPinnedButtonCheck" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Pin" Width="16" Height="16" Foreground="#F59E0B" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{loc:Loc Settings.Icons.PinButton}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Style="{DynamicResource SettingsToggle}" x:Name="ShowTagsCheck" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="TagOutline" Width="16" Height="16" Foreground="#EC4899" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{loc:Loc Settings.Icons.Tags}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Style="{DynamicResource SettingsToggle}" x:Name="ShowTagFilterPanelCheck">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FilterVariant" Width="16" Height="16" Foreground="#EC4899" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{loc:Loc Settings.Icons.TagFilterPanel}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ToggleButton>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Колонки -->
                    <TabItem Style="{StaticResource SettingsSubTabItem}">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ViewColumn" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"
                                                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                                <TextBlock Text="{loc:Loc Settings.Subtab.Columns}" VerticalAlignment="Center" ToolTip="{loc:Loc Settings.Subtab.ColumnsTooltip}"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                            </StackPanel>
                        </TabItem.Header>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,4,4,4">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Settings.Columns.Description}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <!-- Видимость и порядок колонок задаются в одном списке:
                                     слева название колонки, справа тумблер видимости,
                                     порядок меняется кнопками «Вверх»/«Вниз». -->
                                <TextBlock Text="{loc:Loc Settings.Columns.OrderTitle}" FontWeight="SemiBold" FontSize="14"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,12,0,4"/>
                                <TextBlock Text="{loc:Loc Settings.Columns.OrderHint}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <!-- Список колонок и кнопки «Вверх»/«Вниз» справа, как во вкладке «Клавиши». -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderBrushColor}"
                                            BorderThickness="1" CornerRadius="8" Padding="8,6">
                                        <StackPanel>
                                            <!-- Колонка «Название» закреплена и всегда первая (тумблер неактивен). -->
                                            <ToggleButton Style="{DynamicResource SettingsToggle}" x:Name="ShowNameColumnCheck" IsChecked="True" IsEnabled="False">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="FormatTitle" Width="16" Height="16" Foreground="#3B82F6" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{loc:Loc Column.Name}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </ToggleButton>
                                            <Separator Margin="0,2,0,4"/>
                                            <ListBox x:Name="ColumnOrderList" MinHeight="180" MaxHeight="240"
                                                     BorderThickness="0" Background="Transparent"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                     SelectionChanged="OnColumnOrderList_SelectionChanged">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="Padding" Value="4,2"/>
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <!-- Название выбирает строку, тумблер справа — только видимость. -->
                                                        <Grid Margin="4,3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                                        VerticalAlignment="Center">
                                                                <materialDesign:PackIcon Kind="{Binding IconKind}" Width="16" Height="16"
                                                                                         Foreground="{DynamicResource TextSecondaryBrush}"
                                                                                         Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding Display}"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                                           ToolTip="{loc:Loc Settings.Columns.RowSelectHint}"/>
                                                            </StackPanel>
                                                            <ToggleButton Grid.Column="1"
                                                                          Style="{StaticResource ColumnVisibilitySwitch}"
                                                                          IsChecked="{Binding Visible, Mode=TwoWay}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Top">
                                        <Button Style="{DynamicResource SecondaryButton}" Padding="10,6" Margin="0,0,0,6" IsEnabled="False"
                                                x:Name="ColumnOrderUpButton"
                                                Click="OnColumnOrderUp_Click" ToolTip="{loc:Loc Settings.Columns.MoveUpTooltip}">
                                            <materialDesign:PackIcon Kind="ArrowUp" Width="18" Height="18"/>
                                        </Button>
                                        <Button Style="{DynamicResource SecondaryButton}" Padding="10,6" IsEnabled="False"
                                                x:Name="ColumnOrderDownButton"
                                                Click="OnColumnOrderDown_Click" ToolTip="{loc:Loc Settings.Columns.MoveDownTooltip}">
                                            <materialDesign:PackIcon Kind="ArrowDown" Width="18" Height="18"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Панели -->
                    <TabItem Style="{StaticResource SettingsSubTabItem}">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="PageLayoutSidebarRight" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"
                                                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                                <TextBlock Text="{loc:Loc Settings.Subtab.Panels}" VerticalAlignment="Center" ToolTip="{loc:Loc Settings.Subtab.PanelsTooltip}"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                            </StackPanel>
                        </TabItem.Header>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,4,4,4">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Settings.Panels.Description}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <ToggleButton Style="{DynamicResource SettingsToggle}" x:Name="ShowRightPanelDetailsCheck" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="PageLayoutSidebarRight" Width="16" Height="16" Foreground="#14B8A6" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{loc:Loc Settings.Panels.RightPanelDetails}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ToggleButton>
                                <TextBlock Text="{loc:Loc Settings.Panels.RightPanelDetailsHint}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="24,0,0,12"/>
                                <ToggleButton Style="{DynamicResource SettingsToggle}" x:Name="ShowSessionLaunchPanelCheck" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Monitor" Width="16" Height="16" Foreground="#8B5CF6" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{loc:Loc Settings.Panels.SessionLaunchPanel}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ToggleButton>
                                <TextBlock Text="{loc:Loc Settings.Panels.SessionLaunchPanelHint}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="24,0,0,12"/>
                                <ToggleButton Style="{DynamicResource SettingsToggle}" x:Name="GroupByGroupCheck" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FolderMultiple" Width="16" Height="16" Foreground="#3B82F6" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{loc:Loc Settings.Panels.GroupByGroups}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Style="{DynamicResource SettingsToggle}" x:Name="ShowFavoritesOnlyCheck">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="StarCircle" Width="16" Height="16" Foreground="#FBBF24" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{loc:Loc Settings.Panels.ShowFavoritesOnly}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Style="{DynamicResource SettingsToggle}" x:Name="ShowEmptyGroupsCheck" Margin="0,6,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FolderOutline" Width="16" Height="16" Foreground="#0EA5E9" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{loc:Loc Settings.Panels.ShowEmptyGroups}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ToggleButton>
                                <TextBlock Text="{loc:Loc Settings.Panels.ShowEmptyGroupsHint}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="24,0,0,12"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Нижняя панель -->
                    <TabItem Style="{StaticResource SettingsSubTabItem}">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="DockBottom" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"
                                                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                                <TextBlock Text="{loc:Loc Settings.Subtab.Status}" VerticalAlignment="Center" ToolTip="{loc:Loc Settings.Subtab.StatusTooltip}"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                            </StackPanel>
                        </TabItem.Header>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,4,4,4">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Settings.Status.Description}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <ToggleButton Style="{DynamicResource SettingsToggle}" x:Name="StatusShowConnectionPathCheck" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FolderOutline" Width="16" Height="16" Foreground="#3B82F6" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{loc:Loc Settings.Status.ConnectionPath}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Style="{DynamicResource SettingsToggle}" x:Name="StatusShowPortCheck" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Lan" Width="16" Height="16" Foreground="#6366F1" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{loc:Loc Settings.Status.Port}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Style="{DynamicResource SettingsToggle}" x:Name="StatusShowArchitectureCheck" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Chip" Width="16" Height="16" Foreground="#8B5CF6" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{loc:Loc Settings.Status.Architecture}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Style="{DynamicResource SettingsToggle}" x:Name="StatusShowPlatformVersionCheck" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CubeOutline" Width="16" Height="16" Foreground="#A855F7" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{loc:Loc Column.Version}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Style="{DynamicResource SettingsToggle}" x:Name="StatusShowLaunchModeCheck" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="PlayCircleOutline" Width="16" Height="16" Foreground="#22C55E" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{loc:Loc Column.LaunchMode}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Style="{DynamicResource SettingsToggle}" x:Name="StatusShowClientTypeCheck" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Monitor" Width="16" Height="16" Foreground="#EC4899" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{loc:Loc Settings.Status.ClientType}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Style="{DynamicResource SettingsToggle}" x:Name="StatusShowConnectionTypeCheck" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Database" Width="16" Height="16" Foreground="#6366F1" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{loc:Loc Settings.Status.ConnectionType}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Style="{DynamicResource SettingsToggle}" x:Name="StatusShowUserCheck" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Account" Width="16" Height="16" Foreground="#94A3B8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{loc:Loc Settings.Status.User}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Style="{DynamicResource SettingsToggle}" x:Name="StatusShowIdCheck">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Identifier" Width="16" Height="16" Foreground="#0EA5E9" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{loc:Loc Settings.Status.Id}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ToggleButton>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Шрифт -->
                    <TabItem Style="{StaticResource SettingsSubTabItem}">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FormatFont" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"
                                                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                                <TextBlock Text="{loc:Loc Settings.Subtab.Font}" VerticalAlignment="Center" ToolTip="{loc:Loc Settings.Subtab.FontTooltip}"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                            </StackPanel>
                        </TabItem.Header>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,4,4,4">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Settings.Font.Description}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,0,0,12"/>
                                <TextBlock Text="{loc:Loc Settings.Font.Element}" Margin="0,0,0,6"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <ComboBox x:Name="ElementComboBox" Height="34" Margin="0,0,0,12"
                                          Style="{StaticResource ModernComboBox}"
                                          SelectionChanged="OnElement_SelectionChanged"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Settings.Font.Family}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="FontFamilyComboBox" Height="34"
                                              VerticalAlignment="Center" Style="{StaticResource ModernComboBox}"
                                              SelectionChanged="OnFontCombo_Changed"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Settings.Font.Size}" VerticalAlignment="Center" Margin="0,8,0,0"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="FontSizeComboBox" Height="34"
                                              VerticalAlignment="Center" Margin="0,8,0,0" Style="{StaticResource ModernComboBox}"
                                              IsEditable="True"
                                              KeyUp="OnFontSize_KeyUp"
                                              SelectionChanged="OnFontCombo_Changed"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Settings.Font.Style}" VerticalAlignment="Center" Margin="0,8,0,0"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="FontStyleComboBox" Height="34"
                                              VerticalAlignment="Center" Margin="0,8,0,0" Style="{StaticResource ModernComboBox}"
                                              SelectionChanged="OnFontCombo_Changed"/>
                                </Grid>
                                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrushColor}"
                                        BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                                    <TextBlock x:Name="FontPreviewText" Text="{loc:Loc Settings.Font.Preview}"
                                               Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                </Border>
                                <Button Style="{DynamicResource ModernButton}" Padding="12,6" HorizontalAlignment="Left"
                                        Click="OnFontApply_Click"
                                        ToolTip="{loc:Loc Settings.Font.ApplyTooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FormatFont" Width="16" Height="16" Foreground="{DynamicResource ButtonTextBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{loc:Loc Common.Apply}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                </TabControl>

            </TabItem>

            <!-- ============ Вкладка «Цветовое оформление» ============ -->
            <TabItem Style="{StaticResource SettingsTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Palette" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                        <TextBlock Text="{loc:Loc Settings.TabAppearance}" VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Margin="4,12,4,0" Padding="0,0,4,0">
                    <StackPanel>
                        <GroupBox Header="{loc:Loc Settings.Theme}" Padding="8" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{loc:Loc Settings.ThemeLabel}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <ComboBox x:Name="SchemeComboBox" Width="280" Height="34" Margin="10,0,0,0"
                                              VerticalAlignment="Center"
                                              Style="{StaticResource ModernComboBox}"
                                              SelectionChanged="OnSchemeCombo_SelectionChanged"/>
                                    <Button x:Name="ApplySchemeButton" Content="{loc:Loc Common.Apply}" Margin="10,0,0,0"
                                            Padding="12,5" VerticalAlignment="Center"
                                            Style="{DynamicResource ModernButton}"
                                            Click="OnApplyColorScheme_Click"
                                            ToolTip="{loc:Loc Settings.Theme.ApplyTooltip}"/>
                                </StackPanel>
                                <TextBlock Text="{loc:Loc Settings.Theme.Description}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <WrapPanel Orientation="Horizontal">
                                    <Button Style="{DynamicResource SecondaryButton}" Padding="10,6" Margin="0,0,8,4"
                                            Click="OnCreateScheme_Click"
                                            ToolTip="{loc:Loc Settings.CreateThemeTooltip}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Foreground="#22C55E" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{loc:Loc Settings.CreateTheme}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="RenameSchemeButton" Style="{DynamicResource SecondaryButton}" Padding="10,6" Margin="0,0,8,4"
                                            Click="OnRenameScheme_Click"
                                            ToolTip="{loc:Loc Settings.RenameTooltip}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Pencil" Width="16" Height="16" Foreground="#0EA5E9" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{loc:Loc Settings.Rename}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="DeleteSchemeButton" Style="{DynamicResource SecondaryButton}" Padding="10,6" Margin="0,0,8,4"
                                            Click="OnDeleteScheme_Click"
                                            ToolTip="{loc:Loc Settings.DeleteThemeTooltip}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Delete" Width="16" Height="16" Foreground="#EF4444" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{loc:Loc Common.Delete}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{DynamicResource SecondaryButton}" Padding="10,6" Margin="0,0,8,4"
                                            Click="OnResetSchemeColors_Click"
                                            ToolTip="{loc:Loc Settings.ResetColorsTooltip}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Restore" Width="16" Height="16" Foreground="#F59E0B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{loc:Loc Settings.ResetColors}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{DynamicResource SecondaryButton}" Padding="10,6" Margin="0,0,8,4"
                                            Click="OnExportScheme_Click"
                                            ToolTip="{loc:Loc Settings.ExportThemeTooltip}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Export" Width="16" Height="16" Foreground="#3B82F6" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{loc:Loc Settings.ExportTheme}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{DynamicResource SecondaryButton}" Padding="10,6" Margin="0,0,0,4"
                                            Click="OnImportScheme_Click"
                                            ToolTip="{loc:Loc Settings.ImportThemeTooltip}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Import" Width="16" Height="16" Foreground="#8B5CF6" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{loc:Loc Settings.ImportTheme}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="{loc:Loc Settings.Colors}" Padding="8" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Settings.Colors.Description}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <ItemsControl x:Name="ColorItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="36"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"
                                                           Margin="0,0,12,0" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <Border Grid.Column="1" Width="28" Height="20" CornerRadius="4"
                                                        BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1"
                                                        Background="{Binding ColorBrush}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Hex}" VerticalAlignment="Center"
                                                           Margin="12,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <Button Grid.Column="3" Content="{loc:Loc Settings.ChooseColor}" Padding="10,3"
                                                        Margin="12,0,0,0" VerticalAlignment="Center"
                                                        Style="{DynamicResource SecondaryButton}"
                                                        Tag="{Binding Key}"
                                                        Click="OnColorPick_Click"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ Вкладка «Клавиши» ============ -->
            <TabItem Style="{StaticResource SettingsTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="KeyboardOutline" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                        <TextBlock Text="{loc:Loc Settings.TabHotkeys}" VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Margin="4,12,4,0" Padding="0,0,4,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="{loc:Loc Settings.Hotkeys.Title}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <controls:HelpLink Margin="6,0,0,0"
                                               HelpText="{loc:Loc Settings.Hotkeys.HelpText}"/>
                        </StackPanel>
                        <TextBlock Text="{loc:Loc Settings.Hotkeys.Description}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Settings.Hotkeys.Enterprise}" VerticalAlignment="Center" Margin="0,0,0,6"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <controls:HotkeyBox x:Name="HotkeyEnterpriseBox" Grid.Row="0" Grid.Column="1"
                                                Height="34" Margin="0,0,0,6" FontSize="13"
                                                Style="{StaticResource ModernTextBox}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Settings.Hotkeys.Configurator}" VerticalAlignment="Center" Margin="0,0,0,6"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <controls:HotkeyBox x:Name="HotkeyConfiguratorBox" Grid.Row="1" Grid.Column="1"
                                                Height="34" Margin="0,0,0,6" FontSize="13"
                                                Style="{StaticResource ModernTextBox}"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Settings.Hotkeys.Favorites}" VerticalAlignment="Center" Margin="0,0,0,6"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <controls:HotkeyBox x:Name="HotkeyFavoriteBox" Grid.Row="2" Grid.Column="1"
                                                Height="34" Margin="0,0,0,6" FontSize="13"
                                                Style="{StaticResource ModernTextBox}"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc Settings.Hotkeys.Edit}" VerticalAlignment="Center" Margin="0,0,0,6"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <controls:HotkeyBox x:Name="HotkeyEditBox" Grid.Row="3" Grid.Column="1"
                                                Height="34" Margin="0,0,0,6" FontSize="13"
                                                Style="{StaticResource ModernTextBox}"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Loc Settings.Hotkeys.Delete}" VerticalAlignment="Center" Margin="0,0,0,6"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <controls:HotkeyBox x:Name="HotkeyDeleteBox" Grid.Row="4" Grid.Column="1"
                                                Height="34" Margin="0,0,0,6" FontSize="13"
                                                Style="{StaticResource ModernTextBox}"/>
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="{loc:Loc Settings.Hotkeys.ClearCache}" VerticalAlignment="Center" Margin="0,0,0,6"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <controls:HotkeyBox x:Name="HotkeyClearCacheBox" Grid.Row="5" Grid.Column="1"
                                                Height="34" Margin="0,0,0,6" FontSize="13"
                                                Style="{StaticResource ModernTextBox}"/>
                            <TextBlock Grid.Row="6" Grid.Column="0" Text="{loc:Loc Settings.Hotkeys.AddBase}" VerticalAlignment="Center" Margin="0,0,0,6"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <controls:HotkeyBox x:Name="HotkeyAddBox" Grid.Row="6" Grid.Column="1"
                                                Height="34" Margin="0,0,0,6" FontSize="13"
                                                Style="{StaticResource ModernTextBox}"/>
                            <TextBlock Grid.Row="7" Grid.Column="0" Text="{loc:Loc Settings.Hotkeys.Pin}" VerticalAlignment="Center" Margin="0,0,0,6"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <controls:HotkeyBox x:Name="HotkeyPinBox" Grid.Row="7" Grid.Column="1"
                                                Height="34" Margin="0,0,0,6" FontSize="13"
                                                Style="{StaticResource ModernTextBox}"/>
                            <TextBlock Grid.Row="8" Grid.Column="0" Text="{loc:Loc Settings.Hotkeys.ShowAll}" VerticalAlignment="Center" Margin="0,0,0,6"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <controls:HotkeyBox x:Name="HotkeyShowAllBox" Grid.Row="8" Grid.Column="1"
                                                Height="34" Margin="0,0,0,6" FontSize="13"
                                                Style="{StaticResource ModernTextBox}"/>
                            <TextBlock Grid.Row="9" Grid.Column="0" Text="{loc:Loc Settings.Hotkeys.ShowFavorites}" VerticalAlignment="Center" Margin="0,0,0,6"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <controls:HotkeyBox x:Name="HotkeyShowFavoritesBox" Grid.Row="9" Grid.Column="1"
                                                Height="34" Margin="0,0,0,6" FontSize="13"
                                                Style="{StaticResource ModernTextBox}"/>
                            <TextBlock Grid.Row="10" Grid.Column="0" Text="{loc:Loc Settings.Hotkeys.ShowRecent}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <controls:HotkeyBox x:Name="HotkeyShowRecentBox" Grid.Row="10" Grid.Column="1"
                                                Height="34" FontSize="13"
                                                Style="{StaticResource ModernTextBox}"/>
                        </Grid>

                        <TextBlock Text="{loc:Loc Settings.Hotkeys.FavoritesOrder}"
                                   FontWeight="SemiBold" Margin="0,4,0,6"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{loc:Loc Settings.Hotkeys.FavoritesOrderHint}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <Grid MinHeight="140" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ListBox x:Name="FavoriteHotkeysList" Grid.Column="0"
                                     MinHeight="140" MaxHeight="220"
                                     Background="{DynamicResource CardBackgroundBrush}"
                                     BorderBrush="{DynamicResource BorderBrushColor}"
                                     BorderThickness="1"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="4,2">
                                            <Border Background="{DynamicResource FavoriteBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Number, StringFormat=Alt+{0}}" FontWeight="Bold" FontSize="12" Foreground="#1C1917"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Top">
                                <Button Style="{DynamicResource SecondaryButton}" Padding="10,6" Margin="0,0,0,6"
                                        Click="OnFavoriteHotkeyUp_Click" ToolTip="{loc:Loc Settings.Hotkeys.MoveUpTooltip}">
                                    <materialDesign:PackIcon Kind="ArrowUp" Width="18" Height="18"/>
                                </Button>
                                <Button Style="{DynamicResource SecondaryButton}" Padding="10,6"
                                        Click="OnFavoriteHotkeyDown_Click" ToolTip="{loc:Loc Settings.Hotkeys.MoveDownTooltip}">
                                    <materialDesign:PackIcon Kind="ArrowDown" Width="18" Height="18"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ Вкладка «Настройки» ============ -->
            <TabItem Style="{StaticResource SettingsTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ApplicationCog" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                        <TextBlock Text="{loc:Loc Settings.TabGeneral}" VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Margin="4,12,4,0" Padding="0,0,4,0">
                    <StackPanel>
                        <GroupBox Header="{loc:Loc Settings.Language}" Padding="8" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{loc:Loc Settings.LanguageLabel}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <ComboBox x:Name="LanguageComboBox" Width="280" Height="34" Margin="10,0,0,0"
                                              VerticalAlignment="Center"
                                              Style="{StaticResource ModernComboBox}"
                                              SelectionChanged="OnLanguage_Changed"/>
                                </StackPanel>
                                <TextBlock Text="{loc:Loc Settings.Language.AppliedHint}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </GroupBox>

                        <TextBlock Text="{loc:Loc Settings.General.Behavior}"
                                   FontWeight="SemiBold" Margin="0,0,0,8"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <ToggleButton Style="{DynamicResource SettingsToggle}" x:Name="AllowMultipleInstancesCheck" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ApplicationOutline" Width="16" Height="16" Foreground="#3B82F6" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc Settings.General.AllowMultipleInstances}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Style="{DynamicResource SettingsToggle}" x:Name="CheckForUpdatesOnStartupCheck" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Update" Width="16" Height="16" Foreground="#22C55E" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc Settings.General.CheckForUpdatesOnStartup}" VerticalAlignment="Center"
                                           ToolTip="{loc:Loc Settings.General.CheckForUpdatesOnStartupTooltip}"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Style="{DynamicResource SettingsToggle}" x:Name="AutoUpdateEnabledCheck" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Update" Width="16" Height="16" Foreground="#22C55E" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc Settings.General.AutoUpdate}" VerticalAlignment="Center"
                                           ToolTip="{loc:Loc Settings.General.AutoUpdateTooltip}"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Style="{DynamicResource SettingsToggle}" x:Name="ShowTrayIconCheck" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TrayFull" Width="16" Height="16" Foreground="#14B8A6" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc Settings.General.ShowTrayIcon}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Style="{DynamicResource SettingsToggle}" x:Name="CloseToTrayCheck" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="WindowMinimize" Width="16" Height="16" Foreground="#F59E0B" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc Settings.General.CloseToTray}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Style="{DynamicResource SettingsToggle}" x:Name="EscapeToTrayCheck" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Keyboard" Width="16" Height="16" Foreground="#8B5CF6" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc Settings.General.EscapeToTray}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,6">
                            <materialDesign:PackIcon Kind="RocketLaunch" Width="16" Height="16" Foreground="#22C55E" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc Settings.General.AfterLaunchAction}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="AfterLaunchActionCombo" Width="230" Height="30"
                                      VerticalAlignment="Center"
                                      Style="{StaticResource ModernComboBox}"/>
                        </StackPanel>
                        <ToggleButton Style="{DynamicResource SettingsToggle}" x:Name="RememberWindowLayoutCheck">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Monitor" Width="16" Height="16" Foreground="#EC4899" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc Settings.General.RememberWindowLayout}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Style="{DynamicResource SettingsToggle}" x:Name="CompactModeCheck" Margin="0,12,0,0"
                                      Checked="OnCompactMode_Toggled" Unchecked="OnCompactMode_Toggled">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Compress" Width="16" Height="16" Foreground="#22C55E" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc Settings.CompactMode}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ Вкладка «ibases.v8i» ============ -->
            <TabItem Style="{StaticResource SettingsTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FileDocument" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                        <TextBlock Text="ibases.v8i" VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                    </StackPanel>
                </TabItem.Header>
                <!-- Прокрутка по вертикали, чтобы при маленьком окне данные не выходили за границы.
                     Горизонтальная прокрутка отключена, чтобы элементы растягивались по ширине окна. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Margin="4,12,4,0" Padding="0,0,4,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Settings.Ibases.Description}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,12,12"
                                   TextWrapping="Wrap"/>

                        <!-- Синхронизация с ibases.v8i -->
                        <GroupBox Header="{loc:Loc Settings.SyncSettings}" Padding="8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,-4,0,4">
                                    <controls:HelpLink HelpText="{loc:Loc Settings.Ibases.HelpText}"/>
                                </StackPanel>

                                <!-- Режим синхронизации: подпись слева, список тянется по ширине -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{loc:Loc Settings.Ibases.SyncMode}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <ComboBox x:Name="SyncModeComboBox" Grid.Column="1" Height="40" Margin="10,0,0,0" FontSize="14"
                                              VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                              Style="{StaticResource ModernComboBox}"
                                              SelectionChanged="OnSyncMode_SelectionChanged"/>
                                </Grid>

                                <!-- Файл: путь растягивается, кнопка обзора справа -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{loc:Loc Settings.Ibases.File}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBox x:Name="SyncFilePathTextBox" Grid.Column="1" Height="40" Margin="10,0,0,0" FontSize="14"
                                             VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                             Style="{StaticResource ModernTextBox}"/>
                                    <Button x:Name="BrowseSyncFileButton" Grid.Column="2" Content="{loc:Loc Common.Browse}" Margin="6,0,0,0"
                                            Padding="10,3" VerticalAlignment="Center"
                                            Style="{DynamicResource SecondaryButton}"
                                            Click="OnBrowseSyncFile_Click"
                                            ToolTip="{loc:Loc Settings.Ibases.BrowseTooltip}"/>
                                </Grid>

                                <!-- Условие запуска синхронизации -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{loc:Loc Settings.Ibases.SyncTrigger}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <ComboBox x:Name="SyncTriggerComboBox" Grid.Column="1" Height="40" Margin="10,0,0,0" FontSize="14"
                                              VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                              Style="{StaticResource ModernComboBox}"
                                              SelectionChanged="OnSyncTrigger_SelectionChanged"/>
                                </Grid>

                                <!-- Интервал и время расписания -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="SyncIntervalLabel" Text="{loc:Loc Settings.Ibases.Interval}"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBox x:Name="SyncIntervalTextBox" Grid.Column="1" Width="60" Margin="10,0,0,0"
                                             VerticalAlignment="Center" TextAlignment="Center"
                                             TextChanged="OnSyncInterval_TextChanged"/>
                                    <TextBlock x:Name="SyncScheduleLabel" Grid.Column="2" Text="{loc:Loc Settings.Ibases.ScheduleTime}"
                                               VerticalAlignment="Center" Margin="16,0,0,0"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBox x:Name="SyncScheduleTimePicker" Grid.Column="3" Width="70" Margin="10,0,0,0"
                                             VerticalAlignment="Center" TextAlignment="Center"
                                             TextChanged="OnSyncScheduleTime_TextChanged"/>
                                </Grid>

                                <TextBlock x:Name="SyncStatusText"
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                           Margin="0,4,0,8" TextWrapping="Wrap"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="SyncImportButton" Style="{DynamicResource SecondaryButton}"
                                            Padding="10,6" Margin="0,0,8,0"
                                            Click="OnSyncImport_Click"
                                            ToolTip="{loc:Loc Settings.Ibases.ImportTooltip}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Download" Width="16" Height="16" Foreground="#F97316" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{loc:Loc Settings.Ibases.Import}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="SyncExportButton" Style="{DynamicResource SecondaryButton}"
                                            Padding="10,6"
                                            Click="OnSyncExport_Click"
                                            ToolTip="{loc:Loc Settings.Ibases.ExportTooltip}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Upload" Width="16" Height="16" Foreground="#A855F7" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{loc:Loc Settings.Ibases.Export}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <Separator Margin="0,12,0,12"/>

                                <CheckBox x:Name="IbasesBackupEnabledCheck"
                                          Content="{loc:Loc Settings.BackupBeforeSync}"
                                          IsChecked="True" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal" Margin="24,0,0,6">
                                    <TextBlock Text="{loc:Loc Settings.Ibases.BackupKeepCount}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBox x:Name="IbasesBackupKeepCountBox" Width="50" Margin="8,0,0,0"
                                             Text="5" VerticalAlignment="Center"
                                             Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>
                                <TextBlock Text="{loc:Loc Settings.Ibases.BackupNote}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12" TextWrapping="Wrap" Margin="24,0,0,8"/>
                                <Button Style="{DynamicResource SecondaryButton}" Padding="10,6"
                                        HorizontalAlignment="Left"
                                        Click="OnRestoreIbasesBackup_Click"
                                        ToolTip="{loc:Loc Settings.Ibases.RestoreTooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="BackupRestore" Width="16" Height="16" Foreground="#0EA5E9" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{loc:Loc Settings.Ibases.Restore}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ Вкладка «Базы» ============ -->
            <TabItem Style="{StaticResource SettingsTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Database" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                        <TextBlock Text="{loc:Loc Settings.TabBases}" VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Margin="4,12,4,0" Padding="0,0,4,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Settings.Bases.Description}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"
                                   TextWrapping="Wrap"/>

                        <!-- Каталоги шаблонов — выше, т.к. часто нужны при создании ИБ -->
                        <GroupBox Header="{loc:Loc Settings.TemplateDirs}" Padding="8" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Settings.Bases.TemplateDirsHint}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                <ListBox x:Name="TemplatePathsList" MinHeight="100" MaxHeight="180" Margin="0,0,0,8"
                                         BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1"
                                         Background="{DynamicResource CardBackgroundBrush}"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                                <WrapPanel Orientation="Horizontal">
                                    <Button Style="{DynamicResource SecondaryButton}" Padding="10,6" Margin="0,0,8,4"
                                            Click="OnAddTemplatePath_Click"
                                            ToolTip="{loc:Loc Settings.Bases.AddTemplateTooltip}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FolderPlus" Width="16" Height="16" Foreground="#22C55E" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{loc:Loc Settings.Bases.AddTemplate}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{DynamicResource SecondaryButton}" Padding="10,6" Margin="0,0,8,4"
                                            Click="OnEditTemplatePath_Click"
                                            ToolTip="{loc:Loc Settings.Bases.EditTemplateTooltip}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FolderEdit" Width="16" Height="16" Foreground="#0EA5E9" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{loc:Loc Settings.Bases.EditTemplate}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{DynamicResource SecondaryButton}" Padding="10,6" Margin="0,0,8,4"
                                            Click="OnRemoveTemplatePath_Click"
                                            ToolTip="{loc:Loc Settings.Bases.RemoveTemplateTooltip}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FolderRemove" Width="16" Height="16" Foreground="#EF4444" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{loc:Loc Common.Delete}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{DynamicResource SecondaryButton}" Padding="10,6" Margin="0,0,0,4"
                                            Click="OnLoadDefaultTemplatePaths_Click"
                                            ToolTip="{loc:Loc Settings.Bases.LoadDefaultTooltip}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Download" Width="16" Height="16" Foreground="#8B5CF6" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{loc:Loc Settings.Bases.LoadDefault}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>

                        <!-- Экспорт / загрузка списка баз -->
                        <GroupBox Header="{loc:Loc Settings.IbaseList}" Padding="8" Margin="0,0,0,12">
                            <StackPanel>
                                <Button Style="{DynamicResource ModernButton}" Margin="0,0,0,8" Padding="10,8"
                                        HorizontalAlignment="Stretch"
                                        Click="OnExportInfobases_Click"
                                        ToolTip="{loc:Loc Settings.Bases.ExportListTooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Export" Width="16" Height="16" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{loc:Loc Settings.Bases.ExportList}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{DynamicResource SecondaryButton}" Margin="0,0,0,8" Padding="10,8"
                                        HorizontalAlignment="Stretch"
                                        Click="OnImportInfobases_Click"
                                        ToolTip="{loc:Loc Settings.Bases.ImportListTooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Import" Width="16" Height="16" Foreground="#F97316" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{loc:Loc Settings.Bases.ImportList}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{DynamicResource SecondaryButton}" Margin="0,0,0,8" Padding="10,8"
                                        HorizontalAlignment="Stretch"
                                        Click="OnImportIbasesV8i_Click"
                                        ToolTip="{loc:Loc Settings.Bases.ImportV8iTooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FileDownload" Width="16" Height="16" Foreground="#14B8A6" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{loc:Loc Settings.Bases.ImportV8i}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <CheckBox x:Name="AddTimestampToExportFileNameCheck"
                                          Content="{loc:Loc Settings.AddTimestamp}"
                                          Margin="0,6,0,0"
                                          ToolTip="{loc:Loc Settings.AddTimestampTooltip}"/>
                                <TextBlock Text="{loc:Loc Settings.Bases.TimestampFormat}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                           Margin="0,12,0,4"/>
                                <ComboBox x:Name="ExportTimestampFormatComboBox"
                                          Height="34" FontSize="13" MinWidth="280"
                                          Style="{StaticResource ModernComboBox}"
                                          IsEditable="True"
                                          IsTextSearchEnabled="True"
                                          StaysOpenOnEdit="True"
                                          SelectionChanged="OnExportTimestampFormat_SelectionChanged"
                                          ToolTip="{loc:Loc Settings.Bases.TimestampFormatTooltip}"/>
                                <TextBlock x:Name="ExportTimestampPreview"
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                           Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Сервис (по аналогии со StartManager) -->
                        <GroupBox Header="{loc:Loc Settings.Maintenance}" Padding="8" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Settings.Bases.MaintenanceHint}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"
                                           TextWrapping="Wrap"/>
                                <Button Style="{DynamicResource SecondaryButton}" Margin="0,0,0,8" Padding="10,8"
                                        HorizontalAlignment="Stretch"
                                        Click="OnRemoveMissingFileBases_Click"
                                        ToolTip="{loc:Loc Settings.Bases.RemoveMissingTooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FolderRemove" Width="16" Height="16" Foreground="#EF4444" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{loc:Loc Settings.Bases.RemoveMissing}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{DynamicResource SecondaryButton}" Padding="10,8"
                                        HorizontalAlignment="Stretch"
                                        Click="OnKillOneCProcesses_Click"
                                        ToolTip="{loc:Loc Settings.Bases.KillProcessesTooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CloseNetwork" Width="16" Height="16" Foreground="#F59E0B" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{loc:Loc Settings.Bases.KillProcesses}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </GroupBox>

                        <!-- Опасные операции -->
                        <GroupBox Header="{loc:Loc Settings.DangerousOps}" Padding="8" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Settings.Bases.DangerousHint}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"
                                           TextWrapping="Wrap"/>
                                <Button Style="{DynamicResource SecondaryButton}" Padding="10,8"
                                        HorizontalAlignment="Stretch"
                                        Click="OnClearAllInfobases_Click"
                                        ToolTip="{loc:Loc Settings.Bases.ClearAllTooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="DeleteForever" Width="16" Height="16" Foreground="#EF4444" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{loc:Loc Settings.Bases.ClearAll}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ Вкладка «О программе» ============ -->
            <TabItem Style="{StaticResource SettingsTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="InformationOutline" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                        <TextBlock Text="{loc:Loc Settings.TabAbout}" VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="4,12,4,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="{loc:Loc App.Title}" FontSize="18" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <controls:HelpLink Margin="8,0,0,0" VerticalAlignment="Center"
                                               HelpText="{loc:Loc Settings.About.HelpText}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding AboutVersion, RelativeSource={RelativeSource AncestorType=Window}}"
                                   FontSize="14" Margin="0,0,0,4"/>
                        <TextBlock Text="{loc:Loc Settings.About.Author}" FontSize="14"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                        <TextBlock Text="{loc:Loc Settings.About.Infostart}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock Margin="0,0,0,12" Cursor="Hand" TextDecorations="Underline"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Text="https://infostart.ru/1c/tools/2764888/"
                                   MouseLeftButtonUp="OnAboutLink_Click"
                                   Tag="https://infostart.ru/1c/tools/2764888/"/>
                        <TextBlock Text="{loc:Loc Settings.About.GitHub}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock Cursor="Hand" TextDecorations="Underline"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Text="https://github.com/sivatorov/ConfigurationManagement"
                                   MouseLeftButtonUp="OnAboutLink_Click"
                                   Tag="https://github.com/sivatorov/ConfigurationManagement"/>
                        <Image Source="pack://application:,,,/donat.png" Margin="0,16,0,0"
                               HorizontalAlignment="Left" Stretch="Uniform"
                               MaxWidth="420" MaxHeight="560" RenderOptions.BitmapScalingMode="HighQuality"
                               Cursor="Hand" MouseLeftButtonUp="OnDonatImage_Click"
                               ToolTip="{loc:Loc Settings.About.DonatTooltip}"/>
                        <StackPanel Margin="0,24,0,0" Orientation="Horizontal">
                            <Button Margin="0,0,10,0" Padding="14,8" HorizontalAlignment="Left"
                                    Style="{DynamicResource SecondaryButton}" Cursor="Hand"
                                    Click="OnCheckForUpdates_Click">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Update" Width="16" Height="16"
                                                             Foreground="#3B82F6" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Loc Settings.About.CheckForUpdates}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Padding="14,8" HorizontalAlignment="Left"
                                    Style="{DynamicResource SecondaryButton}" Cursor="Hand"
                                    Click="OnCopyTechInfo_Click">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ContentCopy" Width="16" Height="16"
                                                             Foreground="#3B82F6" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Loc Settings.About.CopyTechInfo}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- ============ Кнопки ============ -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Width="140" Height="36" Margin="0,0,10,0" IsDefault="True" Click="OnSave_Click"
                    Background="#16A34A" BorderThickness="0" Cursor="Hand" Foreground="White">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#15803D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#166534"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ContentSave" Width="16" Height="16" Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc Common.Save}" VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
            <Button Width="140" Height="36" IsCancel="True" Click="OnCancel_Click"
                    Background="Transparent" Cursor="Hand" BorderThickness="1.5"
                    BorderBrush="#EF4444" Foreground="#EF4444">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="12,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FEF2F2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Foreground="#EF4444" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc Common.Cancel}" VerticalAlignment="Center" Foreground="#EF4444" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
