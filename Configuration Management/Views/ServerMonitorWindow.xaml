<Window x:Class="Configuration_Management.ServerMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Configuration_Management.Localization"
        Icon="{StaticResource AppIcon}"
        Height="680" Width="1280" MinHeight="480" MinWidth="980"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- Вертикальное выравнивание содержимого ячеек по центру (как в ProcessInspectorWindow). -->
        <Style x:Key="CenteredCellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>

        <Style x:Key="CellTextAccent" TargetType="TextBlock" BasedOn="{StaticResource CenteredCellText}">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Заголовки колонок: текст по вертикали по центру (issue #324; глобальный шаблон
             темы центрирует ContentPresenter, здесь фиксируем явно для окна монитора). -->
        <Style x:Key="CenteredColumnHeader" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Панель подключения: адрес, порт, логин, пароль, кнопки. -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="{loc:Loc ServerMonitor.Address}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox Width="140" Style="{StaticResource ModernTextBox}" Padding="6,3"
                     ToolTip="{loc:Loc ServerMonitor.SavedConnectionTooltip}"
                     Text="{Binding ServerAddress, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="{loc:Loc ServerMonitor.Port}" VerticalAlignment="Center" Margin="10,0,6,0"/>
            <!-- Подсказка про порт (issue #324): rac подключается к АГЕНТУ сервера (1540),
                 порт кластера (1541) указывать не нужно — он виден в списке кластеров. -->
            <TextBox Width="60" Style="{StaticResource ModernTextBox}" Padding="6,3"
                     ToolTip="{loc:Loc ServerMonitor.PortTooltip}"
                     Text="{Binding ServerPort, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="{loc:Loc ServerMonitor.User}" VerticalAlignment="Center" Margin="10,0,6,0"/>
            <TextBox Width="120" Style="{StaticResource ModernTextBox}" Padding="6,3"
                     Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="{loc:Loc ServerMonitor.Password}" VerticalAlignment="Center" Margin="10,0,6,0"/>
            <PasswordBox x:Name="PasswordBox" Width="120" Padding="6,3"/>

            <Button x:Name="ConnectButton" Style="{StaticResource ModernButton}"
                    Background="{DynamicResource ItemHoverBrush}" Padding="12,5" Margin="14,0,8,0"
                    Click="OnConnect_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔌" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc ServerMonitor.Connect}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="RefreshButton" Style="{StaticResource ModernButton}"
                    Background="{DynamicResource ItemHoverBrush}" Padding="12,5" Margin="0,0,8,0"
                    Click="OnRefresh_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⟳" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc ServerMonitor.Refresh}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <!-- Диагностика сети до сервера 1С (функция 12): DNS/ICMP/TCP-проверка адреса:порт
                 монитора и стандартных портов 1540/1541/1545. Работает до подключения rac. -->
            <Button x:Name="DiagnosticsButton" Style="{StaticResource ModernButton}"
                    Background="{DynamicResource ItemHoverBrush}" Padding="12,5" Margin="0,0,8,0"
                    Click="OnDiagnostics_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🛜" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc ServerMonitor.NetworkDiagnostics}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="CloseButton" Style="{StaticResource ModernButton}" IsCancel="True"
                    Background="{DynamicResource ItemHoverBrush}" Padding="12,5"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    Click="OnClose_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✖" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc Common.Close}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Выбор кластера -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="{loc:Loc ServerMonitor.Cluster}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <!-- issue #324: явный ItemTemplate вместо DisplayMemberPath — с шаблоном
                 ModernComboBox закрытый ComboBox в ряде случаев показывал ToString()
                 выбранного элемента («Configuration_Management…» вместо имени кластера). -->
            <ComboBox x:Name="ClusterCombo" Width="360" Style="{StaticResource ModernComboBox}"
                      ItemsSource="{Binding ClusterRows}"
                      SelectedValuePath="Id" SelectedValue="{Binding SelectedClusterId}"
                      VerticalContentAlignment="Center" Padding="6,2">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayText}" VerticalAlignment="Center"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <!-- Автообновление (issue #324): перенесено из панели кнопок строки 0,
                 чтобы строка подключения не выходила за ширину окна. -->
            <CheckBox x:Name="AutoRefreshCheckBox" Content="{loc:Loc ServerMonitor.AutoRefreshToggle}"
                      IsChecked="{Binding IsAutoRefreshEnabled, Mode=TwoWay}"
                      VerticalAlignment="Center" Margin="14,0,8,0"/>
            <TextBlock Text="{loc:Loc ServerMonitor.AutoRefreshInterval}" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <ComboBox x:Name="AutoRefreshIntervalCombo" Width="64" Style="{StaticResource ModernComboBox}"
                      SelectedValuePath="Tag" SelectedValue="{Binding AutoRefreshIntervalSeconds, Mode=TwoWay}"
                      VerticalContentAlignment="Center" Padding="6,2">
                <ComboBoxItem Content="5" Tag="5"/>
                <ComboBoxItem Content="10" Tag="10"/>
                <ComboBoxItem Content="15" Tag="15"/>
                <ComboBoxItem Content="30" Tag="30"/>
                <ComboBoxItem Content="60" Tag="60"/>
            </ComboBox>
            <TextBlock x:Name="StatusSummary" VerticalAlignment="Center" Margin="14,0,0,0"
                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="{Binding StatusText}"/>
        </StackPanel>

        <!-- Вкладки данных кластера -->
        <TabControl Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <!-- Рабочие процессы -->
            <TabItem Header="{loc:Loc ServerMonitor.Tabs.Processes}">
                <DataGrid x:Name="ProcessesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False"
                          ColumnHeaderStyle="{StaticResource CenteredColumnHeader}"
                          SelectionMode="Single" SelectionUnit="FullRow" GridLinesVisibility="Horizontal"
                          RowHeight="34" AlternatingRowBackground="{DynamicResource CardBackgroundBrush}"
                          BorderThickness="0">
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="90" Header="{loc:Loc ServerMonitor.Columns.Process.Type}"
                                            Binding="{Binding Type}" ElementStyle="{StaticResource CenteredCellText}"/>
                        <DataGridTextColumn Width="1.2*" Header="{loc:Loc ServerMonitor.Columns.Process.Host}"
                                            Binding="{Binding Host}" ElementStyle="{StaticResource CenteredCellText}"/>
                        <DataGridTextColumn Width="70" Header="PID"
                                            Binding="{Binding Pid}" ElementStyle="{StaticResource CellTextAccent}"/>
                        <DataGridTextColumn Width="60" Header="{loc:Loc ServerMonitor.Columns.Process.Port}"
                                            Binding="{Binding Port}" ElementStyle="{StaticResource CenteredCellText}"/>
                        <DataGridTextColumn Width="130" Header="{loc:Loc ServerMonitor.Columns.Process.StartedAt}"
                                            Binding="{Binding StartedAtText}" ElementStyle="{StaticResource CenteredCellText}"/>
                        <DataGridTextColumn Width="90" Header="{loc:Loc ServerMonitor.Columns.Process.Memory}"
                                            Binding="{Binding MemorySizeText}" ElementStyle="{StaticResource CenteredCellText}"/>
                        <DataGridTextColumn Width="80" Header="{loc:Loc ServerMonitor.Columns.Process.Threads}"
                                            Binding="{Binding Threads}" ElementStyle="{StaticResource CenteredCellText}"/>
                        <DataGridTextColumn Width="80" Header="{loc:Loc ServerMonitor.Columns.Process.Cpu}"
                                            Binding="{Binding CpuText}" ElementStyle="{StaticResource CenteredCellText}"/>
                        <DataGridTextColumn Width="80" Header="{loc:Loc ServerMonitor.Columns.Process.Running}"
                                            Binding="{Binding RunningText}" ElementStyle="{StaticResource CenteredCellText}"/>
                        <DataGridTextColumn Width="60" Header="{loc:Loc ServerMonitor.Columns.Process.Infobases}"
                                            Binding="{Binding Infobases}" ElementStyle="{StaticResource CenteredCellText}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Сеансы -->
            <TabItem Header="{loc:Loc ServerMonitor.Tabs.Sessions}">
                <DockPanel>
                    <!-- Действие: завершить выбранный сеанс (подтверждение — в VM). -->
                    <Button DockPanel.Dock="Bottom" Style="{StaticResource ModernButton}"
                            Background="{DynamicResource ItemHoverBrush}" Padding="12,5"
                            Margin="0,8,0,0" HorizontalAlignment="Left"
                            Click="OnTerminateSession_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✕" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc ServerMonitor.TerminateSession}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <DataGrid x:Name="SessionsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectedItem="{Binding SelectedSession}"
                              HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False"
                              ColumnHeaderStyle="{StaticResource CenteredColumnHeader}"
                          SelectionMode="Single" SelectionUnit="FullRow" GridLinesVisibility="Horizontal"
                          RowHeight="34" AlternatingRowBackground="{DynamicResource CardBackgroundBrush}"
                          BorderThickness="0">
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="1.2*" Header="{loc:Loc ServerMonitor.Columns.Session.User}"
                                            Binding="{Binding User}" ElementStyle="{StaticResource CellTextAccent}"/>
                        <!-- issue #324, C2: колонка «Информационная база» (имя из
                             «infobase summary list» по infobase-id сеанса). -->
                        <DataGridTextColumn Width="1.1*" Header="{loc:Loc ServerMonitor.Columns.Session.Infobase}"
                                            Binding="{Binding InfobaseName}" ElementStyle="{StaticResource CenteredCellText}"/>
                        <DataGridTextColumn Width="1.1*" Header="{loc:Loc ServerMonitor.Columns.Session.Host}"
                                            Binding="{Binding Host}" ElementStyle="{StaticResource CenteredCellText}"/>
                        <DataGridTextColumn Width="90" Header="{loc:Loc ServerMonitor.Columns.Session.App}"
                                            Binding="{Binding AppId}" ElementStyle="{StaticResource CenteredCellText}"/>
                        <DataGridTextColumn Width="130" Header="{loc:Loc ServerMonitor.Columns.Session.StartedAt}"
                                            Binding="{Binding StartedAtText}" ElementStyle="{StaticResource CenteredCellText}"/>
                        <DataGridTextColumn Width="130" Header="{loc:Loc ServerMonitor.Columns.Session.LastActive}"
                                            Binding="{Binding LastActiveAtText}" ElementStyle="{StaticResource CenteredCellText}"/>
                        <DataGridTextColumn Width="100" Header="{loc:Loc ServerMonitor.Columns.Session.State}"
                                            Binding="{Binding StateText}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CenteredCellText}">
                                    <Setter Property="Foreground" Value="#64748B"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="active">
                                            <Setter Property="Foreground" Value="#16A34A"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="dead">
                                            <Setter Property="Foreground" Value="#DC2626"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="sleep">
                                            <Setter Property="Foreground" Value="#D97706"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="call">
                                            <Setter Property="Foreground" Value="#D97706"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="wait">
                                            <Setter Property="Foreground" Value="#D97706"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Width="80" Header="{loc:Loc ServerMonitor.Columns.Session.Blocked}"
                                            Binding="{Binding BlockedSymbol}" ElementStyle="{StaticResource CenteredCellText}"
                                            CanUserSort="False"/>
                        <DataGridTextColumn Width="90" Header="{loc:Loc ServerMonitor.Columns.Session.Memory}"
                                            Binding="{Binding MemoryText}" ElementStyle="{StaticResource CenteredCellText}"/>
                        <DataGridTextColumn Width="90" Header="{loc:Loc ServerMonitor.Columns.Session.Duration}"
                                            Binding="{Binding DurationAllText}" ElementStyle="{StaticResource CenteredCellText}"/>
                        <DataGridTextColumn Width="90" Header="{loc:Loc ServerMonitor.Columns.Session.DurationCurrent}"
                                            Binding="{Binding DurationCurrentText}" ElementStyle="{StaticResource CenteredCellText}"/>
                        <DataGridTextColumn Width="80" Header="{loc:Loc ServerMonitor.Columns.Session.Hibernate}"
                                            Binding="{Binding HibernateText}" ElementStyle="{StaticResource CenteredCellText}"/>
                    </DataGrid.Columns>
                </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Соединения -->
            <TabItem Header="{loc:Loc ServerMonitor.Tabs.Connections}">
                <DockPanel>
                    <!-- Действие: разорвать выбранное соединение (подтверждение — в VM). -->
                    <Button DockPanel.Dock="Bottom" Style="{StaticResource ModernButton}"
                            Background="{DynamicResource ItemHoverBrush}" Padding="12,5"
                            Margin="0,8,0,0" HorizontalAlignment="Left"
                            Click="OnDisconnectConnection_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⛓" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc ServerMonitor.DisconnectConnection}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <DataGrid x:Name="ConnectionsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectedItem="{Binding SelectedConnection}"
                              HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False"
                              ColumnHeaderStyle="{StaticResource CenteredColumnHeader}"
                          SelectionMode="Single" SelectionUnit="FullRow" GridLinesVisibility="Horizontal"
                          RowHeight="34" AlternatingRowBackground="{DynamicResource CardBackgroundBrush}"
                          BorderThickness="0">
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="1.2*" Header="{loc:Loc ServerMonitor.Columns.Connection.Host}"
                                            Binding="{Binding Host}" ElementStyle="{StaticResource CenteredCellText}"/>
                        <DataGridTextColumn Width="70" Header="{loc:Loc ServerMonitor.Columns.Connection.Port}"
                                            Binding="{Binding Port}" ElementStyle="{StaticResource CenteredCellText}"/>
                        <DataGridTextColumn Width="100" Header="{loc:Loc ServerMonitor.Columns.Connection.Connector}"
                                            Binding="{Binding Connector}" ElementStyle="{StaticResource CenteredCellText}"/>
                        <DataGridTextColumn Width="130" Header="{loc:Loc ServerMonitor.Columns.Connection.Established}"
                                            Binding="{Binding EstablishedAtText}" ElementStyle="{StaticResource CenteredCellText}"/>
                        <DataGridTextColumn Width="130" Header="{loc:Loc ServerMonitor.Columns.Connection.LastActive}"
                                            Binding="{Binding LastConnectionTimeText}" ElementStyle="{StaticResource CenteredCellText}"/>
                        <DataGridTextColumn Width="100" Header="{loc:Loc ServerMonitor.Columns.Connection.Duration}"
                                            Binding="{Binding DurationText}" ElementStyle="{StaticResource CenteredCellText}"/>
                        <DataGridTextColumn Width="1.3*" Header="{loc:Loc ServerMonitor.Columns.Connection.Descr}"
                                            Binding="{Binding Descr}" ElementStyle="{StaticResource CenteredCellText}"/>
                        <DataGridTextColumn Width="110" Header="{loc:Loc ServerMonitor.Columns.Connection.Blocked}"
                                            Binding="{Binding BlockedText}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CenteredCellText}">
                                    <Setter Property="Foreground" Value="#64748B"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Blocked}" Value="True">
                                            <Setter Property="Foreground" Value="#D97706"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Блокировки -->
            <TabItem Header="{loc:Loc ServerMonitor.Tabs.Locks}">
                <DataGrid x:Name="LocksGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False"
                          ColumnHeaderStyle="{StaticResource CenteredColumnHeader}"
                          SelectionMode="Single" SelectionUnit="FullRow" GridLinesVisibility="Horizontal"
                          RowHeight="34" AlternatingRowBackground="{DynamicResource CardBackgroundBrush}"
                          BorderThickness="0">
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="2*" Header="{loc:Loc ServerMonitor.Columns.Lock.Object}"
                                            Binding="{Binding Object}" ElementStyle="{StaticResource CellTextAccent}"/>
                        <DataGridTextColumn Width="90" Header="{loc:Loc ServerMonitor.Columns.Lock.Waiting}"
                                            Binding="{Binding WaitingSymbol}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CenteredCellText}">
                                    <Setter Property="Foreground" Value="#D97706"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Width="90" Header="{loc:Loc ServerMonitor.Columns.Lock.Blocking}"
                                            Binding="{Binding BlockingSymbol}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CenteredCellText}">
                                    <Setter Property="Foreground" Value="#DC2626"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Width="1.1*" Header="{loc:Loc ServerMonitor.Columns.Lock.Session}"
                                            Binding="{Binding SessionId}" ElementStyle="{StaticResource CenteredCellText}"/>
                        <DataGridTextColumn Width="1.1*" Header="{loc:Loc ServerMonitor.Columns.Lock.Connection}"
                                            Binding="{Binding ConnectionId}" ElementStyle="{StaticResource CenteredCellText}"/>
                        <DataGridTextColumn Width="1.1*" Header="{loc:Loc ServerMonitor.Columns.Lock.Transaction}"
                                            Binding="{Binding TransactionId}" ElementStyle="{StaticResource CenteredCellText}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Регламентные задания -->
            <TabItem Header="{loc:Loc ServerMonitor.Tabs.Jobs}">
                <DockPanel>
                    <!-- Панель фильтра по базе и действий (подтверждение — в VM). -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{loc:Loc ServerMonitor.Columns.Job.Infobase}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <!-- issue #324: явный ItemTemplate вместо DisplayMemberPath
                             (см. комментарий к ClusterCombo выше). -->
                        <ComboBox x:Name="JobFilterCombo" Width="240" Style="{StaticResource ModernComboBox}"
                                  ItemsSource="{Binding JobInfobaseFilterRows}"
                                  SelectedValuePath="Id" SelectedValue="{Binding SelectedJobInfobaseId}"
                                  VerticalContentAlignment="Center" Padding="6,2">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayText}" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button x:Name="PauseJobButton" Style="{StaticResource ModernButton}"
                                Background="{DynamicResource ItemHoverBrush}" Padding="12,5"
                                Margin="12,0,8,0" IsEnabled="{Binding CanPauseSelectedJob}"
                                Click="OnPauseJob_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⏸" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc ServerMonitor.PauseJob}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ResumeJobButton" Style="{StaticResource ModernButton}"
                                Background="{DynamicResource ItemHoverBrush}" Padding="12,5"
                                Margin="0,0,8,0" IsEnabled="{Binding CanResumeSelectedJob}"
                                Click="OnResumeJob_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▶" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc ServerMonitor.ResumeJob}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="JobDetailsButton" Style="{StaticResource ModernButton}"
                                Background="{DynamicResource ItemHoverBrush}" Padding="12,5"
                                Click="OnJobDetails_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ℹ" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc ServerMonitor.JobDetails}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Подсказка при пустом списке (нет заданий / нет прав администратора). -->
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{loc:Loc ServerMonitor.Empty.Jobs}" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasJobs}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <DataGrid x:Name="JobsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectedItem="{Binding SelectedJob}"
                              HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False"
                              ColumnHeaderStyle="{StaticResource CenteredColumnHeader}"
                              SelectionMode="Single" SelectionUnit="FullRow" GridLinesVisibility="Horizontal"
                              RowHeight="34" AlternatingRowBackground="{DynamicResource CardBackgroundBrush}"
                              BorderThickness="0">
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="1.4*" Header="{loc:Loc ServerMonitor.Columns.Job.Name}"
                                                Binding="{Binding Name}" ElementStyle="{StaticResource CellTextAccent}"/>
                            <DataGridTextColumn Width="1.1*" Header="{loc:Loc ServerMonitor.Columns.Job.Infobase}"
                                                Binding="{Binding InfobaseName}" ElementStyle="{StaticResource CenteredCellText}"/>
                            <DataGridTextColumn Width="1.1*" Header="{loc:Loc ServerMonitor.Columns.Job.Method}"
                                                Binding="{Binding MethodName}" ElementStyle="{StaticResource CenteredCellText}"/>
                            <DataGridTextColumn Width="1.1*" Header="{loc:Loc ServerMonitor.Columns.Job.Schedule}"
                                                Binding="{Binding Schedule}" ElementStyle="{StaticResource CenteredCellText}"/>
                            <DataGridTextColumn Width="110" Header="{loc:Loc ServerMonitor.Columns.Job.State}"
                                                Binding="{Binding StateText}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CenteredCellText}">
                                        <Setter Property="Foreground" Value="#64748B"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State}" Value="running">
                                                <Setter Property="Foreground" Value="#16A34A"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="scheduled">
                                                <Setter Property="Foreground" Value="#2563EB"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="paused">
                                                <Setter Property="Foreground" Value="#D97706"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Width="130" Header="{loc:Loc ServerMonitor.Columns.Job.NextStart}"
                                                Binding="{Binding NextStartText}" ElementStyle="{StaticResource CenteredCellText}"/>
                            <DataGridTextColumn Width="130" Header="{loc:Loc ServerMonitor.Columns.Job.LastStart}"
                                                Binding="{Binding LastStartText}" ElementStyle="{StaticResource CenteredCellText}"/>
                            <DataGridTextColumn Width="80" Header="{loc:Loc ServerMonitor.Columns.Job.LastSuccess}"
                                                Binding="{Binding LastSuccessText}" ElementStyle="{StaticResource CenteredCellText}"/>
                            <DataGridTextColumn Width="1.2*" Header="{loc:Loc ServerMonitor.Columns.Job.Result}"
                                                Binding="{Binding ResultText}" ElementStyle="{StaticResource CenteredCellText}"/>
                            <DataGridTextColumn Width="90" Header="{loc:Loc ServerMonitor.Columns.Job.Predefined}"
                                                Binding="{Binding PredefinedText}" ElementStyle="{StaticResource CenteredCellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Информация о кластере (issue #324, C3): свойства в виде «свойство — значение»,
                 правится безопасный набор параметров (имя, таймауты/лимиты, уровень
                 безопасности, пинг, аутентификация); порт кластера rac не меняет. -->
            <TabItem Header="{loc:Loc ServerMonitor.Tabs.Info}">
                <DockPanel>
                    <Button DockPanel.Dock="Top" Style="{StaticResource ModernButton}"
                            Background="{DynamicResource ItemHoverBrush}" Padding="12,5"
                            Margin="0,0,0,8" HorizontalAlignment="Left"
                            Click="OnSaveClusterInfo_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc ServerMonitor.Cluster.Save}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                        <ItemsControl ItemsSource="{Binding ClusterProperties}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="340" SharedSizeGroup="Property"/>
                                            <ColumnDefinition Width="340" SharedSizeGroup="Value"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                                   VerticalAlignment="Center" Margin="0,0,12,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding RawKey}"/>
                                        <!-- Правка — только для безопасного набора параметров. -->
                                        <TextBox Grid.Column="1" Padding="4,2"
                                                 Text="{Binding EditValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 VerticalContentAlignment="Center">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEditable}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="4,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEditable}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <TextBlock.Text>
                                                <Binding Path="OriginalValue"/>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
        </TabControl>

        <!-- Строка состояния и ошибки (пустой ErrorMessage ничего не показывает) -->
        <TextBlock Grid.Row="3" Margin="0,10,0,0" FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding StatusText}"/>
        <TextBlock Grid.Row="4" Margin="0,4,0,0" FontSize="12"
                   Foreground="#DC2626" Text="{Binding ErrorMessage}"
                   TextWrapping="Wrap"/>
        <!-- Подсказка про автообновление (по образцу ProcessInspectorWindow.Hint). -->
        <TextBlock Grid.Row="5" Margin="0,8,0,0" FontSize="11"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="{Binding AutoRefreshText}"/>
    </Grid>
</Window>