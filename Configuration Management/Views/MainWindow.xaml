<Window x:Class="Configuration_Management.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Configuration_Management"
        xmlns:vm="clr-namespace:Configuration_Management.ViewModels"
        xmlns:converters="clr-namespace:Configuration_Management.Converters"
        xmlns:models="clr-namespace:Configuration_Management.Models"
        xmlns:conv="clr-namespace:Configuration_Management.Converters"
        xmlns:controls="clr-namespace:Configuration_Management.Controls"
        xmlns:loc="clr-namespace:Configuration_Management.Localization"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="{loc:Loc App.Title}"
        Icon="pack://application:,,,/app.ico"
        Height="760" Width="1200"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Loaded="OnWindowLoaded"
        SourceInitialized="OnWindowSourceInitialized"
        PreviewKeyDown="Window_PreviewKeyDown"
        FontFamily="Segoe UI"
        FontSize="13"
        Background="{DynamicResource ContentBackgroundBrush}"
        ResizeMode="CanResize"
        StateChanged="OnWindowStateChanged">

    <!-- Собственный каркас окна без системных кнопок: WindowChrome заменяет системную
         рамку и скрывает системные кнопки (UseAeroCaptionButtons=false), оставляя
         невидимую рамку ресайза за края окна (ResizeBorderThickness). Перетаскивание
         за верхнюю панель реализовано вручную (OnTopBar_MouseLeftButtonDown -> DragMove).
         GlassFrameThickness=-1 расширяет системную «стеклянную» рамку DWM на всю клиентскую
         область, чтобы полупрозрачная подложка окна пропускала acrylic/размытие (подробнее
         в OnWindowSourceInitialized и ApplySystemBackdrop). -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="-1"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <!-- Горячие клавиши F3/F4 (и настраиваемые) регистрируются в code-behind RegisterLaunchHotkeys -->
    <Window.InputBindings>
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:DoubleToGridLengthConverter x:Key="DoubleToGridLength"/>
        <conv:GroupColorConverter x:Key="GroupColorConverter"/>
        <conv:GroupTextColorConverter x:Key="GroupTextColorConverter"/>
        <conv:BooleanToGridLengthConverter x:Key="BoolToGridLen"/>
        <conv:ColumnVisibilityConverter x:Key="ColumnVis"/>
        <conv:NameColumnWidthConverter x:Key="NameColumnWidth"/>
        <conv:IconKeyToGeometryConverter x:Key="IconKeyToGeometryConverter"/>
        <conv:LevelToThicknessConverter x:Key="LevelToThickness"/>
        <conv:GroupOffsetConverter x:Key="GroupOffset"/>
        <conv:MultiFormatConverter x:Key="MultiFormat"/>

        <!-- Собственные кнопки управления окном вынесены в общие ресурсы приложения
             (App.xaml): WindowControlButton / WindowControlCloseButton. Здесь они
             переиспользуются через StaticResource. -->
        <!-- ScrollViewer списка баз: корректные PART_* и привязки полос прокрутки.
             Виртуализация TreeView отключена — иначе высота контента = viewport и ScrollableHeight=0. -->
        <Style x:Key="CardScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="CanContentScroll" Value="False"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="PanningMode" Value="Both"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                    Grid.Row="0" Grid.Column="0"
                                                    Margin="{TemplateBinding Padding}"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                    ContentStringFormat="{TemplateBinding ContentStringFormat}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Row="0" Grid.Column="1"
                                       Orientation="Vertical"
                                       Cursor="Arrow"
                                       Minimum="0"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                            <ScrollBar x:Name="PART_HorizontalScrollBar"
                                       Grid.Row="1" Grid.Column="0"
                                       Orientation="Horizontal"
                                       Cursor="Arrow"
                                       Minimum="0"
                                       Maximum="{TemplateBinding ScrollableWidth}"
                                       ViewportSize="{TemplateBinding ViewportWidth}"
                                       Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
                            <Border Grid.Row="1" Grid.Column="1"
                                    Background="{DynamicResource CardBackgroundBrush}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Неявный стиль ScrollViewer для списка баз (внутренний ScrollViewer TreeView):
             устраняет «светлый квадрат» в правом нижнем углу (ячейка на стыке
             горизонтальной и вертикальной полос прокрутки), закрашивая её цветом
             карточки, чтобы угол не показывался системным цветом. CanContentScroll
             привязан к шаблону, чтобы не ломать виртуализацию дерева. -->
        <Style TargetType="ScrollViewer">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                    Grid.Row="0" Grid.Column="0"
                                                    Margin="{TemplateBinding Padding}"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                    ContentStringFormat="{TemplateBinding ContentStringFormat}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Row="0" Grid.Column="1"
                                       Orientation="Vertical"
                                       Cursor="Arrow"
                                       Minimum="0"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                            <ScrollBar x:Name="PART_HorizontalScrollBar"
                                       Grid.Row="1" Grid.Column="0"
                                       Orientation="Horizontal"
                                       Cursor="Arrow"
                                       Minimum="0"
                                       Maximum="{TemplateBinding ScrollableWidth}"
                                       ViewportSize="{TemplateBinding ViewportWidth}"
                                       Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
                            <!-- Закрашиваем угол в цвет карточки, чтобы не было «светлого квадрата». -->
                            <Border Grid.Row="1" Grid.Column="1"
                                    Background="{DynamicResource CardBackgroundBrush}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===================== Заголовок-титул приложения ===================== -->
        <!-- Отдельная верхняя строка окна: слева иконка и заголовок программы, справа —
             кнопки управления окном (свернуть/развернуть/закрыть), встроенные в полосу.
             Перетаскивание окна за эту полосу — OnTopBar_MouseLeftButtonDown -> DragMove. -->
        <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="0,0,0,1"
                Padding="12,6" MouseLeftButtonDown="OnTopBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Иконка и заголовок программы -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Width="18" Height="18" Margin="0,0,8,0">
                        <Image.Source>
                            <BitmapImage UriSource="pack://application:,,,/app.ico" DecodePixelWidth="18"/>
                        </Image.Source>
                    </Image>
                    <TextBlock x:Name="AppTitleBlock" Text="{loc:Loc App.Title}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Кнопки управления окном: свернуть / развернуть / закрыть -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="MinimizeButton" Click="OnMinimizeButton_Click"
                            Style="{DynamicResource WindowControlButton}"
                            ToolTip="{loc:Loc Window.Minimize}">
                        <Path Width="11" Height="11" Stretch="Uniform"
                              Data="M0,5.5 L11,5.5 L11,6.5 L0,6.5 Z"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button x:Name="MaximizeButton" Click="OnMaximizeButton_Click"
                            Style="{DynamicResource WindowControlButton}"
                            ToolTip="{loc:Loc Window.Maximize}">
                        <Grid Width="13" Height="13">
                            <Path x:Name="MaximizeGlyphPath" Stretch="Uniform"
                                  StrokeThickness="1.2" Fill="Transparent"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M1,1 H12 V12 H1 Z"/>
                            <Path x:Name="RestoreGlyphPath" Stretch="Uniform"
                                  Visibility="Collapsed"
                                  StrokeThickness="1.2" Fill="Transparent"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M3,1 H9 V7 H3 Z M1,3 H7 V9 H1 Z"/>
                        </Grid>
                    </Button>
                    <Button x:Name="CloseButton" Click="OnCloseButton_Click"
                            Style="{DynamicResource WindowControlCloseButton}"
                            ToolTip="{loc:Loc Common.Close}">
                        <Path Width="13" Height="13" Stretch="Uniform"
                              Data="M1,1 L12,12 M12,1 L1,12"
                              StrokeThickness="1.2"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== Основная область ===================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ============ Левая панель: список информационных баз ============ -->
            <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="0,0,1,0">
                <Grid Margin="12,12,8,12" Grid.IsSharedSizeScope="True">
                    <Grid.RowDefinitions>
                        <!-- 0: панель команд (перенесена из верхней строки окна), 1: теги,
                             2: панель команд списка (кнопки-команды над заголовками колонок),
                             3: список (*) — обязателен *, иначе TreeView меряется по полной высоте
                             контента, ScrollableHeight=0 и полосы/колесо не появляются
                             (в т.ч. при сжатии окна). -->
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Верхняя панель команд: перенесена из верхней строки окна внутрь левой колонки,
                         над заголовком таблицы списка. Занимает всю ширину левой колонки и не
                         накладывается на правую панель RightPanelBorder. -->
                    <Border x:Name="TopBarBorder" Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="0,0,0,1" Padding="0,8"
                            MouseLeftButtonDown="OnTopBar_MouseLeftButtonDown">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*" MinWidth="120"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Группы / теги — слева от поиска -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                <!-- Показывать группы: только иконка, акцент когда включено -->
                                <ToggleButton IsChecked="{Binding GroupByGroup}"
                                              Click="OnGroupByToggle_Click"
                                              Style="{DynamicResource ToolbarToggleButton}"
                                              Margin="0,0,2,0"
                                              ToolTip="{loc:Loc Main.ToggleGroups}">
                                    <Path Width="18" Height="18" Stretch="Uniform"
                                          Data="{StaticResource IconFolder}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                </ToggleButton>
                                <ToggleButton IsChecked="{Binding ShowEmptyGroups}"
                                              Style="{DynamicResource ToolbarToggleButton}"
                                              Margin="0,0,2,0"
                                              ToolTip="{loc:Loc Settings.Panels.ShowEmptyGroups}"
                                              Visibility="{Binding GroupByGroup, Converter={StaticResource BoolToVis}}">
                                    <materialDesign:PackIcon Kind="FolderOutline" Width="18" Height="18"
                                                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                </ToggleButton>
                                <!-- Показывать теги: включает теги и вверху (панель отбора), и в списке -->
                                <ToggleButton IsChecked="{Binding ShowTagFilterPanel, Mode=TwoWay}"
                                              Click="OnTopTagsToggle_Click"
                                              Style="{DynamicResource ToolbarToggleButton}"
                                              Margin="0,0,2,0"
                                              ToolTip="{loc:Loc Main.ToggleTagsFull}">
                                    <Path Width="18" Height="18" Stretch="Uniform"
                                          Data="{StaticResource IconTag}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                </ToggleButton>
                            </StackPanel>

                            <!-- Поиск (без тегов) -->
                            <Border Grid.Column="1" Margin="0,0,8,0"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1"
                                    CornerRadius="10" Padding="8,4" VerticalAlignment="Center">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🔍" FontSize="13" Margin="2,0,6,0"
                                               VerticalAlignment="Center" Opacity="0.7" IsHitTestVisible="False"/>
                                    <TextBox x:Name="SearchTextBox" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                             Padding="2,6" FontSize="13" VerticalContentAlignment="Center"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             CaretBrush="{DynamicResource TextPrimaryBrush}"
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{loc:Loc Main.SearchPlaceholder}"/>
                                    <Button Grid.Column="2" Command="{Binding ClearSearchCommand}"
                                            Background="Transparent" BorderThickness="0" Padding="6,0" Cursor="Hand"
                                            ToolTip="{loc:Loc Main.ClearSearch}" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="Close" Width="12" Height="12"
                                                                 Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Вкладки Все / Избранное / Недавние + действия -->
                            <Border Grid.Column="2" Background="{DynamicResource ContentBackgroundBrush}"
                                    CornerRadius="12" Padding="4" Margin="0,0,8,0" VerticalAlignment="Center"
                                    BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1">
                                <StackPanel x:Name="TabsPanel" Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton GroupName="ListMode"
                                                 IsChecked="{Binding IsListModeAll, Mode=TwoWay}"
                                                 Style="{DynamicResource SegmentRadioButton}" Margin="0,0,4,0"
                                                 ToolTip="{loc:Loc Main.AllBasesTooltip}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="14" Height="14" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"
                                                  Data="{StaticResource IconDatabase}"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                            <TextBlock Text="{loc:Loc Main.AllBases}" VerticalAlignment="Center"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton GroupName="ListMode"
                                                 IsChecked="{Binding IsListModeFavorites, Mode=TwoWay}"
                                                 Style="{DynamicResource SegmentRadioButton}" Margin="0,0,4,0"
                                                 ToolTip="{loc:Loc Main.FavoritesTooltip}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="14" Height="14" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"
                                                  Data="{StaticResource IconStar}"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                            <TextBlock Text="{loc:Loc Main.Favorites}" VerticalAlignment="Center"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton GroupName="ListMode"
                                                 IsChecked="{Binding IsListModeRecent, Mode=TwoWay}"
                                                 Style="{DynamicResource SegmentRadioButton}"
                                                 ToolTip="{loc:Loc Main.RecentTooltip}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="14" Height="14" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"
                                                  Data="{StaticResource IconHistory}"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                            <TextBlock Text="{loc:Loc Main.Recent}" VerticalAlignment="Center"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </Border>

                        </Grid>
                    </Border>

                    <!-- Панель быстрого отбора по тегам -->
                    <Border Grid.Row="1" Margin="4,0,4,8" Padding="8,6"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrushColor}"
                            BorderThickness="1" CornerRadius="8"
                            Visibility="{Binding ShowTagFilterPanel, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"
                                      VerticalAlignment="Center"
                                      Data="{StaticResource IconTag}"
                                      Fill="{DynamicResource TextSecondaryBrush}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc Main.TagFilterTitle}"
                                               FontWeight="SemiBold" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <controls:HelpLink Margin="6,0,0,0"
                                                       HelpText="{loc:Loc Main.TagFilterHelp}"/>
                                </StackPanel>
                                <Button Grid.Column="2" Command="{Binding ClearTagFiltersCommand}"
                                        Style="{DynamicResource HeaderIconButton}" Padding="4,2"
                                        ToolTip="{loc:Loc Main.ClearTagFilters}"
                                        Visibility="{Binding HasActiveTagFilter, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Close" Width="12" Height="12"
                                                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                                                 Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{loc:Loc Common.Clear}" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding TagFilterItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="0,0,6,4" Padding="7,2" Cursor="Hand"
                                                Command="{Binding DataContext.SearchByTagCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Name}">
                                            <Button.ToolTip>
                                                <MultiBinding Converter="{StaticResource MultiFormat}" ConverterParameter="{}{0}: {1}">
                                                    <Binding Source="{x:Static loc:LocalizationManager.Instance}" Path="Source"
                                                             Converter="{x:Static loc:LocalizationValueConverter.Instance}" ConverterParameter="Main.FilterByTagLabel"/>
                                                    <Binding Path="Name"/>
                                                </MultiBinding>
                                            </Button.ToolTip>
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                        CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"
                                                      Data="{StaticResource IconTag}"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                <TextBlock Text="{Binding Name}" FontSize="11" VerticalAlignment="Center"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Панель команд списка: контейнер кнопок-команд (звезда/пин, добавить/правка/
                         удалить и пр.), располагается непосредственно над заголовками колонок.
                         Сейчас пустой каркас — в него в последующие задачи переносятся команды.
                         Занимает всю ширину левой колонки. -->
                    <Border x:Name="CommandPanelBorder" Grid.Row="2" Margin="4,0,4,0" Padding="8,6"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrushColor}"
                            BorderThickness="0,0,0,1">
                        <StackPanel x:Name="CommandPanelStack" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Управление группами: развернуть/свернуть все, сортировка, отображение тегов.
                                 Видно при группировке списка (ShowExpandCollapseButtons). -->
                            <Button Command="{Binding ExpandAllGroupsCommand}"
                                    Style="{DynamicResource IconButton}" Margin="0,0,2,0"
                                    ToolTip="{loc:Loc Main.ExpandAllGroups}"
                                    Visibility="{Binding ShowExpandCollapseButtons, Converter={StaticResource BoolToVis}}">
                                <materialDesign:PackIcon Kind="ExpandAll" Width="18" Height="18"
                                                         Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Button>
                            <Button Command="{Binding CollapseAllGroupsCommand}"
                                    Style="{DynamicResource IconButton}" Margin="0,0,2,0"
                                    ToolTip="{loc:Loc Main.CollapseAllGroups}"
                                    Visibility="{Binding ShowExpandCollapseButtons, Converter={StaticResource BoolToVis}}">
                                <materialDesign:PackIcon Kind="CollapseAll" Width="18" Height="18"
                                                         Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Button>
                            <Button Command="{Binding SortGroupsAscendingCommand}"
                                    Style="{DynamicResource IconButton}" Margin="0,0,2,0"
                                    ToolTip="{loc:Loc Main.SortGroupsAscending}"
                                    Visibility="{Binding ShowExpandCollapseButtons, Converter={StaticResource BoolToVis}}">
                                <materialDesign:PackIcon Kind="SortAscending" Width="18" Height="18"
                                                         Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Button>
                            <Button Command="{Binding SortGroupsDescendingCommand}"
                                    Style="{DynamicResource IconButton}" Margin="0,0,2,0"
                                    ToolTip="{loc:Loc Main.SortGroupsDescending}"
                                    Visibility="{Binding ShowExpandCollapseButtons, Converter={StaticResource BoolToVis}}">
                                <materialDesign:PackIcon Kind="SortDescending" Width="18" Height="18"
                                                         Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Button>
                            <!-- Переключатель видимости тегов в списке -->
                            <ToggleButton IsChecked="{Binding ShowTags, Mode=TwoWay}"
                                          Style="{DynamicResource ToolbarToggleButton}"
                                          VerticalAlignment="Center" Margin="2,0,0,0"
                                          ToolTip="{loc:Loc Main.ToggleListTags}">
                                <Path Width="14" Height="14" Stretch="Uniform"
                                      Data="{StaticResource IconTag}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                            </ToggleButton>
                            <!-- Вертикальный разделитель: отделяет «Управление группами» от остальных команд -->
                            <Border Width="1" Margin="4,5" VerticalAlignment="Stretch"
                                    Background="{DynamicResource BorderBrushColor}" Opacity="0.55"/>
                            <!-- «Правка»: добавить / правка / удалить выбранной базы -->
                            <Button Command="{Binding AddInfobaseCommand}"
                                    Style="{DynamicResource IconButton}" Margin="0,0,2,0"
                                    ToolTip="{loc:Loc Main.AddBase}">
                                <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" Foreground="#22C55E"/>
                            </Button>
                            <Button Command="{Binding EditInfobaseCommand}"
                                    Style="{DynamicResource IconButton}" Margin="0,0,2,0"
                                    ToolTip="{loc:Loc Main.EditBaseTooltip}">
                                <materialDesign:PackIcon Kind="Pencil" Width="18" Height="18" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Button>
                            <Button Command="{Binding DeleteInfobaseCommand}"
                                    Style="{DynamicResource IconButton}" Margin="0,0,2,0"
                                    ToolTip="{loc:Loc Main.DeleteTooltip}">
                                <materialDesign:PackIcon Kind="Delete" Width="18" Height="18" Foreground="#DC2626"/>
                            </Button>
                            <!-- Вертикальный разделитель: отделяет группу «Правка» от «Управление списком» -->
                            <Border Width="1" Margin="4,5" VerticalAlignment="Stretch"
                                    Background="{DynamicResource BorderBrushColor}" Opacity="0.55"/>
                            <!-- «Управление списком»: очистить кеш, выгрузка, синхронизация, проверка -->
                            <Button Command="{Binding ClearCacheCommand}"
                                    Style="{DynamicResource IconButton}" Margin="0,0,2,0"
                                    ToolTip="{loc:Loc Main.ClearCacheTooltip}">
                                <materialDesign:PackIcon Kind="Broom" Width="18" Height="18" Foreground="#F59E0B"/>
                            </Button>
                            <!-- Индикатор выгрузки .dt/.cf: появляется при запуске пакетной операции,
                                 анимируется (стрелка вверх подпрыгивает) и скрывается по её завершении.
                                 При наведении показывает сводку о текущей выгрузке. -->
                            <Button x:Name="ExportIndicatorButton"
                                    Style="{DynamicResource IconButton}" Margin="0,0,2,0"
                                    Visibility="{Binding IsExporting, Converter={StaticResource BoolToVis}}"
                                    ToolTip="{Binding ExportIndicatorTooltip}"
                                    Focusable="False" Cursor="Hand">
                                <materialDesign:PackIcon Kind="Upload" Width="18" Height="18"
                                                         Foreground="#F59E0B">
                                    <materialDesign:PackIcon.RenderTransform>
                                        <TranslateTransform x:Name="ExportIndicatorBounce" Y="0"/>
                                    </materialDesign:PackIcon.RenderTransform>
                                </materialDesign:PackIcon>
                            </Button>
                            <Button Command="{Binding SynchronizeWithIbasesCommand}"
                                    Style="{DynamicResource IconButton}" Margin="0,0,2,0"
                                    ToolTip="{loc:Loc Main.SyncDetailedTooltip}">
                                <materialDesign:PackIcon Kind="Sync" Width="18" Height="18" Foreground="#14B8A6"/>
                            </Button>
                            <Button Command="{Binding CheckAvailabilityCommand}"
                                    Style="{DynamicResource IconButton}" Margin="0,0,2,0"
                                    ToolTip="{loc:Loc Main.CheckAvailabilityTooltip}">
                                <Path Width="18" Height="18" Stretch="Uniform"
                                      Data="{StaticResource IconSonar}" Fill="#14B8A6"/>
                            </Button>
                            <!-- Вертикальный разделитель: отделяет группу «Управление списком» от «Настройки» -->
                            <Border Width="1" Margin="4,5" VerticalAlignment="Stretch"
                                    Background="{DynamicResource BorderBrushColor}" Opacity="0.55"/>
                            <!-- «Настройки»: тема, компактный режим, настройки, справка -->
                            <Button x:Name="ThemeToggleButton" Click="OnToggleTheme_Click"
                                    Style="{DynamicResource IconButton}" Margin="0,0,2,0" ToolTip="{loc:Loc Main.Theme}">
                                <Path x:Name="ThemeToggleIcon" Width="18" Height="18" Stretch="Uniform"
                                      Data="{StaticResource IconMoon}" Fill="#8B5CF6"/>
                            </Button>
                            <!-- Компактный режим: быстрый переключатель плотности интерфейса -->
                            <ToggleButton x:Name="CompactModeButton" Click="OnCompactMode_Toggled"
                                          Style="{DynamicResource ToolbarToggleButton}" Margin="0,0,2,0"
                                          ToolTip="{loc:Loc Main.CompactModeTooltip}">
                                <materialDesign:PackIcon Kind="Compress" Width="18" Height="18"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                            </ToggleButton>
                            <Button Command="{Binding OpenSettingsCommand}" Style="{DynamicResource IconButton}"
                                    ToolTip="{loc:Loc Main.SettingsTooltip}">
                                <materialDesign:PackIcon Kind="Cog" Width="18" Height="18" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Button>
                            <!-- Подсказка «?»: после всех команд панели -->
                            <controls:HelpLink Margin="4,0,0,0"
                                               HelpText="{loc:Loc Main.BaseListHelp}"/>
                        </StackPanel>
                    </Border>

                    <!-- Область списка: общий горизонтальный ScrollViewer, чтобы заголовки колонок
                         прокручивались синхронно с содержимым дерева -->
                    <!-- Внешний ScrollViewer управляет прокруткой по обеим осям. Прокрутка дерева
                         вынесена сюда (а не на внутренний ScrollViewer TreeView), чтобы избежать
                         циклической привязки высоты, из-за которой полоса прокрутки пропадала при
                         сжатии окна. Контент (заголовки + дерево) прокручивается синхронно
                         по горизонтали и вертикали. -->
                    <!-- Правый отступ -10 компенсирует правый отступ 8 внешней сетки (Margin="12,12,8,12")
                         плюс оставшиеся ~2px у рамки панели: без этого между вертикальной полосой
                         прокрутки дерева и правой границей панели оставалась пустота ~13px (8 внешних
                         + 4 здесь + ~1px рамки). Отрицательный отступ выводит полосу вплотную к краю.
                         Верхняя панель и теги при этом сохраняют свой отступ. -->
                    <Grid Grid.Row="3" Margin="4,0,-10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Фиксированный заголовок таблицы: прокручивается только горизонтально,
                             синхронно со списком баз. При вертикальной прокрутке остаётся на месте. -->
                        <ScrollViewer x:Name="DbHeaderScroll" Grid.Row="0"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled"
                                      PreviewMouseWheel="OnDbHeader_PreviewMouseWheel">
                            <!-- Правый отступ компенсирует ширину вертикальной полосы прокрутки списка,
                                 чтобы правый край колонки (*) заголовка совпадал с данными. -->
                            <Border BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="0,0,0,1"
                                    Padding="0,2,0,2" MinHeight="36" Opacity="0.95">
                            <Grid x:Name="HeaderGrid" MinWidth="{Binding ActualWidth, ElementName=MainTree}">
                                <!-- Единственная star-строка: растягивается на высоту Border (MinHeight=36),
                                     чтобы заголовки колонок (VerticalAlignment="Center") были отцентрированы
                                     по вертикали строки после удаления кнопок управления группами. -->
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <!-- Былые кнопки «развернуть/свернуть» и «сортировка» групп перенесены в панель команд;
                                         колонка оставлена небольшим отступом для выравнивания заголовка с данными.
                                         Ширина синхронизирована с шаблонами групп и баз (GroupRowGrid/InfobaseRowGrid). -->
                                    <ColumnDefinition Width="{Binding DataContext.ShowExpandCollapseButtons, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToGridLen}, ConverterParameter=24}"/>
                                    <!-- Компенсация сдвига дерева (отступ вложенности групп) — ширина уточняется в AlignHeaderToData -->
                                    <ColumnDefinition x:Name="HeaderOffsetColumn" Width="0"/>
                                    <!-- Резерв под переключатель тегов (перенесён в панель команд). MinWidth убран:
                                         колонка пустая и не должна создавать лишний отступ слева от «Названия». -->
                                    <ColumnDefinition Width="{Binding DataContext.ShowFavoritesButton, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToGridLen}, ConverterParameter=28}"/>
                                    <ColumnDefinition Width="{Binding DataContext.ShowPinnedButton, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToGridLen}, ConverterParameter=26}"/>
                                    <!-- Имя: растягивается на оставшееся место, пока не задана фиксированная
                                         ширина перетаскиванием разделителя (NameColumnWidth). -->
                                    <ColumnDefinition x:Name="NameColumn">
                                        <ColumnDefinition.Width>
                                            <Binding Path="DataContext.NameColumnWidth" RelativeSource="{RelativeSource AncestorType=Window}"
                                                     Converter="{StaticResource NameColumnWidth}"/>
                                        </ColumnDefinition.Width>
                                    </ColumnDefinition>
                                    <ColumnDefinition x:Name="VersionColumn">
                                        <ColumnDefinition.Width>
                                            <MultiBinding Converter="{StaticResource ColumnVis}" ConverterParameter="120">
                                                <Binding Path="DataContext.ShowVersionColumn" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                <Binding Path="DataContext.VersionColumnWidth" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                            </MultiBinding>
                                        </ColumnDefinition.Width>
                                    </ColumnDefinition>
                                    <ColumnDefinition x:Name="LaunchModeColumn">
                                        <ColumnDefinition.Width>
                                            <MultiBinding Converter="{StaticResource ColumnVis}" ConverterParameter="120">
                                                <Binding Path="DataContext.ShowLaunchModeColumn" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                <Binding Path="DataContext.LaunchModeColumnWidth" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                            </MultiBinding>
                                        </ColumnDefinition.Width>
                                    </ColumnDefinition>
                                    <!-- Колонка «Действия»: встаёт сразу после «Режим запуска»;
                                         видимость управляется переключателем ShowActionsColumn,
                                         ширина настраивается перетаскиванием разделителя.
                                         MinWidth не задан намеренно — при скрытии колонка схлопывается в 0;
                                         минимум 120 гарантирует обработчик перетаскивания, пока колонка видима. -->
                                    <ColumnDefinition x:Name="ActionsColumn">
                                        <ColumnDefinition.Width>
                                            <MultiBinding Converter="{StaticResource ColumnVis}" ConverterParameter="170">
                                                <Binding Path="DataContext.ShowActionsColumn" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                <Binding Path="DataContext.ActionsColumnWidth" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                            </MultiBinding>
                                        </ColumnDefinition.Width>
                                    </ColumnDefinition>
                                    <ColumnDefinition x:Name="ServerColumn">
                                        <ColumnDefinition.Width>
                                            <MultiBinding Converter="{StaticResource ColumnVis}" ConverterParameter="200">
                                                <Binding Path="DataContext.ShowServerColumn" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                <Binding Path="DataContext.ServerColumnWidth" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                            </MultiBinding>
                                        </ColumnDefinition.Width>
                                    </ColumnDefinition>
                                    <ColumnDefinition x:Name="LastLaunchColumn">
                                        <ColumnDefinition.Width>
                                            <MultiBinding Converter="{StaticResource ColumnVis}" ConverterParameter="140">
                                                <Binding Path="DataContext.ShowLastLaunchColumn" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                <Binding Path="DataContext.LastLaunchColumnWidth" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                            </MultiBinding>
                                        </ColumnDefinition.Width>
                                    </ColumnDefinition>
                                    <ColumnDefinition x:Name="SizeColumn">
                                        <ColumnDefinition.Width>
                                            <MultiBinding Converter="{StaticResource ColumnVis}" ConverterParameter="90">
                                                <Binding Path="DataContext.ShowSizeColumn" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                <Binding Path="DataContext.SizeColumnWidth" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                            </MultiBinding>
                                        </ColumnDefinition.Width>
                                    </ColumnDefinition>
                                    <!-- Колонка «Конфигурация» — всегда в самом конце списка колонок -->
                                    <ColumnDefinition x:Name="ConfigurationColumn">
                                        <ColumnDefinition.Width>
                                            <MultiBinding Converter="{StaticResource ColumnVis}" ConverterParameter="160">
                                                <Binding Path="DataContext.ShowConfigurationColumn" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                <Binding Path="DataContext.ConfigurationColumnWidth" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                            </MultiBinding>
                                        </ColumnDefinition.Width>
                                    </ColumnDefinition>
                                </Grid.ColumnDefinitions>

                                <!-- Ведущие колонки (0-3) больше не содержат элементов управления:
                                     кнопки групп, переключатель тегов и индикатор закрепления перенесены
                                     в панель команд. Колонки оставлены для выравнивания заголовка с данными,
                                     чтобы колонка «Название» (Grid.Column="4") начиналась на том же месте,
                                     что и строки данных, а прокрутка DbHeaderScroll оставалась синхронной. -->

                                <!-- Заголовок «Название»: колонка звёздная (растягивается на свободное место),
                                     поэтому панель явно прижата к левому краю (HorizontalAlignment="Left"),
                                     а иконка и текст дополнительно зафиксированы слева, чтобы ни один
                                     неявный стиль/триггер не мог отцентрировать содержимое колонки. -->
                                    <StackPanel Grid.Column="0" Grid.ColumnSpan="5" Orientation="Horizontal" VerticalAlignment="Center"
                                            HorizontalAlignment="Left" Margin="0,0,8,4"
                                            Cursor="Hand" Tag="Name" ToolTip="{loc:Loc Main.ColumnNameSortTooltip}"
                                            MouseLeftButtonUp="OnColumnHeader_Click">
                                    <materialDesign:PackIcon Kind="FormatTitle" Width="13" Height="13"
                                                             Foreground="{DynamicResource TextSecondaryBrush}"
                                                             HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Loc Column.Name}" FontWeight="SemiBold" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               HorizontalAlignment="Left" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Margin="4,0,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center"
                                            HorizontalAlignment="Stretch" Margin="6,0,6,4">
                                    <materialDesign:PackIcon Kind="Information" Width="13" Height="13"
                                                             Foreground="{DynamicResource TextSecondaryBrush}"
                                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Loc Column.Version}" FontWeight="SemiBold" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Margin="4,0,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center"
                                            HorizontalAlignment="Stretch" Margin="6,0,6,4">
                                    <materialDesign:PackIcon Kind="Play" Width="13" Height="13"
                                                             Foreground="{DynamicResource TextSecondaryBrush}"
                                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Loc Column.LaunchMode}" FontWeight="SemiBold" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Margin="4,0,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center"
                                            HorizontalAlignment="Left" Margin="6,0,6,4"
                                            ToolTip="{loc:Loc Main.Actions}">
                                    <materialDesign:PackIcon Kind="Cog" Width="13" Height="13"
                                                             Foreground="{DynamicResource TextSecondaryBrush}"
                                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Loc Column.Actions}" FontWeight="SemiBold" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Margin="4,0,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center"
                                            HorizontalAlignment="Stretch" Margin="6,0,6,4">
                                    <materialDesign:PackIcon Kind="Server" Width="13" Height="13"
                                                             Foreground="{DynamicResource TextSecondaryBrush}"
                                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Loc Column.ServerBase}" FontWeight="SemiBold" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Margin="4,0,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="9" Orientation="Horizontal" VerticalAlignment="Center"
                                            HorizontalAlignment="Stretch" Margin="6,0,6,4"
                                            Cursor="Hand" Tag="LastLaunchDate" ToolTip="{loc:Loc Main.ColumnLastLaunchSortTooltip}"
                                            MouseLeftButtonUp="OnColumnHeader_Click">
                                    <materialDesign:PackIcon Kind="ClockOutline" Width="13" Height="13"
                                                             Foreground="{DynamicResource TextSecondaryBrush}"
                                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Loc Column.LastLaunch}" FontWeight="SemiBold" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Margin="4,0,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="10" Orientation="Horizontal" VerticalAlignment="Center"
                                            HorizontalAlignment="Stretch" Margin="6,0,6,4"
                                            ToolTip="{loc:Loc Main.ColumnSizeTooltip}">
                                    <materialDesign:PackIcon Kind="Database" Width="13" Height="13"
                                                             Foreground="{DynamicResource TextSecondaryBrush}"
                                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Loc Column.Size}" FontWeight="SemiBold" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Margin="4,0,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="11" Orientation="Horizontal" VerticalAlignment="Center"
                                            HorizontalAlignment="Stretch" Margin="6,0,6,4"
                                            ToolTip="{loc:Loc Main.ColumnNameTooltip}">
                                    <materialDesign:PackIcon Kind="CubeOutline" Width="13" Height="13"
                                                             Foreground="{DynamicResource TextSecondaryBrush}"
                                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Loc Column.Configuration}" FontWeight="SemiBold" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Margin="4,0,0,0"/>
                                </StackPanel>

                                <!-- Современные разделители колонок: тонкая линия + широкая зона захвата -->
                                <Border x:Name="NameSplitter" Grid.Column="4"
                                        HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="8"
                                        Panel.ZIndex="1" Background="Transparent" Cursor="SizeWE"
                                        ToolTip="{loc:Loc Main.ResizeColumnTooltip}"
                                        MouseLeftButtonDown="OnColumnResize_MouseDown"
                                        MouseMove="OnColumnResize_MouseMove"
                                        MouseLeftButtonUp="OnColumnResize_MouseUp">
                                    <Border Width="1" HorizontalAlignment="Center"
                                            Background="{DynamicResource BorderBrushColor}" Opacity="0.55"
                                            Margin="0,2,0,4"/>
                                </Border>
                                <Border x:Name="VersionSplitter" Grid.Column="5"
                                        HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="8"
                                        Panel.ZIndex="1" Background="Transparent" Cursor="SizeWE"
                                        ToolTip="{loc:Loc Main.ResizeColumnTooltip}"
                                        Visibility="{Binding DataContext.ShowVersionColumn, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                                        MouseLeftButtonDown="OnColumnResize_MouseDown"
                                        MouseMove="OnColumnResize_MouseMove"
                                        MouseLeftButtonUp="OnColumnResize_MouseUp">
                                    <Border Width="1" HorizontalAlignment="Center"
                                            Background="{DynamicResource BorderBrushColor}" Opacity="0.55"
                                            Margin="0,2,0,4"/>
                                </Border>
                                <Border x:Name="LaunchModeSplitter" Grid.Column="6"
                                        HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="8"
                                        Panel.ZIndex="1" Background="Transparent" Cursor="SizeWE"
                                        ToolTip="{loc:Loc Main.ResizeColumnTooltip}"
                                        Visibility="{Binding DataContext.ShowLaunchModeColumn, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                                        MouseLeftButtonDown="OnColumnResize_MouseDown"
                                        MouseMove="OnColumnResize_MouseMove"
                                        MouseLeftButtonUp="OnColumnResize_MouseUp">
                                    <Border Width="1" HorizontalAlignment="Center"
                                            Background="{DynamicResource BorderBrushColor}" Opacity="0.55"
                                            Margin="0,2,0,4"/>
                                </Border>
                                <Border x:Name="ActionsSplitter" Grid.Column="7"
                                        HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="8"
                                        Panel.ZIndex="1" Background="Transparent" Cursor="SizeWE"
                                        ToolTip="{loc:Loc Main.ResizeColumnTooltip}"
                                        MouseLeftButtonDown="OnColumnResize_MouseDown"
                                        MouseMove="OnColumnResize_MouseMove"
                                        MouseLeftButtonUp="OnColumnResize_MouseUp">
                                    <Border Width="1" HorizontalAlignment="Center"
                                            Background="{DynamicResource BorderBrushColor}" Opacity="0.55"
                                            Margin="0,2,0,4"/>
                                </Border>
                                <Border x:Name="ServerSplitter" Grid.Column="8"
                                        HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="8"
                                        Panel.ZIndex="1" Background="Transparent" Cursor="SizeWE"
                                        ToolTip="{loc:Loc Main.ResizeColumnTooltip}"
                                        Visibility="{Binding DataContext.ShowServerColumn, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                                        MouseLeftButtonDown="OnColumnResize_MouseDown"
                                        MouseMove="OnColumnResize_MouseMove"
                                        MouseLeftButtonUp="OnColumnResize_MouseUp">
                                    <Border Width="1" HorizontalAlignment="Center"
                                            Background="{DynamicResource BorderBrushColor}" Opacity="0.55"
                                            Margin="0,2,0,4"/>
                                </Border>
                                <Border x:Name="LastLaunchSplitter" Grid.Column="9"
                                        HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="8"
                                        Panel.ZIndex="1" Background="Transparent" Cursor="SizeWE"
                                        ToolTip="{loc:Loc Main.ResizeColumnTooltip}"
                                        Visibility="{Binding DataContext.ShowLastLaunchColumn, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                                        MouseLeftButtonDown="OnColumnResize_MouseDown"
                                        MouseMove="OnColumnResize_MouseMove"
                                        MouseLeftButtonUp="OnColumnResize_MouseUp">
                                    <Border Width="1" HorizontalAlignment="Center"
                                            Background="{DynamicResource BorderBrushColor}" Opacity="0.55"
                                            Margin="0,2,0,4"/>
                                </Border>
                                <Border x:Name="SizeSplitter" Grid.Column="10"
                                        HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="8"
                                        Panel.ZIndex="1" Background="Transparent" Cursor="SizeWE"
                                        ToolTip="{loc:Loc Main.ResizeColumnTooltip}"
                                        Visibility="{Binding DataContext.ShowSizeColumn, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                                        MouseLeftButtonDown="OnColumnResize_MouseDown"
                                        MouseMove="OnColumnResize_MouseMove"
                                        MouseLeftButtonUp="OnColumnResize_MouseUp">
                                    <Border Width="1" HorizontalAlignment="Center"
                                            Background="{DynamicResource BorderBrushColor}" Opacity="0.55"
                                            Margin="0,2,0,4"/>
                                </Border>
                                <Border x:Name="ConfigurationSplitter" Grid.Column="11"
                                        HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="8"
                                        Panel.ZIndex="1" Background="Transparent" Cursor="SizeWE"
                                        ToolTip="{loc:Loc Main.ResizeColumnTooltip}"
                                        Visibility="{Binding DataContext.ShowConfigurationColumn, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                                        MouseLeftButtonDown="OnColumnResize_MouseDown"
                                        MouseMove="OnColumnResize_MouseMove"
                                        MouseLeftButtonUp="OnColumnResize_MouseUp">
                                    <Border Width="1" HorizontalAlignment="Center"
                                            Background="{DynamicResource BorderBrushColor}" Opacity="0.55"
                                            Margin="0,2,0,4"/>
                                </Border>
                            </Grid>
                            </Border>
                        </ScrollViewer>

                    <!-- Прокручиваемая область списка баз. Прокручивается только по вертикали,
                         заголовок таблицы выше остаётся на месте. -->
                    <!-- Список баз в виде дерева «группа в группе» -->
                    <controls:LeveledTreeView x:Name="MainTree"
                              Grid.Row="1"
                              AllowDrop="True"
                              PreviewMouseMove="OnMainTree_PreviewMouseMove"
                              PreviewMouseWheel="OnMainTree_PreviewMouseWheel"
                              DragOver="OnMainTree_DragOver"
                              Drop="OnMainTree_Drop"
                              GiveFeedback="OnMainTree_GiveFeedback"
                              ItemsSource="{Binding GroupNodes}"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="0"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.CanContentScroll="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              SelectedItemChanged="OnMainTree_SelectedItemChanged"
                              RequestBringIntoView="OnMainTree_RequestBringIntoView"
                              PreviewMouseDoubleClick="OnInfobaseTree_PreviewMouseDoubleClick"
                              PreviewMouseRightButtonDown="OnInfobaseTree_PreviewMouseRightButtonDown"
                              PreviewMouseLeftButtonDown="OnInfobaseTree_PreviewMouseLeftButtonDown">

                        <!-- Виртуализация панели: при большом числе баз создаются только видимые строки. -->
                        <controls:LeveledTreeView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </controls:LeveledTreeView.ItemsPanel>

                        <controls:LeveledTreeView.Resources>
                            <!-- Узел группы: заголовок + вложенные подгруппы и базы -->
                            <HierarchicalDataTemplate DataType="{x:Type vm:GroupNodeViewModel}"
                                                      ItemsSource="{Binding Items}">
                                <!-- Заголовок группы без собственного горизонтального отступа:
                                     сдвиг иерархии даёт отступ Expander по Level (в ItemContainerStyle).
                                     Фон/выделение начинаются сразу после кнопки разворота. -->
                                <Border CornerRadius="6">
                                    <!-- Отступ заголовка группы по уровню вложенности. У групп с дочерними
                                         элементами сдвиг даёт кнопка разворота; у пустых (листовых) групп её нет,
                                         поэтому GroupOffset добавляет такой же отступ, чтобы иерархия сохранялась.
                                         Третье значение MultiBinding — флаг компактного режима: в нём вертикальный
                                         зазор между группами убирается (см. GroupOffsetConverter). -->
                                    <Border.Margin>
                                        <MultiBinding Converter="{StaticResource GroupOffset}">
                                            <Binding Path="(controls:LeveledTreeView.Level)"
                                                     RelativeSource="{RelativeSource AncestorType=TreeViewItem}"/>
                                            <Binding Path="HasItems"
                                                     RelativeSource="{RelativeSource AncestorType=TreeViewItem}"/>
                                            <Binding Path="DataContext.CompactMode"
                                                     RelativeSource="{RelativeSource AncestorType=Window}"/>
                                        </MultiBinding>
                                    </Border.Margin>
                                    <Border.Style>
                                        <!-- Внешний контейнер отвечает только за раскладку (Padding и выравнивание
                                             колонок через GroupOffset) — сам фон прозрачный. Фон и выделение группы
                                             рисует внутренний слой GroupHighlight, который начинается сразу после
                                             кнопки свернуть/развернуть (оформление 0.3.5.1). -->
                                        <Style TargetType="Border">
                                            <Setter Property="Padding" Value="8,3"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.CompactMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                    <Setter Property="Padding" Value="6,1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <!-- Сетка-слой: фон/выделение группы тянется на всю ширину строки (не
                                         ограничено колонками GroupRowGrid), начинается сразу после кнопки
                                         разворота и рисуется позади содержимого. -->
                                    <Grid>
                                        <!-- Слой фона/выделения группы: HeaderBrush и акцентная рамка при выборе -->
                                        <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                CornerRadius="6">
                                            <Border.Margin>
                                                <MultiBinding Converter="{StaticResource LevelToThickness}" ConverterParameter="group-hl">
                                                    <Binding Path="(controls:LeveledTreeView.Level)"
                                                             RelativeSource="{RelativeSource AncestorType=TreeViewItem}"/>
                                                </MultiBinding>
                                            </Border.Margin>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <!-- Готовая кисть с узла — без поиска группы и GetFullPath при каждой отрисовке -->
                                                    <Setter Property="Background" Value="{Binding HeaderBrush}"/>
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <Grid x:Name="GroupRowGrid" Loaded="OnGroupRowGrid_Loaded">
                                        <Grid.ColumnDefinitions>
                                            <!-- Сетка повторяет набор ведущих колонок строки базы и заголовка
                                                 (кнопки групп + компенсатор + избранное + закрепление + название),
                                                 чтобы команды группы оказывались в той же колонке «Действия»,
                                                 что и кнопки строк баз, а имя/счётчик группы — в области названия. -->
                                            <ColumnDefinition Width="{Binding DataContext.ShowExpandCollapseButtons, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToGridLen}, ConverterParameter=24}"/>
                                            <ColumnDefinition Width="0"/>
                                            <!-- MinWidth (резерв под переключатель тегов) убран: кнопки перенесены
                                                 в панель команд, колонка пустая. Структура синхронизирована с шапкой. -->
                                            <ColumnDefinition Width="{Binding DataContext.ShowFavoritesButton, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToGridLen}, ConverterParameter=28}"/>
                                            <ColumnDefinition Width="{Binding DataContext.ShowPinnedButton, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToGridLen}, ConverterParameter=26}"/>
                                            <ColumnDefinition>
                                                <ColumnDefinition.Width>
                                                    <Binding Path="DataContext.NameColumnWidth" RelativeSource="{RelativeSource AncestorType=Window}"
                                                             Converter="{StaticResource NameColumnWidth}"/>
                                                </ColumnDefinition.Width>
                                            </ColumnDefinition>
                                            <ColumnDefinition>
                                                <ColumnDefinition.Width>
                                                    <MultiBinding Converter="{StaticResource ColumnVis}" ConverterParameter="120">
                                                        <Binding Path="DataContext.ShowVersionColumn" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        <Binding Path="DataContext.VersionColumnWidth" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                    </MultiBinding>
                                                </ColumnDefinition.Width>
                                            </ColumnDefinition>
                                            <ColumnDefinition>
                                                <ColumnDefinition.Width>
                                                    <MultiBinding Converter="{StaticResource ColumnVis}" ConverterParameter="120">
                                                        <Binding Path="DataContext.ShowLaunchModeColumn" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        <Binding Path="DataContext.LaunchModeColumnWidth" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                    </MultiBinding>
                                                </ColumnDefinition.Width>
                                            </ColumnDefinition>
                                            <!-- Колонка «Действия»: команды группы на уровне кнопок строк баз.
                                                 Видимость управляется переключателем ShowActionsColumn.
                                                 MinWidth не задан намеренно — минимум 120 гарантирует
                                                 обработчик перетаскивания, пока колонка видима. -->
                                            <ColumnDefinition>
                                                <ColumnDefinition.Width>
                                                    <MultiBinding Converter="{StaticResource ColumnVis}" ConverterParameter="170">
                                                        <Binding Path="DataContext.ShowActionsColumn" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        <Binding Path="DataContext.ActionsColumnWidth" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                    </MultiBinding>
                                                </ColumnDefinition.Width>
                                            </ColumnDefinition>
                                            <ColumnDefinition>
                                                <ColumnDefinition.Width>
                                                    <MultiBinding Converter="{StaticResource ColumnVis}" ConverterParameter="200">
                                                        <Binding Path="DataContext.ShowServerColumn" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        <Binding Path="DataContext.ServerColumnWidth" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                    </MultiBinding>
                                                </ColumnDefinition.Width>
                                            </ColumnDefinition>
                                            <ColumnDefinition>
                                                <ColumnDefinition.Width>
                                                    <MultiBinding Converter="{StaticResource ColumnVis}" ConverterParameter="140">
                                                        <Binding Path="DataContext.ShowLastLaunchColumn" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        <Binding Path="DataContext.LastLaunchColumnWidth" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                    </MultiBinding>
                                                </ColumnDefinition.Width>
                                            </ColumnDefinition>
                                            <ColumnDefinition>
                                                <ColumnDefinition.Width>
                                                    <MultiBinding Converter="{StaticResource ColumnVis}" ConverterParameter="90">
                                                        <Binding Path="DataContext.ShowSizeColumn" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        <Binding Path="DataContext.SizeColumnWidth" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                    </MultiBinding>
                                                </ColumnDefinition.Width>
                                            </ColumnDefinition>
                                            <ColumnDefinition>
                                                <ColumnDefinition.Width>
                                                    <MultiBinding Converter="{StaticResource ColumnVis}" ConverterParameter="160">
                                                        <Binding Path="DataContext.ShowConfigurationColumn" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        <Binding Path="DataContext.ConfigurationColumnWidth" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                    </MultiBinding>
                                                </ColumnDefinition.Width>
                                            </ColumnDefinition>
                                        </Grid.ColumnDefinitions>

                                        <!-- Имя группы и счётчик: область названия, тянется до колонки «Действия» -->
                                        <StackPanel Grid.Column="0" Grid.ColumnSpan="7"
                                                    Orientation="Horizontal" VerticalAlignment="Center"
                                                    HorizontalAlignment="Left">
                                            <!-- Отступ названия группы по уровню вложенности (сдвиг перенесён сюда
                                                 с самого заголовка, чтобы колонка «Действия» не уезжала вправо). -->
                                            <StackPanel.Margin>
                                                <MultiBinding Converter="{StaticResource LevelToThickness}" ConverterParameter="group">
                                                    <Binding Path="(controls:LeveledTreeView.Level)"
                                                             RelativeSource="{RelativeSource AncestorType=TreeViewItem}"/>
                                                </MultiBinding>
                                            </StackPanel.Margin>
                                            <Path Stretch="Uniform" Margin="0,0,8,0"
                                                  VerticalAlignment="Center"
                                                  Fill="{Binding IconBrush}"
                                                  Data="{Binding Icon, Converter={StaticResource IconKeyToGeometryConverter}}">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Width" Value="18"/>
                                                        <Setter Property="Height" Value="18"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.CompactMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                <Setter Property="Width" Value="14"/>
                                                                <Setter Property="Height" Value="14"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Foreground="{Binding HeaderTextBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontSize" Value="15"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.CompactMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                <Setter Property="FontSize" Value="12"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding TotalInfobaseCount, StringFormat=' ({0})'}"
                                                       VerticalAlignment="Center" Margin="6,0,0,0"
                                                       Foreground="{Binding HeaderTextBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontSize" Value="13"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.CompactMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                <Setter Property="FontSize" Value="11"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <!-- Команды группы в колонке «Действия»: «Изменить группу» и «Удалить группу».
                                             «Изменить» доступна и у закреплённых (маркер Pinned) — пользователь может
                                             редактировать настройки закрепления через то же окно группы;
                                             «Удалить» скрыта у закреплённых и «Без группы» (маркеры Pinned/NoGroup),
                                             т.к. это служебные узлы без модели Group, их нельзя удалять. -->
                                        <StackPanel Grid.Column="7" Orientation="Horizontal"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Button Command="{Binding DataContext.EditGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Margin="1,0"
                                                    ToolTip="{loc:Loc Main.EditGroupTooltip}"
                                                    Style="{StaticResource IconButton}">
                                                <materialDesign:PackIcon Kind="Pencil" Width="15" Height="15"
                                                                         Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Button>
                                            <Button Command="{Binding DataContext.DeleteGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Margin="1,0"
                                                    ToolTip="{loc:Loc Main.DeleteGroupTooltip}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Marker}" Value="Pinned">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Marker}" Value="NoGroup">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <materialDesign:PackIcon Kind="Delete" Width="15" Height="15"
                                                                         Foreground="#DC2626"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    </Grid>
                                </Border>
                            </HierarchicalDataTemplate>

                            <!-- Строка информационной базы -->
                            <DataTemplate DataType="{x:Type models:Infobase}">
                                <Border Padding="0,3" Margin="0,1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="CornerRadius" Value="4"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <!-- Сетка-слой: подсветка выбранной базы тянется на всю ширину строки до правого
                                         края (как оформление группы), начинается немного раньше значка «избранное»
                                         и рисуется позади содержимого. -->
                                    <Grid>
                                        <!-- Слой подсветки выбранной базы -->
                                        <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                CornerRadius="4">
                                            <Border.Margin>
                                                <MultiBinding Converter="{StaticResource LevelToThickness}" ConverterParameter="base-hl">
                                                    <Binding Path="(controls:LeveledTreeView.Level)"
                                                             RelativeSource="{RelativeSource AncestorType=TreeViewItem}"/>
                                                </MultiBinding>
                                            </Border.Margin>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <Grid x:Name="InfobaseRowGrid" Loaded="OnInfobaseRowGrid_Loaded">
                                        <Grid.ColumnDefinitions>
                                            <!-- Ведущие колонки повторяют набор заголовка: кнопки групп + компенсатор +
                                                 избранное + закрепление + название. Одинаковая структура ведущих колонок
                                                 гарантирует, что колонки данных строк точно совпадают по горизонтали
                                                 с заголовками. Компенсатор в строке всегда нулевой (сдвиг вложенности
                                                 даёт отступ названия LevelToThickness). -->
                                            <ColumnDefinition Width="{Binding DataContext.ShowExpandCollapseButtons, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToGridLen}, ConverterParameter=24}"/>
                                            <ColumnDefinition Width="0"/>
                                            <!-- MinWidth (резерв под переключатель тегов) убран: кнопки перенесены
                                                 в панель команд, колонка пустая. Структура синхронизирована с шапкой. -->
                                            <ColumnDefinition Width="{Binding DataContext.ShowFavoritesButton, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToGridLen}, ConverterParameter=28}"/>
                                            <ColumnDefinition Width="{Binding DataContext.ShowPinnedButton, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToGridLen}, ConverterParameter=26}"/>
                                            <ColumnDefinition>
                                                <ColumnDefinition.Width>
                                                    <Binding Path="DataContext.NameColumnWidth" RelativeSource="{RelativeSource AncestorType=Window}"
                                                             Converter="{StaticResource NameColumnWidth}"/>
                                                </ColumnDefinition.Width>
                                            </ColumnDefinition>
                                            <ColumnDefinition>
                                                <ColumnDefinition.Width>
                                                    <MultiBinding Converter="{StaticResource ColumnVis}" ConverterParameter="120">
                                                        <Binding Path="DataContext.ShowVersionColumn" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        <Binding Path="DataContext.VersionColumnWidth" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                    </MultiBinding>
                                                </ColumnDefinition.Width>
                                            </ColumnDefinition>
                                            <ColumnDefinition>
                                                <ColumnDefinition.Width>
                                                    <MultiBinding Converter="{StaticResource ColumnVis}" ConverterParameter="120">
                                                        <Binding Path="DataContext.ShowLaunchModeColumn" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        <Binding Path="DataContext.LaunchModeColumnWidth" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                    </MultiBinding>
                                                </ColumnDefinition.Width>
                                            </ColumnDefinition>
                                            <!-- Колонка «Действия»: встаёт сразу после «Режим запуска», совпадает с заголовком.
                                                 Видимость управляется переключателем ShowActionsColumn.
                                                 MinWidth не задан намеренно — минимум 120 гарантирует
                                                 обработчик перетаскивания, пока колонка видима. -->
                                            <ColumnDefinition>
                                                <ColumnDefinition.Width>
                                                    <MultiBinding Converter="{StaticResource ColumnVis}" ConverterParameter="170">
                                                        <Binding Path="DataContext.ShowActionsColumn" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        <Binding Path="DataContext.ActionsColumnWidth" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                    </MultiBinding>
                                                </ColumnDefinition.Width>
                                            </ColumnDefinition>
                                            <ColumnDefinition>
                                                <ColumnDefinition.Width>
                                                    <MultiBinding Converter="{StaticResource ColumnVis}" ConverterParameter="200">
                                                        <Binding Path="DataContext.ShowServerColumn" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        <Binding Path="DataContext.ServerColumnWidth" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                    </MultiBinding>
                                                </ColumnDefinition.Width>
                                            </ColumnDefinition>
                                            <ColumnDefinition>
                                                <ColumnDefinition.Width>
                                                    <MultiBinding Converter="{StaticResource ColumnVis}" ConverterParameter="140">
                                                        <Binding Path="DataContext.ShowLastLaunchColumn" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        <Binding Path="DataContext.LastLaunchColumnWidth" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                    </MultiBinding>
                                                </ColumnDefinition.Width>
                                            </ColumnDefinition>
                                            <ColumnDefinition>
                                                <ColumnDefinition.Width>
                                                    <MultiBinding Converter="{StaticResource ColumnVis}" ConverterParameter="90">
                                                        <Binding Path="DataContext.ShowSizeColumn" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        <Binding Path="DataContext.SizeColumnWidth" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                    </MultiBinding>
                                                </ColumnDefinition.Width>
                                            </ColumnDefinition>
                                            <!-- Колонка «Конфигурация» — всегда в самом конце списка колонок -->
                                            <ColumnDefinition>
                                                <ColumnDefinition.Width>
                                                    <MultiBinding Converter="{StaticResource ColumnVis}" ConverterParameter="160">
                                                        <Binding Path="DataContext.ShowConfigurationColumn" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        <Binding Path="DataContext.ConfigurationColumnWidth" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                    </MultiBinding>
                                                </ColumnDefinition.Width>
                                            </ColumnDefinition>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Иконка статуса + название: старт с колонки 0 (под иконкой группы),
                                             без лишних пробелов; сдвиг только по уровню родителя (base). -->
                                        <StackPanel Grid.Column="0" Grid.ColumnSpan="5"
                                                    Orientation="Horizontal" VerticalAlignment="Center">
                                            <StackPanel.Margin>
                                                <MultiBinding Converter="{StaticResource LevelToThickness}" ConverterParameter="base">
                                                    <Binding Path="(controls:LeveledTreeView.Level)"
                                                             RelativeSource="{RelativeSource AncestorType=TreeViewItem}"/>
                                                </MultiBinding>
                                            </StackPanel.Margin>
                                            <!-- Избранное (звезда): действует на конкретную базу этой строки.
                                                 Бейдж справа показывает номер горячей клавиши (если назначен). -->
                                            <Button Command="{Binding DataContext.ToggleFavoriteForCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent" BorderThickness="0"
                                                    Cursor="Hand" Padding="0,0,2,0"
                                                    MinWidth="0" MinHeight="0"
                                                    VerticalAlignment="Center"
                                                    ToolTip="{loc:Loc Main.ToggleFavoriteTooltip}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <materialDesign:PackIcon Kind="Star" Width="14" Height="14" VerticalAlignment="Center">
                                                        <materialDesign:PackIcon.Style>
                                                            <Style TargetType="materialDesign:PackIcon">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource FavoriteBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </materialDesign:PackIcon.Style>
                                                    </materialDesign:PackIcon>
                                                    <Border VerticalAlignment="Center" Margin="2,0,0,0" CornerRadius="3" Padding="4,0,4,1"
                                                            MinWidth="16" Background="{DynamicResource FavoriteBrush}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding IsFavorite}" Value="True"/>
                                                                            <Condition Binding="{Binding FavoriteHotkeyNumber}" Value="0"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </MultiDataTrigger>
                                                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding FavoriteHotkeyNumber}" Value="0">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding FavoriteHotkeyDisplay}"
                                                                   FontSize="10" FontWeight="Bold"
                                                                   Foreground="#1C1917"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                </StackPanel>
                                            </Button>
                                            <!-- Закрепление (пин): действует на конкретную базу этой строки. -->
                                            <Button Command="{Binding DataContext.TogglePinForCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent" BorderThickness="0"
                                                    Cursor="Hand" Padding="0,0,4,0"
                                                    MinWidth="0" MinHeight="0"
                                                    VerticalAlignment="Center"
                                                    ToolTip="{loc:Loc Main.TogglePinTooltip}">
                                                <materialDesign:PackIcon Kind="Pin" Width="14" Height="14" VerticalAlignment="Center">
                                                    <materialDesign:PackIcon.Style>
                                                        <Style TargetType="materialDesign:PackIcon">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </materialDesign:PackIcon.Style>
                                                </materialDesign:PackIcon>
                                            </Button>
                                            <!-- Иконка статуса базы: тип подключения (файловая / веб-сервер /
                                                 клиент-серверная) или «недоступна». Цвет зависит от статуса:
                                                 янтарный — файловая, синий — веб, фиолетовый — клиент-сервер,
                                                 красный — недоступна. -->
                                            <Path Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"
                                                  VerticalAlignment="Center"
                                                  Data="{Binding StatusIconKey, Converter={StaticResource IconKeyToGeometryConverter}}"
                                                  ToolTip="{Binding StatusDisplay}">
                                                <Path.Fill>
                                                    <MultiBinding Converter="{StaticResource GroupColorConverter}">
                                                        <Binding Path="StatusColorHex"/>
                                                    </MultiBinding>
                                                </Path.Fill>
                                            </Path>
                                            <TextBlock x:Name="NameText" Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="5" Text="{Binding PlatformVersionDisplay}" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                                                   HorizontalAlignment="Left" Margin="6,0,6,0" TextTrimming="CharacterEllipsis"
                                                   Tag="PlatformVersion"
                                                   Cursor="Hand"
                                                   ToolTip="{loc:Loc Main.PlatformVersionTooltip}"/>

                                        <TextBlock Grid.Column="11" Text="{Binding ConfigurationDisplay}" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                                                   HorizontalAlignment="Left" Margin="6,0,6,0" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding ConfigurationDisplay}"/>

                                        <TextBlock Grid.Column="6" Text="{Binding ParsedLaunchMode}" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                                                   HorizontalAlignment="Left" Margin="6,0,6,0" TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Grid.Column="8" Text="{Binding ServerDatabaseDisplay}" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                                                   HorizontalAlignment="Left" Margin="6,0,6,0" TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Grid.Column="9" Text="{Binding LastLaunchDisplay}" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                                                   HorizontalAlignment="Left" Margin="6,0,6,0" TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Grid.Column="10" Text="{Binding FileSizeDisplay}" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                                                   HorizontalAlignment="Left" Margin="6,0,6,0" TextTrimming="CharacterEllipsis"/>

                                        <!-- Колонка «Действия»: встаёт сразу после «Режим запуска»; кнопки управления конкретной базой этой строки -->
                                        <StackPanel Grid.Column="7" Grid.RowSpan="2" Orientation="Horizontal"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Button Command="{Binding DataContext.LaunchEnterpriseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{DynamicResource IconButton}" Margin="1,0"
                                                    ToolTip="{loc:Loc Main.LaunchEnterpriseTooltip}">
                                                <materialDesign:PackIcon Kind="Play" Width="15" Height="15"
                                                                         Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Button>
                                            <Button Command="{Binding DataContext.LaunchConfiguratorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{DynamicResource IconButton}" Margin="1,0"
                                                    ToolTip="{loc:Loc Main.LaunchConfiguratorSectionTooltip}">
                                                <materialDesign:PackIcon Kind="Wrench" Width="15" Height="15"
                                                                         Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Button>
                                            <Button Command="{Binding DataContext.ClearCacheCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{DynamicResource IconButton}" Margin="1,0"
                                                    ToolTip="{loc:Loc Main.ClearCacheTooltip}">
                                                <materialDesign:PackIcon Kind="Broom" Width="15" Height="15"
                                                                         Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Button>
                                        </StackPanel>

                                        <!-- Теги базы: тот же сдвиг, старт с колонки 0 как у ★/📌/названия -->
                                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="7"
                                                    Orientation="Horizontal"
                                                    Visibility="{Binding DataContext.ShowTags, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                            <StackPanel.Margin>
                                                <MultiBinding Converter="{StaticResource LevelToThickness}" ConverterParameter="base">
                                                    <Binding Path="(controls:LeveledTreeView.Level)"
                                                             RelativeSource="{RelativeSource AncestorType=TreeViewItem}"/>
                                                </MultiBinding>
                                            </StackPanel.Margin>
                                            <ItemsControl ItemsSource="{Binding Tags}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel VerticalAlignment="Center"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource ItemHoverBrush}" CornerRadius="3"
                                                                Padding="4,0" Margin="0,0,3,0" Height="16"
                                                                VerticalAlignment="Center"
                                                                BorderThickness="0" SnapsToDevicePixels="True">
                                                            <DockPanel LastChildFill="False" VerticalAlignment="Center">
                                                                <Button DockPanel.Dock="Left"
                                                                        Command="{Binding DataContext.SearchByTagCommand, RelativeSource={RelativeSource AncestorType=TreeView}}"
                                                                        CommandParameter="{Binding}"
                                                                        Background="Transparent" BorderThickness="0"
                                                                        Padding="0" Margin="0" Height="14" Width="Auto"
                                                                        MinHeight="0" MinWidth="0" MaxHeight="14"
                                                                        Cursor="Hand" ToolTip="{loc:Loc Main.ShowTagBases}"
                                                                        VerticalAlignment="Center" HorizontalAlignment="Left">
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <TextBlock Text="{Binding}" Foreground="{DynamicResource AccentBrush}"
                                                                                       FontSize="11" FontWeight="SemiBold"
                                                                                       VerticalAlignment="Center"
                                                                                       LineHeight="12" LineStackingStrategy="BlockLineHeight"/>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                </Button>
                                                                <Button DockPanel.Dock="Left" Click="OnRemoveTag_Click"
                                                                        Background="Transparent" BorderThickness="0"
                                                                        Padding="0" Margin="2,0,0,0" Height="12" Width="12"
                                                                        MinHeight="0" MinWidth="0" MaxHeight="12"
                                                                        Cursor="Hand" ToolTip="{loc:Loc Main.RemoveTag}"
                                                                        VerticalAlignment="Center">
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <TextBlock Text="×" FontSize="11" LineHeight="12"
                                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                       LineStackingStrategy="BlockLineHeight"/>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                </Button>
                                                            </DockPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button x:Name="AddTagButton"
                                                    Click="OnAddTagInline_Click"
                                                    Background="Transparent" BorderThickness="0" Padding="2,0"
                                                    Cursor="Hand" Height="16" MinHeight="0" VerticalAlignment="Center" Margin="2,0,0,0"
                                                    ToolTip="{loc:Loc Main.AddTag}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Width="11" Height="11" Stretch="Uniform" Margin="0,0,3,0"
                                                          VerticalAlignment="Center" Data="{StaticResource IconTag}"
                                                          Fill="{DynamicResource TextSecondaryBrush}"/>
                                                    <TextBlock Text="{loc:Loc Main.AddTagShort}" FontSize="11" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                            </Button>
                                            <TextBox x:Name="InlineTagBox" Visibility="Collapsed"
                                                     Width="120" FontSize="12" Padding="6,3"
                                                     MinHeight="24" Margin="4,0,0,0" VerticalAlignment="Center"
                                                     Background="{DynamicResource CardBackgroundBrush}"
                                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                                     BorderBrush="{DynamicResource AccentBrush}"
                                                     BorderThickness="1"
                                                     CaretBrush="{DynamicResource TextPrimaryBrush}"
                                                     KeyDown="OnInlineTagBox_KeyDown"
                                                     LostFocus="OnInlineTagBox_LostFocus"
                                                     ToolTip="{loc:Loc Main.EnterTagHint}"/>
                                        </StackPanel>
                                    </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </controls:LeveledTreeView.Resources>

                        <controls:LeveledTreeView.ItemContainerStyle>
                            <!-- Стиль элемента дерева: заголовок группы/базы и вложенные элементы.
                                 ItemsPresenter без отступа — колонки данных всех баз выровнены.
                                 Иерархия: сдвиг только названия базы (LevelToThickness) и заголовка группы (GroupOffset). -->
                            <Style TargetType="TreeViewItem">
                                <!-- Скрыть красную рамку ошибок привязки (IsExpanded у листьев-баз и т.п.) -->
                                <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <!-- Выбором полностью управляет code-behind (OnInfobaseTree_PreviewMouseLeftButtonDown).
                                     Двухсторонняя привязка IsSelected к модели здесь НЕ используется: она порождает
                                     каскад событий SelectedItemChanged (база дублируется в «Закреплённых» и в своей
                                     группе), что приводит к бесконечной рекурсии и StackOverflowException. -->
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                <!-- Виртуализация вложенных уровней: иначе при развороте групп создаются все строки сразу -->
                                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
                                <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
                                <Setter Property="ItemsPanel">
                                    <Setter.Value>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel/>
                                        </ItemsPanelTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TreeViewItem">
                                            <StackPanel>
                                                <Grid x:Name="RowGrid">
                                                    <!-- Без отступа ItemsPresenter: строки баз на одном уровне с заголовками колонок.
                                                         Иерархия — только сдвиг названия/заголовка группы по Level. -->
                                                    <Grid.ColumnDefinitions>
                                                        <!-- Колонка expander: у листьев кнопка Collapsed → ширина Auto ≈ 0 -->
                                                        <ColumnDefinition Width="Auto" MinWidth="0"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Контент заголовка размещаем ДО расширителя, чтобы кнопка разворота
                                                         рисовалась поверх: заголовок группы выравнивается в начало строки
                                                         (отрицательный отступ GroupOffset), иначе фон заголовка перекрывал
                                                         бы кнопку «+/-». -->
                                                    <Border x:Name="row" Grid.Column="1" Background="Transparent">
                                                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <!-- Кнопка свернуть/развернуть: «+» = группа свёрнута, «−» = развёрнута.
                                                         Видна только у узлов с дочерними элементами (группы). -->
                                                    <Button x:Name="Expander" Grid.Column="0"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            Command="{Binding DataContext.ToggleGroupExpandedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Width="26" Height="26"
                                                            Background="Transparent" BorderThickness="0"
                                                            Cursor="Hand"
                                                            ToolTip="{loc:Loc Main.ExpandCollapseGroup}">
                                                        <Button.Margin>
                                                            <MultiBinding Converter="{StaticResource LevelToThickness}">
                                                                <Binding Path="(controls:LeveledTreeView.Level)"
                                                                         RelativeSource="{RelativeSource AncestorType=TreeViewItem}"/>
                                                            </MultiBinding>
                                                        </Button.Margin>
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="ToolTip" Value="{loc:Loc Main.CollapseGroup}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="False">
                                                                        <Setter Property="ToolTip" Value="{loc:Loc Main.ExpandGroup}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="ExpanderBorder"
                                                                        Width="22" Height="22"
                                                                        Background="{DynamicResource CardBackgroundBrush}"
                                                                        BorderBrush="{DynamicResource AccentBrush}"
                                                                        BorderThickness="1.5"
                                                                        CornerRadius="5"
                                                                        SnapsToDevicePixels="True">
                                                                    <Grid>
                                                                        <!-- «−» : группа развёрнута -->
                                                                        <Path x:Name="IconExpanded"
                                                                              Width="12" Height="12"
                                                                              Stretch="Uniform"
                                                                              Fill="{DynamicResource AccentBrush}"
                                                                              HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"
                                                                              Data="{StaticResource IconMinus}"
                                                                              Visibility="Visible"/>
                                                                        <!-- «+» : группа свёрнута -->
                                                                        <Path x:Name="IconCollapsed"
                                                                              Width="12" Height="12"
                                                                              Stretch="Uniform"
                                                                              Fill="{DynamicResource AccentBrush}"
                                                                              HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"
                                                                              Data="{StaticResource IconPlus}"
                                                                              Visibility="Collapsed"/>
                                                                    </Grid>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <!-- Состояние по TreeViewItem.IsExpanded (не DataContext — у Infobase нет IsExpanded) -->
                                                                    <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="False">
                                                                        <Setter TargetName="IconExpanded" Property="Visibility" Value="Collapsed"/>
                                                                        <Setter TargetName="IconCollapsed" Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="ExpanderBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                                        <Setter TargetName="IconExpanded" Property="Fill" Value="White"/>
                                                                        <Setter TargetName="IconCollapsed" Property="Fill" Value="White"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsPressed" Value="True">
                                                                        <Setter TargetName="ExpanderBorder" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                                                                        <Setter TargetName="IconExpanded" Property="Fill" Value="White"/>
                                                                        <Setter TargetName="IconCollapsed" Property="Fill" Value="White"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </Grid>
                                                <!-- Отступ вложенности НЕ применяется к ItemsPresenter: иначе все колонки данных
                                                     вложенных баз сдвигаются относительно заголовков. Иерархия показывается
                                                     сдвигом только названия базы (LevelToThickness) и заголовка группы
                                                     (GroupOffset). Все строки баз выровнены по одним и тем же колонкам. -->
                                                <ItemsPresenter x:Name="ItemsHost" Margin="0,0,0,0"/>
                                            </StackPanel>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsExpanded" Value="False">
                                                    <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                                                </Trigger>
                                                <!-- Collapsed (не Hidden): у листьев колонка expander не занимает место -->
                                                <Trigger Property="HasItems" Value="False">
                                                    <Setter TargetName="Expander" Property="Visibility" Value="Collapsed"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="row" Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                                </Trigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                                                        <Condition Binding="{Binding HasItems, RelativeSource={RelativeSource TemplatedParent}}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter TargetName="row" Property="Background" Value="{DynamicResource TreeSelectedBrush}"/>
                                                </MultiDataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <!-- Синхронизация только для GroupNodeViewModel (у Infobase нет IsExpanded).
                                         Проверка по наличию дочерних элементов + FallbackValue глушит ошибки. -->
                                    <!-- OneWay из модели. TwoWay + Fallback на не-GroupNode давал красные полосы Validation. -->
                                    <DataTrigger Binding="{Binding HasItems, RelativeSource={RelativeSource Self}}" Value="True">
                                        <Setter Property="IsExpanded">
                                            <Setter.Value>
                                                <Binding Path="IsExpanded" Mode="OneWay"
                                                         FallbackValue="False"
                                                         TargetNullValue="False"/>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </controls:LeveledTreeView.ItemContainerStyle>

                        <!-- Контекстное меню по правой кнопке мыши для выбранной базы -->
                        <controls:LeveledTreeView.ContextMenu>
                            <ContextMenu Style="{DynamicResource ModernContextMenu}">
                                <MenuItem Header="{loc:Loc Main.LaunchEnterprise}" Command="{Binding LaunchEnterpriseCommand}" InputGestureText="{Binding HotkeyEnterprise}" Style="{DynamicResource ModernMenuItem}">
                                    <MenuItem.Icon><materialDesign:PackIcon Kind="Play" Width="16" Height="16" Foreground="#22C55E"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{loc:Loc Main.LaunchConfigurator}" Command="{Binding LaunchConfiguratorCommand}" InputGestureText="{Binding HotkeyConfigurator}" Style="{DynamicResource ModernMenuItem}">
                                    <MenuItem.Icon><materialDesign:PackIcon Kind="Cog" Width="16" Height="16" Foreground="#3B82F6"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{loc:Loc Main.EditSettings}" Command="{Binding EditInfobaseCommand}" InputGestureText="{Binding HotkeyEdit}" Style="{DynamicResource ModernMenuItem}">
                                    <MenuItem.Icon><materialDesign:PackIcon Kind="Pencil" Width="16" Height="16" Foreground="#3B82F6"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{loc:Loc Main.RefreshConfigInfo}" Command="{Binding RefreshConfigurationInfoCommand}" Style="{DynamicResource ModernMenuItem}">
                                    <MenuItem.Icon><materialDesign:PackIcon Kind="CloudDownload" Width="16" Height="16" Foreground="#14B8A6"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{loc:Loc Main.RegisterComConnector}" Command="{Binding RegisterComConnectorCommand}" Style="{DynamicResource ModernMenuItem}">
                                    <MenuItem.Icon><materialDesign:PackIcon Kind="Key" Width="16" Height="16" Foreground="#14B8A6"/></MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="{loc:Loc Main.ToFavorites}" Command="{Binding ToggleFavoriteCommand}" InputGestureText="{Binding HotkeyFavorite}" Style="{DynamicResource ModernMenuItem}">
                                    <MenuItem.Icon><materialDesign:PackIcon Kind="Star" Width="16" Height="16" Foreground="#FBBF24"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{loc:Loc Main.Pin}" Command="{Binding TogglePinCommand}" InputGestureText="{Binding HotkeyPin}" Style="{DynamicResource ModernMenuItem}">
                                    <MenuItem.Icon><materialDesign:PackIcon Kind="Pin" Width="16" Height="16" Foreground="#8B5CF6"/></MenuItem.Icon>
                                </MenuItem>
                                <!-- «Очистить кеш» по аналогии со split-кнопкой правой панели:
                                     сам пункт открывает окно очистки кеша, а стрелка справа —
                                     выпадающее меню с выбором типа кеша. -->
                                <MenuItem Style="{DynamicResource ModernMenuItem}" InputGestureText="{Binding HotkeyClearCache}">
                                    <MenuItem.Icon>
                                        <materialDesign:PackIcon Kind="Broom" Width="16" Height="16" Foreground="#14B8A6"/>
                                    </MenuItem.Icon>
                                    <MenuItem.Header>
                                        <Button Click="OnClearCacheSplitClick" Cursor="Hand"
                                                Background="Transparent" BorderThickness="0" Padding="0" Focusable="False"
                                                HorizontalContentAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Loc Main.ClearCache}" VerticalAlignment="Center"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}}"/>
                                        </Button>
                                    </MenuItem.Header>
                                    <MenuItem Header="{loc:Loc Main.ClearProgramCache}" Command="{Binding ClearProgramCacheCommand}" Style="{DynamicResource ModernMenuItem}"/>
                                    <MenuItem Header="{loc:Loc Main.ClearUserCache}" Command="{Binding ClearUserCacheCommand}" Style="{DynamicResource ModernMenuItem}"/>
                                    <Separator/>
                                    <MenuItem Header="{loc:Loc Main.ClearCacheBoth}" Command="{Binding ClearCacheBothCommand}" Style="{DynamicResource ModernMenuItem}"/>
                                </MenuItem>
                                <MenuItem Header="{loc:Loc Main.CopyConnectionString}" Command="{Binding CopyConnectionStringCommand}" Style="{DynamicResource ModernMenuItem}">
                                    <MenuItem.Icon><materialDesign:PackIcon Kind="ContentCopy" Width="16" Height="16" Foreground="#06B6D4"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{loc:Loc Main.OpenCatalog}" Command="{Binding OpenInfobaseFolderCommand}" Style="{DynamicResource ModernMenuItem}">
                                    <MenuItem.Icon><materialDesign:PackIcon Kind="FolderOpen" Width="16" Height="16" Foreground="#0EA5E9"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{loc:Loc Main.DesktopShortcut}" Command="{Binding CreateDesktopShortcutCommand}" Style="{DynamicResource ModernMenuItem}">
                                    <MenuItem.Icon><materialDesign:PackIcon Kind="DesktopClassic" Width="16" Height="16" Foreground="#6366F1"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{loc:Loc Main.AddBase}" Command="{Binding AddInfobaseCommand}" InputGestureText="{Binding HotkeyAdd}" Style="{DynamicResource ModernMenuItem}">
                                    <MenuItem.Icon><materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Foreground="#22C55E"/></MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="{loc:Loc Main.DumpToDt}" Command="{Binding DumpInfobaseDtCommand}" Style="{DynamicResource ModernMenuItem}">
                                    <MenuItem.Icon><materialDesign:PackIcon Kind="DatabaseExport" Width="16" Height="16" Foreground="#0EA5E9"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{loc:Loc Main.DumpConfigToCf}" Command="{Binding DumpConfigurationCfCommand}" Style="{DynamicResource ModernMenuItem}">
                                    <MenuItem.Icon><materialDesign:PackIcon Kind="FileExport" Width="16" Height="16" Foreground="#3B82F6"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{loc:Loc Main.LaunchHistory}" Command="{Binding ShowLaunchHistoryCommand}" Style="{DynamicResource ModernMenuItem}">
                                    <MenuItem.Icon><materialDesign:PackIcon Kind="History" Width="16" Height="16" Foreground="#8B5CF6"/></MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="{loc:Loc Main.Delete}" Command="{Binding DeleteInfobaseCommand}" InputGestureText="{Binding HotkeyDelete}" Style="{DynamicResource ModernMenuItem}">
                                    <MenuItem.Icon><materialDesign:PackIcon Kind="Delete" Width="16" Height="16" Foreground="#EF4444"/></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </controls:LeveledTreeView.ContextMenu>
                        </controls:LeveledTreeView>
                    
                </Grid>
                </Grid>
            </Border>

            <!-- ============ Правая панель: сведения и действия ============ -->
            <Border x:Name="RightPanelBorder" Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="0"
                    HorizontalAlignment="Left">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Width" Value="320"/>
                        <Setter Property="MinWidth" Value="280"/>
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        <Style.Triggers>
                            <!-- Компактный режим: ширина по самой длинной подписи кнопки, без лишнего зазора.
                                 MaxWidth убран почти полностью, чтобы панель максимально сжималась по ширине
                                 длин названий команд и выпадающих меню. -->
                            <DataTrigger Binding="{Binding ShowRightPanelDetails}" Value="False">
                                <Setter Property="Width" Value="Auto"/>
                                <Setter Property="MinWidth" Value="0"/>
                                <Setter Property="MaxWidth" Value="200"/>
                                <Setter Property="HorizontalAlignment" Value="Left"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <!-- Верхняя составляющая Padding (56) выравнивает верхний край блока
                                 действий запуска («1С Предприятие»/«Конфигуратор») с верхним краем
                                 панели команд CommandPanelBorder над списком баз. Значение ≈ высоте
                                 строки TopBarBorder (поиск/вкладки) вместе с верхним отступом левой
                                 колонки; окно теперь имеет отдельную строку-заголовок, поэтому
                                 кнопки окна больше не накладываются на основную область. -->
                            <Setter Property="Padding" Value="12,56"/>
                            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowRightPanelDetails}" Value="False">
                                    <Setter Property="Padding" Value="2,56,4,6"/>
                                    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel HorizontalAlignment="Stretch">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowRightPanelDetails}" Value="False">
                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <!-- Подробности о базе (скрываются в компактном режиме) -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedInfobase}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ShowRightPanelDetails}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <materialDesign:PackIcon Kind="Database" Width="28" Height="28"
                                                         Foreground="{DynamicResource AccentBrush}"
                                                         Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedInfobase.Name}" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0}: {1}">
                                                <Binding Source="{x:Static loc:LocalizationManager.Instance}" Path="Source"
                                                         Converter="{x:Static loc:LocalizationValueConverter.Instance}" ConverterParameter="Main.GroupLabel"/>
                                                <Binding Path="SelectedInfobase.GroupDisplay"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>

                            <WrapPanel Margin="0,0,0,12">
                                <Border Background="#FEF3C7" CornerRadius="8" Padding="8,3" Margin="0,0,6,4"
                                        Visibility="{Binding SelectedInfobase.IsFavorite, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Star" Width="12" Height="12" Foreground="#F59E0B" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource FavoriteBrush}">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} {1}">
                                                    <Binding Source="{x:Static loc:LocalizationManager.Instance}" Path="Source"
                                                             Converter="{x:Static loc:LocalizationValueConverter.Instance}" ConverterParameter="Main.Favorites"/>
                                                    <Binding Path="SelectedInfobase.FavoriteHotkeyDisplay"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Background="#EDE9FE" CornerRadius="8" Padding="8,3" Margin="0,0,6,4"
                                        Visibility="{Binding SelectedInfobase.IsPinned, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Pin" Width="12" Height="12" Foreground="#8B5CF6" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{loc:Loc Main.PinnedLabel}" FontSize="11" Foreground="#5B21B6"/>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <!-- Основное -->
                            <TextBlock Text="{loc:Loc Main.SectionConnInfo}" FontWeight="SemiBold" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"
                                       Typography.Capitals="AllSmallCaps"/>
                            <Border Background="{DynamicResource ContentBackgroundBrush}" CornerRadius="12"
                                    BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1"
                                    Padding="12,10" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Main.Type}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedInfobase.ConnectionTypeDisplay}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Main.ServerPath}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedInfobase.ConnectionPathDisplay}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Column.ServerBase}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedInfobase.ServerDatabaseDisplay}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc Main.ConnectionString}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedInfobase.ConnectionStringDisplay}" FontSize="11" FontWeight="SemiBold"  TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Loc Main.Platform}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedInfobase.PlatformVersion}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="{loc:Loc Main.LaunchMode}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedInfobase.ParsedLaunchMode}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="{loc:Loc Main.Client}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedInfobase.ClientTypeDisplay}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="{loc:Loc Main.Bitness}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding SelectedInfobase.ArchitectureDisplay}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="{loc:Loc Main.Parameters}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding SelectedInfobase.LaunchParameters}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="9" Grid.Column="0" Text="{loc:Loc Main.LastLaunch}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding SelectedInfobase.LastLaunchDisplay}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="10" Grid.Column="0" Text="{loc:Loc Main.CacheSize}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding SelectedInfobase.CacheSizeDisplay}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                </Grid>
                            </Border>
                            <TextBlock Text="{loc:Loc Main.Description}" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding SelectedInfobase.Description}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Path Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"
                                      Data="{StaticResource IconTag}" Fill="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{loc:Loc Main.Tags}" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding SelectedInfobase.Tags}" Margin="0,0,0,12">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource ItemHoverBrush}" CornerRadius="8" Padding="8,3" Margin="0,0,4,4"
                                                BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"
                                                      Data="{StaticResource IconTag}" Fill="{DynamicResource AccentBrush}"/>
                                                <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Когда база не выбрана — группа или подсказка (только в полном режиме) -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding SelectedInfobase}" Value="{x:Null}"/>
                                                <Condition Binding="{Binding ShowRightPanelDetails}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Path Width="28" Height="28" Stretch="Uniform" Margin="0,0,10,0"
                                      VerticalAlignment="Center"
                                      Fill="{Binding SelectedGroupNode.IconBrush}"
                                      Data="{Binding SelectedGroupNode.Icon, Converter={StaticResource IconKeyToGeometryConverter}}"/>
                                <StackPanel>
                                    <TextBlock FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextPrimaryBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding SelectedGroupNode.DisplayName}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedGroupNode.DisplayName}" Value="{x:Null}">
                                                        <Setter Property="Text" Value="{loc:Loc Main.NoSelection}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding SelectedGroupNode.FullPath}" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="{loc:Loc Main.NoSelectionHint}"
                                       FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource BorderBrushColor}" Margin="0,4,0,12"
                                Visibility="{Binding ShowRightPanelDetails, Converter={StaticResource BoolToVis}}"/>

                        <!-- Действия -->
                        <TextBlock Text="{loc:Loc Main.Actions}" FontWeight="SemiBold" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,10"
                                   Visibility="{Binding ShowRightPanelDetails, Converter={StaticResource BoolToVis}}"/>

                        <!-- Split-кнопки запуска: единый блок «действие | ▼» -->
                        <Border Margin="4,0,4,4" CornerRadius="10"
                                Background="{DynamicResource AccentBrush}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Margin" Value="4,0,4,4"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowRightPanelDetails}" Value="False">
                                            <Setter Property="Margin" Value="0,0,0,4"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Command="{Binding LaunchEnterpriseCommand}"
                                        Cursor="Hand" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch"
                                        Background="Transparent" BorderThickness="0" Padding="8,8,4,8" MinHeight="34">
                                    <Button.ToolTip>
                                        <MultiBinding Converter="{StaticResource MultiFormat}" ConverterParameter="{}{0} ({1})">
                                            <Binding Source="{x:Static loc:LocalizationManager.Instance}" Path="Source"
                                                     Converter="{x:Static loc:LocalizationValueConverter.Instance}" ConverterParameter="Main.LaunchEnterpriseShort"/>
                                            <Binding Path="HotkeyEnterprise"/>
                                        </MultiBinding>
                                    </Button.ToolTip>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#22FFFFFF"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Play" Width="16" Height="16" Margin="0,0,6,0"
                                                                 Foreground="White" VerticalAlignment="Center"/>
                                        <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="White"
                                                   Text="{loc:Loc Main.Enterprise}" TextTrimming="None"
                                                   LineHeight="20" LineStackingStrategy="BlockLineHeight"
                                                   Padding="0,1,0,2"/>
                                    </StackPanel>
                                </Button>
                                <Border Grid.Column="1" Width="1" Background="#55FFFFFF" Margin="0,8"/>
                                <Button Grid.Column="2" x:Name="EnterpriseMenuButton" Width="28" MinWidth="28" Cursor="Hand"
                                        Click="OnEnterpriseMenuClick" ToolTip="{loc:Loc Main.MoreLaunchOptions}"
                                        Background="Transparent" BorderThickness="0" Padding="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="Transparent">
                                                <materialDesign:PackIcon Kind="ChevronDown" Width="16" Height="16"
                                                                         Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#22FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Button.ContextMenu>
                                        <ContextMenu Style="{DynamicResource ModernContextMenu}">
                                            <MenuItem Header="{loc:Loc Main.LaunchWithParams}" Command="{Binding LaunchEnterpriseWithParamsCommand}"
                                                      Style="{DynamicResource ModernMenuItem}">
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="Tune" Width="18" Height="18" Foreground="#0EA5E9"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="{loc:Loc Main.LaunchWithAuth}" Command="{Binding LaunchEnterpriseWithAuthCommand}"
                                                      Style="{DynamicResource ModernMenuItem}">
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="AccountKey" Width="18" Height="18" Foreground="#8B5CF6"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator/>
                                            <MenuItem Header="{loc:Loc Main.LaunchAsAdmin}" Command="{Binding LaunchEnterpriseAsAdminCommand}"
                                                      Style="{DynamicResource ModernMenuItem}">
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="ShieldAccount" Width="18" Height="18" Foreground="#F59E0B"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </Grid>
                        </Border>

                        <Border Margin="4,0,4,4" CornerRadius="10"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Margin" Value="4,0,4,4"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowRightPanelDetails}" Value="False">
                                            <Setter Property="Margin" Value="0,0,0,4"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Command="{Binding LaunchConfiguratorCommand}"
                                        Cursor="Hand" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch"
                                        Background="Transparent" BorderThickness="0" Padding="8,8,4,8" MinHeight="34">
                                    <Button.ToolTip>
                                        <MultiBinding Converter="{StaticResource MultiFormat}" ConverterParameter="{}{0} ({1})">
                                            <Binding Source="{x:Static loc:LocalizationManager.Instance}" Path="Source"
                                                     Converter="{x:Static loc:LocalizationValueConverter.Instance}" ConverterParameter="Main.LaunchConfiguratorShort"/>
                                            <Binding Path="HotkeyConfigurator"/>
                                        </MultiBinding>
                                    </Button.ToolTip>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Wrench" Width="16" Height="16" Margin="0,0,6,0"
                                                                 Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" Text="{loc:Loc Main.SectionConfigurator}"
                                                   TextTrimming="None"
                                                   LineHeight="20" LineStackingStrategy="BlockLineHeight"
                                                   Padding="0,1,0,2"/>
                                    </StackPanel>
                                </Button>
                                <Border Grid.Column="1" Width="1" Background="{DynamicResource BorderBrushColor}" Margin="0,8"/>
                                <Button Grid.Column="2" x:Name="ConfiguratorMenuButton" Width="28" MinWidth="28" Cursor="Hand"
                                        Click="OnConfiguratorMenuClick" ToolTip="{loc:Loc Main.MoreLaunchOptions}"
                                        Background="Transparent" BorderThickness="0" Padding="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="Transparent">
                                                <materialDesign:PackIcon Kind="ChevronDown" Width="16" Height="16"
                                                                         Foreground="{DynamicResource TextSecondaryBrush}"
                                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Button.ContextMenu>
                                        <ContextMenu Style="{DynamicResource ModernContextMenu}">
                                            <MenuItem Header="{loc:Loc Main.LaunchWithParams}" Command="{Binding LaunchConfiguratorWithParamsCommand}"
                                                      Style="{DynamicResource ModernMenuItem}">
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="Tune" Width="18" Height="18" Foreground="#0EA5E9"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator/>
                                            <MenuItem Header="{loc:Loc Main.LaunchAsAdmin}" Command="{Binding LaunchConfiguratorAsAdminCommand}"
                                                      Style="{DynamicResource ModernMenuItem}">
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="ShieldAccount" Width="18" Height="18" Foreground="#F59E0B"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Родной стартер 1С (1CEStart.exe) для сверки списка -->
                        <Button Command="{Binding LaunchNativeStarterCommand}"
                                ToolTip="{loc:Loc Main.NativeStarterTooltip}"
                                HorizontalContentAlignment="Left">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ActionPanelSecondaryButton}">
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="Margin" Value="4,0,4,4"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowRightPanelDetails}" Value="False">
                                            <Setter Property="Padding" Value="6,8"/>
                                            <Setter Property="Margin" Value="0,0,0,4"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <materialDesign:PackIcon Kind="Application" Width="15" Height="15" Margin="0,0,6,0"
                                                         Foreground="#F59E0B" VerticalAlignment="Center"/>
                                <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ButtonTextBrush}"
                                           Text="{loc:Loc Main.NativeStarter}" TextTrimming="None"/>
                            </StackPanel>
                        </Button>

                        <!-- Отступ между запуском (1С / Конфигуратор) и остальными действиями -->
                        <Border Height="1" Background="{DynamicResource BorderBrushColor}"
                                Margin="8,10,8,10" Opacity="0.7"/>

                        <!-- Текущая сессия: в полном и компактном режиме; видимость — из настроек -->
                        <Border CornerRadius="8"
                                Background="{DynamicResource ItemHoverBrush}"
                                BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1"
                                Visibility="{Binding ShowSessionLaunchPanel, Converter={StaticResource BoolToVis}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Margin" Value="8,0,8,10"/>
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowRightPanelDetails}" Value="False">
                                            <Setter Property="Margin" Value="4,0,4,6"/>
                                            <Setter Property="Padding" Value="6,6"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{loc:Loc Main.CurrentSession}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontSize" Value="12"/>
                                                <Setter Property="Margin" Value="0,0,0,6"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.ShowRightPanelDetails, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                        <Setter Property="FontSize" Value="11"/>
                                                        <Setter Property="Margin" Value="0,0,0,4"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <controls:HelpLink Margin="6,0,0,4"
                                                       HelpText="{loc:Loc Main.CurrentSessionHelp}"/>
                                </StackPanel>
                                <TextBlock Text="{loc:Loc Main.SessionOnceHint}"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Visibility="{Binding ShowRightPanelDetails, Converter={StaticResource BoolToVis}}"/>

                                <TextBlock Text="{loc:Loc Main.ClientMode}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"
                                           Visibility="{Binding ShowRightPanelDetails, Converter={StaticResource BoolToVis}}"/>
                                <StackPanel Margin="0,0,0,8">
                                    <RadioButton Content="{loc:Loc Main.SessionClientAuto}" GroupName="SessionClient"
                                                 IsChecked="{Binding IsSessionClientAuto, Mode=TwoWay}"
                                                 Margin="0,2" Cursor="Hand" FontSize="12"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <RadioButton Content="{loc:Loc Main.SessionClientOrdinary}" GroupName="SessionClient"
                                                 IsChecked="{Binding IsSessionClientOrdinary, Mode=TwoWay}"
                                                 Margin="0,2" Cursor="Hand" FontSize="12"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <RadioButton Content="{loc:Loc Main.SessionClientThickManaged}" GroupName="SessionClient"
                                                 IsChecked="{Binding IsSessionClientThick, Mode=TwoWay}"
                                                 Margin="0,2" Cursor="Hand" FontSize="12"
                                                 ToolTip="{loc:Loc Main.SessionThickManagedTooltip}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <RadioButton Content="{loc:Loc Main.SessionClientThickOrdinary}" GroupName="SessionClient"
                                                 IsChecked="{Binding IsSessionClientThickOrdinary, Mode=TwoWay}"
                                                 Margin="0,2" Cursor="Hand" FontSize="12"
                                                 ToolTip="{loc:Loc Main.SessionThickOrdinaryTooltip}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <RadioButton Content="{loc:Loc Main.SessionClientThin}" GroupName="SessionClient"
                                                 IsChecked="{Binding IsSessionClientThin, Mode=TwoWay}"
                                                 Margin="0,2" Cursor="Hand" FontSize="12"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>

                                <TextBlock Text="{loc:Loc Main.Bitness}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"
                                           Visibility="{Binding ShowRightPanelDetails, Converter={StaticResource BoolToVis}}"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="{loc:Loc Main.SessionClientAuto}" GroupName="SessionArch"
                                                 IsChecked="{Binding IsSessionArchAuto, Mode=TwoWay}"
                                                 Margin="0,2,10,2" Cursor="Hand" FontSize="12"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <RadioButton Content="32" GroupName="SessionArch"
                                                 IsChecked="{Binding IsSessionArch32, Mode=TwoWay}"
                                                 Margin="0,2,10,2" Cursor="Hand" FontSize="12"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <RadioButton Content="64" GroupName="SessionArch"
                                                 IsChecked="{Binding IsSessionArch64, Mode=TwoWay}"
                                                 Margin="0,2,0,2" Cursor="Hand" FontSize="12"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Отдельная кнопка «Перейти по ссылке» (аналог стандартного загрузчика 1С) -->
                        <Border Height="1" Background="{DynamicResource BorderBrushColor}"
                                Visibility="{Binding ShowSessionLaunchPanel, Converter={StaticResource BoolToVis}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Margin" Value="8,6,8,10"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowRightPanelDetails}" Value="False">
                                            <Setter Property="Margin" Value="4,8,4,8"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>

                        <Button Command="{Binding OpenInfobaseByLinkCommand}"
                                ToolTip="{loc:Loc Main.OpenLinkTooltip}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ActionPanelSecondaryButton}">
                                    <Setter Property="Padding" Value="14,11"/>
                                    <Setter Property="Margin" Value="8,0,8,0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowRightPanelDetails}" Value="False">
                                            <Setter Property="Padding" Value="6,8"/>
                                            <Setter Property="Margin" Value="0,0,0,0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <materialDesign:PackIcon Kind="Link" Width="16" Height="16" Margin="0,0,4,0"
                                                             Foreground="#0EA5E9" VerticalAlignment="Center"/>
                                    <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ButtonTextBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{loc:Loc LinkInput.Title}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.ShowRightPanelDetails, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                        <Setter Property="Text" Value="{loc:Loc Main.OpenByLinkShort}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="➜"
                                           VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11"
                                           Foreground="{DynamicResource ButtonTextBrush}" Opacity="0.75"
                                           Margin="8,0,0,0"
                                           Visibility="{Binding ShowRightPanelDetails, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </Button>

                        <!-- Разделитель и кнопка «Выход»: всегда полностью закрывает приложение,
                             игнорируя настройку «Закрывать в трей». Виден и в компактной панели. -->
                        <Border Height="1" Background="{DynamicResource BorderBrushColor}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Margin" Value="8,10,8,10"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowRightPanelDetails}" Value="False">
                                            <Setter Property="Margin" Value="4,8,4,8"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>

                        <Button Click="OnExitApplicationClick"
                                ToolTip="{loc:Loc Main.ExitTooltip}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ActionPanelSecondaryButton}">
                                    <Setter Property="Padding" Value="14,11"/>
                                    <Setter Property="Margin" Value="8,0,8,0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowRightPanelDetails}" Value="False">
                                            <Setter Property="Padding" Value="6,8"/>
                                            <Setter Property="Margin" Value="0,0,0,0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <materialDesign:PackIcon Kind="ExitToApp" Width="16" Height="16" Foreground="#DC2626" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Loc Main.Exit}" VerticalAlignment="Center" Foreground="#DC2626" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="✕"
                                           VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11"
                                           Foreground="#DC2626" Opacity="0.85" Margin="8,0,0,0"
                                           Visibility="{Binding ShowRightPanelDetails, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

        </Grid>

        <!-- ===================== Строка состояния ============ -->
        <Border x:Name="StatusBarBorder" Grid.Row="2" Background="{DynamicResource SidebarBrush}" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusBarInfo}"
                           Foreground="{DynamicResource TextOnAccentBrush}" FontSize="12"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           ToolTip="{Binding StatusBarInfo}">
                    <TextBlock.ContextMenu>
                        <ContextMenu Style="{DynamicResource ModernContextMenu}">
                            <MenuItem Header="{loc:Loc Main.CopyPath}"
                                      Command="{Binding CopyConnectionStringCommand}"
                                      Style="{DynamicResource ModernMenuItem}">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="ContentCopy" Width="16" Height="16" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </TextBlock.ContextMenu>
                </TextBlock>
                <TextBlock Grid.Column="1" Text="{Binding SyncMessage}"
                           Foreground="{DynamicResource TextOnAccentBrush}" FontSize="12"
                           VerticalAlignment="Center" Margin="16,0,8,0"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{loc:Loc Main.SyncResultTooltip}"/>
                <Button Grid.Column="2" Command="{Binding ToggleSessionLaunchPanelCommand}"
                        Style="{DynamicResource StatusBarIconButton}"
                        Margin="4,0,0,0"
                        ToolTip="{loc:Loc Main.CurrentSession}"
                        VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="ClockOutline" Width="18" Height="18"
                                             Foreground="{DynamicResource TextOnAccentBrush}"/>
                </Button>
                <Button Grid.Column="3" Command="{Binding ToggleRightPanelDetailsCommand}"
                        Style="{DynamicResource StatusBarIconButton}"
                        Margin="4,0,0,0"
                        ToolTip="{Binding RightPanelToggleTooltip}"
                        VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="PageLayoutSidebarRight" Width="18" Height="18"
                                             Foreground="{DynamicResource TextOnAccentBrush}"/>
                </Button>
            </Grid>
        </Border>

        <!-- ===================== Индикатор фоновой загрузки при запуске ============ -->
        <Grid Grid.RowSpan="100" Panel.ZIndex="1000"
              Background="#99000000"
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    CornerRadius="10" Padding="32,26"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="320" MaxWidth="520">
                <StackPanel>
                    <TextBlock Text="{Binding LoadingMessage}"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,16" TextWrapping="Wrap"
                               HorizontalAlignment="Center"/>
                    <ProgressBar IsIndeterminate="True" Height="6"
                                 Foreground="{DynamicResource AccentBrush}"
                                 Background="#22000000"/>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>
