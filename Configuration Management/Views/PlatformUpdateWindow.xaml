<Window x:Class="Configuration_Management.PlatformUpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:loc="clr-namespace:Configuration_Management.Localization"
        Title="{loc:Loc PlatformUpdate.WindowTitle}"
        Icon="{StaticResource AppIcon}"
        Width="920" Height="660"
        MinHeight="520" MinWidth="740"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI"
        FontSize="13"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#16A34A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="14,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#15803D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#166534"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="14,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="15" FontWeight="SemiBold" Text="{loc:Loc PlatformUpdate.WindowTitle}"/>

        <!-- Таблица версий платформы: Версия / Размер / Статус / Совместимые базы -->
        <Border Grid.Row="1" Margin="0,12,0,0"
                BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1"
                CornerRadius="6" Background="{DynamicResource CardBackgroundBrush}">
            <DataGrid x:Name="RowsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserSortColumns="False" RowHeaderWidth="0" SelectionMode="Single"
                      SelectionChanged="OnRowsGrid_SelectionChanged"
                      BorderThickness="0" Background="Transparent" GridLinesVisibility="None"
                      RowHeight="40" AlternationCount="2">
                <DataGrid.Resources>
                    <Style x:Key="CenteredCellText" TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Margin" Value="8,0,8,0"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        <Style.Triggers>
                            <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                                <Setter Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ItemSelectedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ItemSelectedBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="1.4*" Header="{loc:Loc PlatformUpdate.Column.Version}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Version}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Margin="8,0,8,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Width="*" Header="{loc:Loc PlatformUpdate.Column.Size}"
                                        Binding="{Binding SizeText}"
                                        ElementStyle="{StaticResource CenteredCellText}"/>

                    <DataGridTextColumn Width="*" Header="{loc:Loc PlatformUpdate.Column.Status}"
                                        Binding="{Binding StatusText}"
                                        ElementStyle="{StaticResource CenteredCellText}"/>

                    <DataGridTextColumn Width="90" Header="{loc:Loc PlatformUpdate.Column.Bases}"
                                        Binding="{Binding CompatibleBases}"
                                        ElementStyle="{StaticResource CenteredCellText}"/>

                    <!-- Индикатор загрузки строки (виден только при активной загрузке) -->
                    <DataGridTemplateColumn Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ProgressBar Height="4" Maximum="1" Minimum="0" Value="{Binding Progress}"
                                             Foreground="{DynamicResource AccentBrush}">
                                    <ProgressBar.Style>
                                        <Style TargetType="ProgressBar">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ProgressBar.Style>
                                </ProgressBar>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Панель прогресса и журнала. Видимостью управляет code-behind с
             анти-миганием (issue #334): показ при старте операции, скрытие —
             с задержкой, чтобы панель не «мелькала» при мгновенном сбое. -->
        <Border x:Name="StatusPanel" Grid.Row="2" Margin="0,12,0,0"
                Visibility="Collapsed"
                BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1"
                CornerRadius="6" Background="{DynamicResource CardBackgroundBrush}">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <ProgressBar Grid.Row="0" Height="6" Maximum="1" Minimum="0"
                             Value="{Binding Progress}"
                             Foreground="{DynamicResource AccentBrush}"/>

                <TextBox x:Name="LogBox" Grid.Row="1" Margin="0,8,0,0"
                         Height="120" FontFamily="Consolas" FontSize="11"
                         IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Text="{Binding LogText, Mode=OneWay}"
                         Background="{DynamicResource CardBackgroundBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource BorderBrushColor}"/>
            </Grid>
        </Border>

        <!-- Нижняя панель (issue #334): две строки кнопок. Первая строка — «Проверить
             обновления», «Учётки», «Открыть в браузере»; вторая — операции с версиями.
             Кнопка «Закрыть» убрана: есть кнопка закрытия окна и ESC. Кнопка «Выбрать
             файл установщика» удалена как лишняя (issue #334). -->
        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal">
                <!-- Первая строка: главная команда + действия при проблемах авторизации
                     (issue #323/#330/#334): справочник учётных данных ИТС, login.1c.ru. -->
                <Button Height="36" Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding CheckCommand}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Foreground="White"/>
                        <TextBlock Text="{loc:Loc PlatformUpdate.Check}" Margin="6,0,0,0"
                                   VerticalAlignment="Center" Foreground="White"/>
                    </StackPanel>
                </Button>

                <Button Height="36" Margin="8,0,0,0" Style="{StaticResource OutlineButtonStyle}"
                        Click="OnItsAccountsClick">
                    <TextBlock Text="{loc:Loc Updates.OpenItsAccounts}" VerticalAlignment="Center"/>
                </Button>

                <Button Height="36" Margin="8,0,0,0" Style="{StaticResource OutlineButtonStyle}"
                        Click="OnOpenLoginClick">
                    <TextBlock Text="{loc:Loc Updates.OpenLoginPage}" VerticalAlignment="Center"/>
                </Button>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <!-- Вторая строка: операции с версиями. -->
                <Button Height="36" Style="{StaticResource OutlineButtonStyle}"
                        Command="{Binding DownloadAndInstallCommand}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="DownloadOutline" Width="16" Height="16"
                                                 Foreground="#16A34A"/>
                        <TextBlock Text="{loc:Loc PlatformUpdate.DownloadInstall}" Margin="6,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Height="36" Margin="8,0,0,0" Style="{StaticResource OutlineButtonStyle}"
                        Command="{Binding DownloadOnlyCommand}">
                    <TextBlock Text="{loc:Loc PlatformUpdate.DownloadOnly}" VerticalAlignment="Center"/>
                </Button>

                <Button Height="36" Margin="8,0,0,0" Style="{StaticResource OutlineButtonStyle}"
                        Command="{Binding RemoveOldVersionsCommand}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="DeleteOutline" Width="16" Height="16"
                                                 Foreground="#DC2626"/>
                        <TextBlock Text="{loc:Loc PlatformUpdate.RemoveOld}" Margin="6,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>