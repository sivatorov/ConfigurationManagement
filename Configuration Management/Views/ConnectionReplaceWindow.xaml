<!-- Окно «Заменить в строках подключения…» (0.3.9.190, Windows/WPF): массовая замена
     в строке подключения баз по правилу «найти → заменить на» (поле/область/режим/регистр).
     Вся логика — в чистой ConnectionReplaceViewModel; окно — тонкая обёртка: поля и
     ComboBox'ы привязаны к VM (Fields/Scopes/Modes — готовые списки с локализованными
     текстами), предпросмотр «База | Поле | Было | Станет» с подсветкой изменённых строк
     (колонка «Станет» — зелёный фон), подтверждение перед применением через IDialogService.
     Ключи локализации ConnectionReplace.* (см. план функции 6, этап 0.3.9.190). -->
<Window x:Class="Configuration_Management.ConnectionReplaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Configuration_Management.Localization"
        xmlns:app="clr-namespace:Configuration_Management"
        Icon="{StaticResource AppIcon}"
        Height="620" Width="1060" MinHeight="440" MinWidth="860"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- Вертикальное выравнивание содержимого ячеек по центру (как в соседних окнах). -->
        <Style x:Key="CenteredCellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>

        <Style x:Key="CenteredColumnHeader" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>

        <!-- Локализация имени поля ConnectionField в колонке «Поле» предпросмотра. -->
        <app:ConnectionFieldToTextConverter x:Key="FieldToText"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Панель параметров, ДВЕ СТРОКИ (issue #357): на первой — только «Найти» и
             «Заменить на» (в неширокое окно все поля в одну строку не помещаются),
             на второй — Поле / Область / Режим / регистр + кнопка «Найти». -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                    <TextBlock Text="{loc:Loc ConnectionReplace.FindLabel}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Width="170" Style="{StaticResource ModernTextBox}" Padding="6,3"
                             Text="{Binding FindText, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:Loc ConnectionReplace.ReplaceLabel}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Width="170" Style="{StaticResource ModernTextBox}" Padding="6,3"
                             Text="{Binding ReplaceText, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                    <TextBlock Text="{loc:Loc ConnectionReplace.FieldLabel}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Width="190" Style="{StaticResource ModernComboBox}"
                              ItemsSource="{Binding Fields}" SelectedValuePath="Value"
                              SelectedValue="{Binding SelectedField}"
                              VerticalContentAlignment="Center" Padding="6,2">
                        <!-- Issue #357: явный шаблон для элементов списка И выбранного
                             значения (закрытая часть рендерится тем же шаблоном, что и
                             выпадающий список) — всегда локализованный текст, не ключ. -->
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayText}" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                    <TextBlock Text="{loc:Loc ConnectionReplace.ScopeLabel}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Width="160" Style="{StaticResource ModernComboBox}"
                              ItemsSource="{Binding Scopes}" SelectedValuePath="Value"
                              SelectedValue="{Binding SelectedScope}"
                              VerticalContentAlignment="Center" Padding="6,2">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayText}" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                    <TextBlock Text="{loc:Loc ConnectionReplace.ModeLabel}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Width="180" Style="{StaticResource ModernComboBox}"
                              ItemsSource="{Binding Modes}" SelectedValuePath="Value"
                              SelectedValue="{Binding SelectedMatchMode}"
                              VerticalContentAlignment="Center" Padding="6,2">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayText}" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <CheckBox Content="{loc:Loc ConnectionReplace.IgnoreCase}" VerticalAlignment="Center"
                          IsChecked="{Binding IgnoreCase}" Margin="0,0,14,0"/>
                <Button x:Name="FindButton" Style="{StaticResource ModernButton}"
                        Background="{DynamicResource ItemHoverBrush}" Padding="14,5"
                        Command="{Binding RefreshPreviewCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔍" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc ConnectionReplace.FindButton}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>

        <!-- Предпросмотр «База | Поле | Было | Станет»; «Станет» подсвечивается зелёным при Changed. -->
        <DataGrid x:Name="PreviewGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False"
                  ColumnHeaderStyle="{StaticResource CenteredColumnHeader}"
                  SelectionMode="Single" SelectionUnit="FullRow" GridLinesVisibility="Horizontal"
                  RowHeight="38" AlternatingRowBackground="{DynamicResource CardBackgroundBrush}"
                  Background="{DynamicResource CardBackgroundBrush}"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Width="1.3*" Header="{loc:Loc ConnectionReplace.Columns.Base}"
                                    Binding="{Binding Infobase.Name}" ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTemplateColumn Width="1.2*" Header="{loc:Loc ConnectionReplace.Columns.Field}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Field, Converter={StaticResource FieldToText}}"
                                       Style="{StaticResource CenteredCellText}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Width="1.6*" Header="{loc:Loc ConnectionReplace.Columns.Before}"
                                    Binding="{Binding BeforeText}" ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTemplateColumn Width="1.6*" Header="{loc:Loc ConnectionReplace.Columns.After}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Margin="2,2" CornerRadius="3">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Changed}" Value="True">
                                                <Setter Property="Background" Value="#2634D399"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding AfterText}" VerticalAlignment="Center"
                                           Margin="4,0" TextTrimming="CharacterEllipsis"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Сводка предпросмотра, результат применения/отката и сообщение об ошибке. -->
        <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <TextBlock Text="{Binding SummaryText}" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding ResultText}" FontSize="12" Opacity="0.85" Margin="0,2,0,0"/>
            <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="#DC2626"
                       TextWrapping="Wrap" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Действия: Заменить (с подтверждением), Отменить последнюю замену, Закрыть. -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="ApplyButton" Style="{StaticResource ModernButton}"
                    Background="#06B6D4" Foreground="White" Padding="16,5"
                    IsEnabled="{Binding CanApply}" Click="OnApply_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✓" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="White"/>
                    <TextBlock Text="{loc:Loc ConnectionReplace.ApplyButton}" VerticalAlignment="Center" Foreground="White"/>
                </StackPanel>
            </Button>
            <Button x:Name="UndoButton" Style="{StaticResource ModernButton}"
                    Background="{DynamicResource ItemHoverBrush}" Padding="12,5" Margin="8,0,0,0"
                    IsEnabled="{Binding CanUndo}" Command="{Binding UndoLastCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="↩" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc ConnectionReplace.UndoButton}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="CloseButton" Style="{StaticResource ModernButton}" IsCancel="True"
                    Background="{DynamicResource ItemHoverBrush}" Padding="12,5" Margin="8,0,0,0"
                    Foreground="{DynamicResource TextPrimaryBrush}" Click="OnClose_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✖" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc Common.Close}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>