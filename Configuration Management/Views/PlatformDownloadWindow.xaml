<Window x:Class="Configuration_Management.PlatformDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:loc="clr-namespace:Configuration_Management.Localization"
        xmlns:win="clr-namespace:Configuration_Management"
        xmlns:svc="clr-namespace:Configuration_Management.Services"
        Title="{loc:Loc PlatformDownload.WindowTitle}"
        Icon="{StaticResource AppIcon}"
        Width="980" Height="700"
        MinHeight="560" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI"
        FontSize="13"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <win:PlatformDownloadTypeToTextConverter x:Key="DownloadTypeConv"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#16A34A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="14,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#15803D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="10,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и описание -->
        <StackPanel Grid.Row="0">
            <TextBlock FontSize="15" FontWeight="SemiBold" Text="{loc:Loc PlatformDownload.WindowTitle}"/>
            <TextBlock FontSize="12" Margin="0,6,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" Text="{loc:Loc PlatformDownload.Description}"/>
        </StackPanel>

        <!-- Основная область: дерево версий слева + параметры справа (issue #330) -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <!-- issue #330: список версий — узкая колонка ~25% ширины окна -->
                <ColumnDefinition Width="2*" MinWidth="260"/>
                <ColumnDefinition Width="8*" MinWidth="360"/>
            </Grid.ColumnDefinitions>

            <!-- Список версий: дерево 8.x \ 8.x.yy \ полная версия, минимум 8 строк -->
            <Border Grid.Column="0" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1"
                    CornerRadius="6" Background="{DynamicResource CardBackgroundBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- issue #330 (комментарий 7OH): поиск по дереву + свернуть/развернуть все -->
                    <Grid Grid.Row="0" Margin="6,6,6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <TextBox MinHeight="28" VerticalContentAlignment="Center"
                                     Padding="6,0" FontSize="12"
                                     Text="{Binding VersionSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{loc:Loc PlatformDownload.SearchVersionsTooltip}"/>
                            <!-- Подложка-подсказка: видна, пока запрос пуст (поверх TextBox) -->
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" FontStyle="Italic"
                                       IsHitTestVisible="False" Text="{loc:Loc PlatformDownload.SearchVersions}"
                                       Foreground="{DynamicResource TextSecondaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding VersionSearchQuery}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Button Grid.Column="1" Margin="6,0,0,0" Content="{loc:Loc PlatformDownload.ExpandAll}"
                                Command="{Binding ExpandAllCommand}" Style="{StaticResource OutlineButtonStyle}"/>
                        <Button Grid.Column="2" Margin="6,0,0,0" Content="{loc:Loc PlatformDownload.CollapseAll}"
                                Command="{Binding CollapseAllCommand}" Style="{StaticResource OutlineButtonStyle}"/>
                    </Grid>

                    <TreeView x:Name="VersionsTree" Grid.Row="1" ItemsSource="{Binding VersionTree}"
                              BorderThickness="0" Background="Transparent"
                              Padding="4" ScrollViewer.VerticalScrollBarVisibility="Auto"
                              SelectedItemChanged="OnVersionsTree_SelectedItemChanged">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource ModernTreeViewItem}">
                                <!-- issue #330: состояние раскрытия в узле (IsExpanded) — им управляют
                                     команды «Развернуть/Свернуть все» и пользователь -->
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                <Setter Property="Padding" Value="2,1"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type svc:PlatformCatalogNode}"
                                                      ItemsSource="{Binding Children}">
                                <TextBlock Text="{Binding Name}" Margin="0,1" VerticalAlignment="Center"/>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>

            <!-- Параметры справа: разрядность, файл, учётная запись, папка, действия, прогресс -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14,0,0,0">

                    <!-- Разрядность -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:Loc PlatformDownload.Architecture}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <ComboBox Grid.Column="1" Width="160" Height="30" HorizontalAlignment="Left"
                                  VerticalContentAlignment="Center"
                                  SelectedValue="{Binding Is64Bit}" SelectedValuePath="Tag">
                            <ComboBoxItem Content="x64" Tag="True"/>
                            <ComboBoxItem Content="x86" Tag="False"/>
                        </ComboBox>
                    </Grid>

                    <!-- Файл дистрибутива (варианты для текущей ОС, issue #330) -->
                    <TextBlock Text="{loc:Loc PlatformDownload.File}" Margin="0,10,0,4"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <ComboBox Height="30" VerticalContentAlignment="Center"
                              ItemsSource="{Binding DistributionOptions}"
                              SelectedItem="{Binding SelectedDistribution, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName"/>
                    <!-- issue #330: реальное имя файла, который будет скачан (не только подсказка) -->
                    <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding PickedFile.FileName}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PickedFile}" Value="{x:Null}">
                                        <Setter Property="Text" Value="{loc:Loc PlatformDownload.NoFile}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Учётная запись -->
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:Loc PlatformDownload.Account}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{loc:Loc PlatformDownload.NoAccount}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasAccount}" Value="True">
                                            <Setter Property="Text" Value="{Binding AccountName}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Папка загрузки + кнопка «Выбрать…» -->
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:Loc PlatformDownload.Directory}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <!-- issue #330: кнопка «Выбрать…» не обрезается по вертикали —
                             выравнивание по центру, без жёсткой высоты у TextBox -->
                        <TextBox Grid.Column="1" Text="{Binding TargetDirectory, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="30" VerticalContentAlignment="Center" IsReadOnly="False"/>
                        <Button Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"
                                Content="{loc:Loc PlatformDownload.ChooseDirectory}"
                                Command="{Binding ChooseDirectoryCommand}" Style="{StaticResource OutlineButtonStyle}"/>
                    </Grid>

                    <!-- Действия после скачивания: только «Открыть папку» — дистрибутив
                         скачивается архивом, запускать установщик из окна не нужно
                         (issue #330, комментарий 7OH от 2026-10-08). -->
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="{loc:Loc PlatformDownload.OpenFolder}"
                                Command="{Binding OpenFolderCommand}" Style="{StaticResource PrimaryButtonStyle}"
                                MinWidth="130"/>
                    </StackPanel>

                    <!-- Прогресс -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar Grid.Column="0" Height="6" Minimum="0" Maximum="1" Value="{Binding Progress}"
                                     Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0:P0}">
                                    <Binding Path="Progress"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Нижняя панель: результат, журнал, кнопки -->
        <Border Grid.Row="2" Margin="0,12,0,0"
                BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1"
                CornerRadius="6" Background="{DynamicResource CardBackgroundBrush}">
            <StackPanel Margin="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Итоговое сообщение после скачивания -->
                    <TextBlock Grid.Column="0" Text="{Binding ResultText}" TextWrapping="Wrap" FontSize="12"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{loc:Loc PlatformDownload.Download}"
                                Command="{Binding DownloadCommand}" Style="{StaticResource PrimaryButtonStyle}"
                                MinWidth="130"/>
                    </StackPanel>
                </Grid>

                <TextBox x:Name="LogBox" Margin="0,10,0,0" IsReadOnly="True" Height="96"
                         Text="{Binding LogText, Mode=OneWay}" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"
                         Background="{DynamicResource ContentBackgroundBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"/>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Действия при проблемах авторизации (issue #323/#330/#334): открыть
                         login.1c.ru в браузере, справочник учётных данных ИТС. -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{loc:Loc Updates.OpenLoginPage}"
                                Click="OnOpenLoginClick" Style="{StaticResource OutlineButtonStyle}"
                                Padding="12,6"/>
                        <Button Content="{loc:Loc Updates.OpenItsAccounts}"
                                Click="OnItsAccountsClick" Style="{StaticResource OutlineButtonStyle}"
                                Margin="8,0,0,0" Padding="12,6"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="{loc:Loc PlatformDownload.RefreshCatalog}"
                            Command="{Binding LoadCatalogCommand}" Style="{StaticResource OutlineButtonStyle}"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>