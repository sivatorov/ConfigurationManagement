<Window x:Class="Configuration_Management.BackupScenarioEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сценарий резервирования"
        Width="620" Height="640" MinWidth="540" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontSize="13"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <!-- Темизация окна «Сценарий резервирования» (issue #291): стили из LightTheme/DarkTheme,
             как у остальных окон (ConnectionSettingsWindow, AppLockWindow и др.). -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource ModernButton}"/>
        <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}"/>
        <Style TargetType="ComboBox" BasedOn="{StaticResource ModernComboBox}"/>
        <Style TargetType="CheckBox" BasedOn="{StaticResource ModernMaterialCheckBox}">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="OkButton" Content="OK" Width="90" Margin="0,0,8,0" Padding="6,4" IsDefault="True" Click="Ok_Click"/>
            <Button Content="Отмена" Width="90" Padding="6,4" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="NameLabel" Text="Наименование" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,0,0,10"/>

                <TextBlock x:Name="TemplateLabel" Text="Шаблон имени файла" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="TemplateBox" Text="{Binding FileNameTemplate, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,0,0,2"/>
                <TextBlock x:Name="TemplateHint" Text="" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="2,0,0,10"/>

                <CheckBox x:Name="TimestampCheck" Content="Добавлять отметку даты-времени в имя" IsChecked="{Binding IncludeTimestamp}" Margin="0,0,0,10"/>

                <TextBlock x:Name="FormatLabel" Text="Формат" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox x:Name="FormatCombo" SelectedItem="{Binding Format}" HorizontalAlignment="Left" MinWidth="160" Margin="0,0,0,10"/>

                <TextBlock x:Name="PrefixLabel" Text="Префикс базы" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="PrefixBox" Text="{Binding BasePrefix, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,0,0,10"/>

                <TextBlock x:Name="DirsLabel" Text="Каталоги назначения (1–3)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Button x:Name="AddDirButton" Content="Добавить…" Width="110" Padding="6,3" Click="AddDir_Click"/>
                    <Button x:Name="RemoveDirButton" Content="Удалить" Width="96" Margin="8,0,0,0" Padding="6,3" Click="RemoveDir_Click"/>
                </StackPanel>
                <ListBox x:Name="DirList" ItemsSource="{Binding TargetDirectories}" Height="110" Margin="0,0,0,10"/>

                <TextBlock x:Name="CredLabel" Text="Учётные данные" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <CheckBox x:Name="UseAuthCheck" Content="Использовать авторизацию базы" IsChecked="{Binding UseInfobaseAuth}" Margin="0,0,0,8"/>

                <TextBlock x:Name="UserLabel" Text="Пользователь" Margin="0,0,0,2"/>
                <TextBox x:Name="UserBox" Text="{Binding User, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,0,0,8"/>

                <TextBlock x:Name="PasswordLabel" Text="Пароль" Margin="0,0,0,2"/>
                <PasswordBox x:Name="PasswordBox" Padding="4" Margin="0,0,0,4"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>