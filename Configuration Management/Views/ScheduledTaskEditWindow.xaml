<Window x:Class="Configuration_Management.ScheduledTaskEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Задание по расписанию"
        Width="560" Height="520" MinWidth="500" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontSize="13"
        Background="{DynamicResource ContentBackgroundBrush}"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.Resources>
        <!-- Темизация окна «Задание по расписанию» (issue #291): стили из LightTheme/DarkTheme,
             как у остальных окон (ConnectionSettingsWindow, AppLockWindow и др.). -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource ModernButton}"/>
        <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}"/>
        <Style TargetType="ComboBox" BasedOn="{StaticResource ModernComboBox}"/>
        <Style TargetType="CheckBox" BasedOn="{StaticResource ModernMaterialCheckBox}">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Наименование" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <TextBox x:Name="NameBox" Grid.Column="1" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="1" Text="Включено" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <CheckBox x:Name="EnabledCheck" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="2" Text="Тип действия" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <ComboBox x:Name="KindCombo" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" SelectionChanged="KindCombo_SelectionChanged"/>

        <TextBlock Grid.Row="3" Text="Время (ЧЧ:ММ)" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <TextBox x:Name="TimeBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="4" Text="Дни недели" VerticalAlignment="Top" Margin="0,6,8,8"/>
        <StackPanel x:Name="DaysPanel" Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
            <CheckBox x:Name="MonCheck" Content="Пн" Margin="0,0,10,0" Tag="Monday"/>
            <CheckBox x:Name="TueCheck" Content="Вт" Margin="0,0,10,0" Tag="Tuesday"/>
            <CheckBox x:Name="WedCheck" Content="Ср" Margin="0,0,10,0" Tag="Wednesday"/>
            <CheckBox x:Name="ThuCheck" Content="Чт" Margin="0,0,10,0" Tag="Thursday"/>
            <CheckBox x:Name="FriCheck" Content="Пт" Margin="0,0,10,0" Tag="Friday"/>
            <CheckBox x:Name="SatCheck" Content="Сб" Margin="0,0,10,0" Tag="Saturday"/>
            <CheckBox x:Name="SunCheck" Content="Вс" Tag="Sunday"/>
        </StackPanel>

        <StackPanel x:Name="ScenarioPanel" Grid.Row="5" Grid.ColumnSpan="2" Margin="0,0,0,8">
            <TextBlock Text="Сценарий резервирования" VerticalAlignment="Center" Margin="0,0,8,8"/>
            <ComboBox x:Name="ScenarioCombo" Margin="0,0,0,0"/>
        </StackPanel>

        <StackPanel x:Name="InfobasePanel" Grid.Row="6" Grid.ColumnSpan="2" Margin="0,0,0,8">
            <TextBlock Text="Информационная база" VerticalAlignment="Center" Margin="0,0,8,8"/>
            <ComboBox x:Name="InfobaseCombo" Margin="0,0,0,0"/>
        </StackPanel>

        <StackPanel x:Name="CfgPanel" Grid.Row="7" Grid.ColumnSpan="2" Margin="0,0,0,8">
            <TextBlock Text="Файл конфигурации (.cf)" VerticalAlignment="Center" Margin="0,0,8,8"/>
            <DockPanel>
                <Button x:Name="BrowseButton" DockPanel.Dock="Right" Width="90" Content="Обзор…" Padding="6,4" Margin="8,0,0,0" Click="Browse_Click"/>
                <TextBox x:Name="CfgPathBox" Margin="0,0,0,0"/>
            </DockPanel>
        </StackPanel>

        <StackPanel Grid.Row="9" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,12,0,0">
            <Button x:Name="OkButton" Content="OK" Width="110" Margin="0,0,8,0" Padding="6,4" IsDefault="True" Click="Ok_Click"/>
            <Button Content="Отмена" Width="100" Padding="6,4" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>