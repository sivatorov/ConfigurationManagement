<Window x:Class="Configuration_Management.ConnectionSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:Configuration_Management.Models"
        xmlns:controls="clr-namespace:Configuration_Management.Controls"
        xmlns:loc="clr-namespace:Configuration_Management.Localization"
        mc:Ignorable="d"
        Title="{loc:Loc ConnectionSettings.Title}"
        Icon="{StaticResource AppIcon}"
        Width="760"
        MinHeight="680" MinWidth="680"
        Height="780"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI"
        FontSize="13"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
            <!-- Размеры и отступы выровнены с ModernComboBox (см. строку ниже):
                 высоту, внутренний отступ и кегль берём из темы (10,6 / 36 / 13),
                 чтобы текстовые поля выглядели единообразно с комбобоксами. -->
            <Setter Property="Margin" Value="0,3"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource ModernComboBox}"/>
        <Style TargetType="CheckBox" BasedOn="{StaticResource ModernMaterialCheckBox}">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Grid.RowSpan="2"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"/>
                            <Border Grid.Row="0" Background="{TemplateBinding Background}"
                                    Padding="10,4,10,0" Margin="8,0,0,0" HorizontalAlignment="Left">
                                <ContentPresenter ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
                                                  TextElement.FontWeight="SemiBold"
                                                  TextElement.FontSize="13"/>
                            </Border>
                            <ContentPresenter Grid.Row="1" Margin="{TemplateBinding Padding}"
                                              TextElement.Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- Вертикальные вкладки окна подключения (слева), как в окне «Настройки» -->
        <Style x:Key="ConnTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="TabStripPlacement" Value="Left"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Padding="0,4,8,12" Background="Transparent"
                                    ClipToBounds="False">
                                <StackPanel IsItemsHost="True" ClipToBounds="False"/>
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              ContentSource="SelectedContent"
                                              Margin="8,0,0,0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ConnTabItem" TargetType="TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Width" Value="180"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,3,0"
                                CornerRadius="8"
                                Width="{TemplateBinding Width}"
                                MinHeight="40"
                                SnapsToDevicePixels="True"
                                ClipToBounds="False"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                            </MultiTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TreeSelectedBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Padding="20,16"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Border Width="40" Height="40" CornerRadius="10" Margin="0,0,12,0"
                        Background="{DynamicResource AccentBrush}" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Database" Width="22" Height="22"
                                             Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc Connection.HeaderTitle}" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{loc:Loc Connection.HeaderSubtitle}"
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Контент: вкладки -->
        <TabControl Grid.Row="1" Margin="12,8,12,4" Style="{StaticResource ConnTabControl}">
            <!-- База -->
            <TabItem Style="{StaticResource ConnTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Database" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc Connection.Tab.Base}" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                <StackPanel>
                <GroupBox Margin="4,6,4,4" VerticalAlignment="Top">
                    <GroupBox.Header>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Database" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="{loc:Loc Connection.GroupBase}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </GroupBox.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Connection.NameLabel}" VerticalAlignment="Center" Margin="0,3"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" Padding="6,4"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Connection.GroupLabel}" VerticalAlignment="Center" Margin="0,3"/>
                        <Grid Grid.Row="1" Grid.Column="1" Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" IsReadOnly="True" Text="{Binding GroupDisplayPath, Mode=OneWay}" Padding="8,6" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1" Margin="6,0,0,0" Padding="10,4" Style="{DynamicResource SecondaryButton}" Click="OnSelectGroup_Click">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FolderOutline" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Loc Connection.ChooseGroup}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Connection.DescriptionLabel}" VerticalAlignment="Center" Margin="0,3"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" Padding="6,4"/>
                        <!-- Ручной размер базы (issue #243): позволяет хранить размер клиент-серверных
                             баз, полученный запросом в СУБД, не держа его в комментариях. -->
                        <CheckBox Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,3"
                                  Content="{loc:Loc Connection.ManualSizeLabel}"
                                  IsChecked="{Binding IsManualSizeSet}"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,3" Padding="6,4"
                                 Text="{Binding ManualSizeText, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsManualSizeSet}"
                                 ToolTip="{loc:Loc Connection.ManualSizeTooltip}"/>
                    </Grid>
                </GroupBox>

                <!-- Теги базы (issue #283): правка тегов в окне свойств + автодополнение
                     из существующих тегов. -->
                <GroupBox Margin="4,6,4,4" VerticalAlignment="Top">
                    <GroupBox.Header>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TagMultiple" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="{loc:Loc Connection.GroupTags}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </GroupBox.Header>
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Tags}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource ItemHoverBrush}" CornerRadius="10" Padding="8,3" Margin="0,0,6,4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <Button Content="×" Tag="{Binding}" Click="OnRemoveTag_Click" Style="{DynamicResource IconButton}"
                                                    Width="16" Height="16" Padding="0" FontSize="12" VerticalAlignment="Center"
                                                    ToolTip="{loc:Loc Connection.RemoveTagTooltip}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <DockPanel Margin="0,4,0,0">
                            <Button DockPanel.Dock="Right" Content="{loc:Loc Connection.AddTag}" Click="OnAddTag_Click"
                                    Style="{DynamicResource SecondaryButton}" Margin="6,0,0,0" Padding="10,4"/>
                            <ComboBox x:Name="TagInputBox" IsEditable="True" IsTextSearchEnabled="False"
                                      StaysOpenOnEdit="True"
                                      Text="{Binding TagInput, UpdateSourceTrigger=PropertyChanged}"
                                      ItemsSource="{Binding AvailableTags}"
                                      KeyDown="OnTagInput_KeyDown" Padding="6,4"/>
                        </DockPanel>
                    </StackPanel>
                </GroupBox>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Подключение -->
            <TabItem Style="{StaticResource ConnTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="LanConnect" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc Connection.Tab.Connection}" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                <StackPanel>
                    <GroupBox Margin="4,6,4,4" VerticalAlignment="Top">
                    <GroupBox.Header>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ServerNetwork" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="{loc:Loc Connection.GroupConnectionType}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </GroupBox.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Connection.TypeLabel}" VerticalAlignment="Top" Margin="0,4"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0">
                            <Border Margin="0,0,0,4" Padding="8,6" CornerRadius="6" BorderThickness="1.5" Cursor="Hand" Background="{DynamicResource CardBackgroundBrush}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsClientServer}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <RadioButton GroupName="ConnType" Cursor="Hand"
                                             IsChecked="{Binding IsClientServer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc Connection.TypeServer}" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Text="{loc:Loc Connection.TypeServerHint}" FontSize="11" Opacity="0.75" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </RadioButton>
                            </Border>
                            <Border Margin="0,0,0,4" Padding="8,6" CornerRadius="6" BorderThickness="1.5" Cursor="Hand" Background="{DynamicResource CardBackgroundBrush}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFile}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <RadioButton GroupName="ConnType" Cursor="Hand"
                                             IsChecked="{Binding IsFile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc Connection.TypeFile}" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Text="{loc:Loc Connection.TypeFileHint}" FontSize="11" Opacity="0.75" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </RadioButton>
                            </Border>
                            <Border Margin="0,0,0,4" Padding="8,6" CornerRadius="6" BorderThickness="1.5" Cursor="Hand" Background="{DynamicResource CardBackgroundBrush}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWebServer}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <RadioButton GroupName="ConnType" Cursor="Hand"
                                             IsChecked="{Binding IsWebServer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc Connection.TypeWeb}" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Text="{loc:Loc Connection.TypeWebHint}" FontSize="11" Opacity="0.75" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </RadioButton>
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Connection.ServerLabel}" VerticalAlignment="Center" Margin="0,3" Visibility="{Binding IsClientServer, Converter={StaticResource BoolToVis}}"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,3"
                                  Style="{StaticResource ModernComboBox}"
                                  IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  StaysOpenOnEdit="True"
                                  ItemsSource="{Binding AvailableServers}"
                                  Text="{Binding Server, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="{loc:Loc Connection.ServerTooltip}"
                                  Visibility="{Binding IsClientServer, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Connection.DatabaseNameLabel}" VerticalAlignment="Center" Margin="0,3" Visibility="{Binding IsClientServer, Converter={StaticResource BoolToVis}}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DatabaseName, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" Visibility="{Binding IsClientServer, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc Connection.PortLabel}" VerticalAlignment="Center" Margin="0,3" Visibility="{Binding IsClientServer, Converter={StaticResource BoolToVis}}"/>
                        <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,3"
                                  Style="{StaticResource ModernComboBox}"
                                  IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  StaysOpenOnEdit="True"
                                  ItemsSource="{Binding AvailablePorts}"
                                  Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="{loc:Loc Connection.PortTooltip}"
                                  Visibility="{Binding IsClientServer, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Connection.FilePathLabel}" VerticalAlignment="Center" Margin="0,3" Visibility="{Binding IsFile, Converter={StaticResource BoolToVis}}"/>
                        <Grid Grid.Row="1" Grid.Column="1" Visibility="{Binding IsFile, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,3"/>
                            <Button Grid.Column="1" Margin="6,3,0,3" Padding="10,4"
                                    Style="{DynamicResource SecondaryButton}"
                                    Click="OnBrowseFilePath_Click"
                                    ToolTip="{loc:Loc Connection.BrowseFileTooltip}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FolderOpen" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Loc Common.Browse}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Connection.WebUrlLabel}" VerticalAlignment="Center" Margin="0,3" Visibility="{Binding IsWebServer, Converter={StaticResource BoolToVis}}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding WebUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" Visibility="{Binding IsWebServer, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                    </GroupBox>

                    <!-- Кнопка вставки строки подключения: доступна только на вкладке «Подключение» -->
                    <StackPanel Orientation="Horizontal" Margin="4,8,4,0">
                        <Button Height="36" Padding="12,0" Margin="0,0,6,0"
                                Style="{DynamicResource SecondaryButton}"
                                Click="OnPasteConnectionString_Click"
                                ToolTip="{loc:Loc Connection.PasteStringTooltip}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentPaste" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc Connection.PasteString}" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <controls:HelpLink HelpText="{loc:Loc Connection.PasteStringHelp}"/>
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Хранилище конфигурации -->
            <TabItem Style="{StaticResource ConnTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="SourceBranch" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc Connection.Tab.Repository}" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                <GroupBox Margin="4,6,4,4" VerticalAlignment="Top">
                    <GroupBox.Header>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="SourceBranch" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="{loc:Loc Connection.GroupRepository}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </GroupBox.Header>
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Connection.RepositoryServerLabel}" VerticalAlignment="Center" Margin="0,3"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,3"
                                      Style="{StaticResource ModernComboBox}"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True"
                                      StaysOpenOnEdit="True"
                                      ItemsSource="{Binding AvailableRepositoryServers}"
                                      Text="{Binding RepositoryServer, UpdateSourceTrigger=PropertyChanged}"
                                      ToolTip="{loc:Loc Connection.RepositoryServerTooltip}"/>
                            <Button Grid.Row="0" Grid.Column="2" Margin="6,3,0,3" Height="30" Padding="8,0"
                                    Click="OnPasteRepositorySplit_Click" Cursor="Hand"
                                    ToolTip="{loc:Loc Connection.RepositoryPasteTooltip}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ContentPaste" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Loc Connection.RepositoryPaste}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Connection.RepositoryNameLabel}" VerticalAlignment="Center" Margin="0,3"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RepositoryName, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" Padding="6,4"
                                     ToolTip="{loc:Loc Connection.RepositoryNameTooltip}"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Connection.RepositoryLoginLabel}" VerticalAlignment="Center" Margin="0,3"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding RepositoryUser, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" Padding="6,4"
                                     ToolTip="{loc:Loc Connection.RepositoryUserTooltip}"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc Connection.RepositoryPasswordLabel}" VerticalAlignment="Center" Margin="0,3"/>
                            <Grid Grid.Row="3" Grid.Column="1" Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <PasswordBox x:Name="RepositoryPasswordBox" Padding="6,4"
                                                 VerticalContentAlignment="Center"
                                                 PasswordChanged="OnRepositoryPasswordBox_PasswordChanged"
                                                 ToolTip="{loc:Loc Connection.RepositoryPasswordTooltip}"/>
                                    <!-- Поле показа пароля редактируемо (issue #211): правки
                                         синхронизируются обратно в PasswordBox и ViewModel. -->
                                    <TextBox x:Name="RepositoryPasswordRevealTextBox" Margin="0" Padding="6,4"
                                             VerticalContentAlignment="Center"
                                             Visibility="Collapsed"
                                             TextChanged="OnRepositoryPasswordReveal_TextChanged"/>
                                </Grid>
                                <Button x:Name="RepositoryPasswordRevealButton" Grid.Column="1" Width="30" Height="30" Margin="6,0,0,0"
                                        Style="{DynamicResource IconButton}" Click="OnRepositoryPasswordReveal_Click"
                                        ToolTip="{loc:Loc Connection.ShowPasswordTooltip}">
                                    <materialDesign:PackIcon Kind="EyeOutline" Width="16" Height="16"/>
                                </Button>
                                <Button x:Name="RepositoryPasswordCopyButton" Grid.Column="2" Width="30" Height="30" Margin="4,0,0,0"
                                        Style="{DynamicResource IconButton}" Click="OnRepositoryPasswordCopy_Click"
                                        ToolTip="{loc:Loc Connection.CopyPasswordTooltip}">
                                    <materialDesign:PackIcon Kind="ContentCopy" Width="16" Height="16"/>
                                </Button>
                            </Grid>
                        </Grid>
                        <TextBlock Text="{loc:Loc Connection.RepositoryDescription}"
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </GroupBox>
                </ScrollViewer>
            </TabItem>

            <!-- Авторизация -->
            <TabItem Style="{StaticResource ConnTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AccountKey" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc Connection.Tab.Auth}" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                <StackPanel>
                    <GroupBox Margin="4,6,4,4" VerticalAlignment="Top">
                        <GroupBox.Header>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountKey" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="{loc:Loc Connection.GroupAuthEnterprise}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </GroupBox.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Connection.ModeLabel}" VerticalAlignment="Top" Margin="0,4"/>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0">
                                <Border Margin="0,0,0,4" Padding="8,6" CornerRadius="6" BorderThickness="1.5" Cursor="Hand" Background="{DynamicResource CardBackgroundBrush}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAuthPrompt}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <RadioButton GroupName="AuthMode" Cursor="Hand"
                                                 IsChecked="{Binding IsAuthPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Loc Connection.AuthPrompt}" FontWeight="SemiBold" FontSize="12"/>
                                            <TextBlock Text="{loc:Loc Connection.AuthPromptHint}" FontSize="11" Opacity="0.75" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </RadioButton>
                                </Border>
                                <Border Margin="0,0,0,4" Padding="8,6" CornerRadius="6" BorderThickness="1.5" Cursor="Hand" Background="{DynamicResource CardBackgroundBrush}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAuthCredentials}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <RadioButton GroupName="AuthMode" Cursor="Hand"
                                                 IsChecked="{Binding IsAuthCredentials, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Loc Connection.AuthAuto}" FontWeight="SemiBold" FontSize="12"/>
                                            <TextBlock Text="{loc:Loc Connection.AuthAutoHint}" FontSize="11" Opacity="0.75" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </RadioButton>
                                </Border>
                                <Border Margin="0,0,0,4" Padding="8,6" CornerRadius="6" BorderThickness="1.5" Cursor="Hand" Background="{DynamicResource CardBackgroundBrush}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAuthWindows}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <RadioButton GroupName="AuthMode" Cursor="Hand"
                                                 IsChecked="{Binding IsAuthWindows, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Loc Connection.AuthOs}" FontWeight="SemiBold" FontSize="12"/>
                                            <TextBlock Text="{loc:Loc Connection.AuthOsHint}" FontSize="11" Opacity="0.75" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </RadioButton>
                                </Border>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Connection.UserLabel}" VerticalAlignment="Center" Margin="0,3" Visibility="{Binding IsCredentialsVisible, Converter={StaticResource BoolToVis}}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding User, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" Padding="6,4" Visibility="{Binding IsCredentialsVisible, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Connection.PasswordLabel}" VerticalAlignment="Center" Margin="0,3" Visibility="{Binding IsCredentialsVisible, Converter={StaticResource BoolToVis}}"/>
                            <Grid Grid.Row="2" Grid.Column="1" Margin="0,3"
                                  Visibility="{Binding IsCredentialsVisible, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <PasswordBox x:Name="PasswordBox" Padding="6,4"
                                                 VerticalContentAlignment="Center"
                                                 PasswordChanged="OnPasswordBox_PasswordChanged"/>
                                    <!-- Поле показа пароля редактируемо (issue #211): правки
                                         синхронизируются обратно в PasswordBox и ViewModel. -->
                                    <TextBox x:Name="PasswordRevealTextBox" Margin="0" Padding="6,4"
                                             VerticalContentAlignment="Center"
                                             Visibility="Collapsed"
                                             TextChanged="OnPasswordReveal_TextChanged"/>
                                </Grid>
                                <Button x:Name="PasswordRevealButton" Grid.Column="1" Width="30" Height="30" Margin="6,0,0,0"
                                        Style="{DynamicResource IconButton}" Click="OnPasswordReveal_Click"
                                        ToolTip="{loc:Loc Connection.ShowPasswordTooltip}">
                                    <materialDesign:PackIcon Kind="EyeOutline" Width="16" Height="16"/>
                                </Button>
                                <Button x:Name="PasswordCopyButton" Grid.Column="2" Width="30" Height="30" Margin="4,0,0,0"
                                        Style="{DynamicResource IconButton}" Click="OnPasswordCopy_Click"
                                        ToolTip="{loc:Loc Connection.CopyPasswordTooltip}">
                                    <materialDesign:PackIcon Kind="ContentCopy" Width="16" Height="16"/>
                                </Button>
                            </Grid>
                        </Grid>
                    </GroupBox>

                    <GroupBox Margin="4,6,4,4" VerticalAlignment="Top">
                        <GroupBox.Header>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ApplicationEditOutline" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="{loc:Loc Connection.GroupAuthConfigurator}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </GroupBox.Header>
                        <StackPanel>
                        <CheckBox Content="{loc:Loc Connection.ConfiguratorUseEnterpriseAuth}"
                                  IsChecked="{Binding ConfiguratorUseEnterpriseAuth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="4,0,0,8" ToolTip="{loc:Loc Connection.ConfiguratorUseEnterpriseAuthHint}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Connection.ModeLabel}" VerticalAlignment="Top" Margin="0,4"/>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0" IsEnabled="{Binding IsConfiguratorAuthEnabled}">
                                <Border Margin="0,0,0,4" Padding="8,6" CornerRadius="6" BorderThickness="1.5" Cursor="Hand" Background="{DynamicResource CardBackgroundBrush}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConfiguratorAuthPrompt}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <RadioButton GroupName="ConfigAuthMode" Cursor="Hand"
                                                 IsChecked="{Binding IsConfiguratorAuthPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Loc Connection.AuthPrompt}" FontWeight="SemiBold" FontSize="12"/>
                                            <TextBlock Text="{loc:Loc Connection.AuthConfiguratorPromptHint}" FontSize="11" Opacity="0.75" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </RadioButton>
                                </Border>
                                <Border Margin="0,0,0,4" Padding="8,6" CornerRadius="6" BorderThickness="1.5" Cursor="Hand" Background="{DynamicResource CardBackgroundBrush}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConfiguratorAuthCredentials}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <RadioButton GroupName="ConfigAuthMode" Cursor="Hand"
                                                 IsChecked="{Binding IsConfiguratorAuthCredentials, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Loc Connection.AuthAuto}" FontWeight="SemiBold" FontSize="12"/>
                                            <TextBlock Text="{loc:Loc Connection.AuthAutoHint}" FontSize="11" Opacity="0.75" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </RadioButton>
                                </Border>
                                <Border Margin="0,0,0,4" Padding="8,6" CornerRadius="6" BorderThickness="1.5" Cursor="Hand" Background="{DynamicResource CardBackgroundBrush}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConfiguratorAuthWindows}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <RadioButton GroupName="ConfigAuthMode" Cursor="Hand"
                                                 IsChecked="{Binding IsConfiguratorAuthWindows, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Loc Connection.AuthOs}" FontWeight="SemiBold" FontSize="12"/>
                                            <TextBlock Text="{loc:Loc Connection.AuthOsHint}" FontSize="11" Opacity="0.75" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </RadioButton>
                                </Border>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Connection.UserLabel}" VerticalAlignment="Center" Margin="0,3" Visibility="{Binding IsConfiguratorCredentialsVisible, Converter={StaticResource BoolToVis}}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ConfiguratorUser, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" Padding="6,4" Visibility="{Binding IsConfiguratorCredentialsVisible, Converter={StaticResource BoolToVis}}" IsEnabled="{Binding IsConfiguratorAuthEnabled}"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Connection.PasswordLabel}" VerticalAlignment="Center" Margin="0,3" Visibility="{Binding IsConfiguratorCredentialsVisible, Converter={StaticResource BoolToVis}}"/>
                            <Grid Grid.Row="2" Grid.Column="1" Margin="0,3"
                                  Visibility="{Binding IsConfiguratorCredentialsVisible, Converter={StaticResource BoolToVis}}"
                                  IsEnabled="{Binding IsConfiguratorAuthEnabled}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <PasswordBox x:Name="ConfiguratorPasswordBox" Padding="6,4"
                                                 VerticalContentAlignment="Center"
                                                 PasswordChanged="OnConfiguratorPasswordBox_PasswordChanged"/>
                                    <!-- Поле показа пароля редактируемо (issue #211): правки
                                         синхронизируются обратно в PasswordBox и ViewModel. -->
                                    <TextBox x:Name="ConfiguratorPasswordRevealTextBox" Margin="0" Padding="6,4"
                                             VerticalContentAlignment="Center"
                                             Visibility="Collapsed"
                                             TextChanged="OnConfiguratorPasswordReveal_TextChanged"/>
                                </Grid>
                                <Button x:Name="ConfiguratorPasswordRevealButton" Grid.Column="1" Width="30" Height="30" Margin="6,0,0,0"
                                        Style="{DynamicResource IconButton}" Click="OnConfiguratorPasswordReveal_Click"
                                        ToolTip="{loc:Loc Connection.ShowPasswordTooltip}">
                                    <materialDesign:PackIcon Kind="EyeOutline" Width="16" Height="16"/>
                                </Button>
                                <Button x:Name="ConfiguratorPasswordCopyButton" Grid.Column="2" Width="30" Height="30" Margin="4,0,0,0"
                                        Style="{DynamicResource IconButton}" Click="OnConfiguratorPasswordCopy_Click"
                                        ToolTip="{loc:Loc Connection.CopyPasswordTooltip}">
                                    <materialDesign:PackIcon Kind="ContentCopy" Width="16" Height="16"/>
                                </Button>
                            </Grid>
                        </Grid>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Запуск -->
            <TabItem Style="{StaticResource ConnTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="PlayCircleOutline" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc Connection.Tab.Launch}" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                <GroupBox Margin="4,6,4,4" VerticalAlignment="Top">
                    <GroupBox.Header>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ApplicationOutline" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="{loc:Loc Connection.GroupLaunchMode}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </GroupBox.Header>
                    <StackPanel>
                    <TextBlock Text="{loc:Loc Connection.DblClickActionLabel}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                    <ComboBox x:Name="DoubleClickActionCombo" Width="220" HorizontalAlignment="Left" Margin="0,0,0,4"
                              SelectionChanged="OnDoubleClickActionCombo_SelectionChanged"/>

                    <TextBlock Text="{loc:Loc Connection.ExternalProcessingLabel}" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,4"/>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ExternalProcessingPathBox" Grid.Column="0"
                                 Text="{Binding ExternalProcessingPath, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1" Margin="6,0,0,0" Padding="8,3" Style="{DynamicResource SecondaryButton}"
                                Click="OnBrowseExternalProcessing_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FolderOpen" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc Common.Browse}"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Text="{loc:Loc Connection.ExternalProcessingDataLabel}" FontWeight="SemiBold" FontSize="12" Margin="0,4,0,4"/>
                    <TextBox Text="{Binding ExternalProcessingData, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6" VerticalContentAlignment="Center" Margin="0,0,0,4"/>
                    <Border Margin="0,0,0,4" Padding="8,6" CornerRadius="6"
                            BorderThickness="1.5" Cursor="Hand"
                            Background="{DynamicResource CardBackgroundBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAutoMode}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <RadioButton GroupName="LaunchMode" Cursor="Hand"
                                     IsChecked="{Binding IsAutoMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Connection.LaunchAuto}" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Text="{loc:Loc Connection.LaunchAutoHint}" FontSize="11" TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>
                    </Border>

                    <Border Margin="0,0,0,4" Padding="8,6" CornerRadius="6"
                            BorderThickness="1.5" Cursor="Hand"
                            Background="{DynamicResource CardBackgroundBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsThinClient}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <RadioButton GroupName="LaunchMode" Cursor="Hand"
                                     IsChecked="{Binding IsThinClient, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Connection.LaunchThin}" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Text="{loc:Loc Connection.LaunchThinHint}" FontSize="11" TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>
                    </Border>

                    <Border Margin="0,0,0,4" Padding="8,6" CornerRadius="6"
                            BorderThickness="1.5" Cursor="Hand"
                            Background="{DynamicResource CardBackgroundBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsThickClient}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <RadioButton GroupName="LaunchMode" Cursor="Hand"
                                     IsChecked="{Binding IsThickClient, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Connection.LaunchThickManaged}" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Text="{loc:Loc Connection.LaunchThickManagedHint}" FontSize="11" TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>
                    </Border>

                    <Border Margin="0,0,0,4" Padding="8,6" CornerRadius="6"
                            BorderThickness="1.5" Cursor="Hand"
                            Background="{DynamicResource CardBackgroundBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsThickOrdinaryClient}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <RadioButton GroupName="LaunchMode" Cursor="Hand"
                                     IsChecked="{Binding IsThickOrdinaryClient, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Connection.LaunchThickOrdinary}" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Text="{loc:Loc Connection.LaunchThickOrdinaryHint}" FontSize="11" TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>
                    </Border>

                    <Border Margin="0,0,0,4" Padding="8,6" CornerRadius="6"
                            BorderThickness="1.5" Cursor="Hand"
                            Background="{DynamicResource CardBackgroundBrush}"
                            IsEnabled="{Binding IsWebClientAllowed}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWebClient}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                    </DataTrigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.45"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <RadioButton GroupName="LaunchMode" Cursor="Hand"
                                     IsEnabled="{Binding IsWebClientAllowed}"
                                     IsChecked="{Binding IsWebClient, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Connection.LaunchWeb}" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Text="{loc:Loc Connection.LaunchWebHint}" FontSize="11" TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>
                    </Border>

                    <TextBlock Text="{Binding LaunchModeHint}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="2,6,0,0"/>
                    </StackPanel>
                </GroupBox>
                </ScrollViewer>
            </TabItem>

            <!-- Разрядность -->
            <TabItem Style="{StaticResource ConnTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Chip" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc Connection.Tab.Bitness}" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                <GroupBox Margin="4,6,4,4" VerticalAlignment="Top">
                    <GroupBox.Header>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Chip" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="{loc:Loc Connection.GroupBitness}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </GroupBox.Header>
                    <StackPanel>
                    <Border Margin="0,0,0,4" Padding="8,6" CornerRadius="6"
                            BorderThickness="1.5" Cursor="Hand"
                            Background="{DynamicResource CardBackgroundBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsArchitecture32Priority}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <RadioButton GroupName="Arch" Cursor="Hand"
                                     IsChecked="{Binding IsArchitecture32Priority, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Connection.Arch32Priority}" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Text="{loc:Loc Connection.Arch32PriorityHint}" FontSize="11" TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>
                    </Border>

                    <Border Margin="0,0,0,4" Padding="8,6" CornerRadius="6"
                            BorderThickness="1.5" Cursor="Hand"
                            Background="{DynamicResource CardBackgroundBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsArchitecture64Priority}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <RadioButton GroupName="Arch" Cursor="Hand"
                                     IsChecked="{Binding IsArchitecture64Priority, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Connection.Arch64Priority}" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Text="{loc:Loc Connection.Arch64PriorityHint}" FontSize="11" TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>
                    </Border>

                    <Border Margin="0,0,0,4" Padding="8,6" CornerRadius="6"
                            BorderThickness="1.5" Cursor="Hand"
                            Background="{DynamicResource CardBackgroundBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsArchitecture32}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <RadioButton GroupName="Arch" Cursor="Hand"
                                     IsChecked="{Binding IsArchitecture32, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Connection.ArchOnly32}" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Text="{loc:Loc Connection.ArchOnly32Hint}" FontSize="11" TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>
                    </Border>

                    <Border Margin="0,0,0,4" Padding="8,6" CornerRadius="6"
                            BorderThickness="1.5" Cursor="Hand"
                            Background="{DynamicResource CardBackgroundBrush}"
                            IsEnabled="{Binding IsOs64Bit}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsArchitecture64}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                    </DataTrigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.45"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <RadioButton GroupName="Arch" Cursor="Hand"
                                     IsEnabled="{Binding IsOs64Bit}"
                                     IsChecked="{Binding IsArchitecture64, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Connection.ArchOnly64}" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Text="{loc:Loc Connection.ArchOnly64Hint}" FontSize="11" TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>
                    </Border>

                    <TextBlock Text="{Binding ArchitectureHint}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="2,6,0,0"/>
                    <TextBlock x:Name="OsArchitectureHintText" FontSize="11" Margin="2,2,0,0" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOs64Bit}" Value="False">
                                        <Setter Property="Foreground" Value="#DC2626"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    </StackPanel>
                </GroupBox>
                </ScrollViewer>
            </TabItem>

            <!-- Платформа -->
            <TabItem Style="{StaticResource ConnTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CubeOutline" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc Connection.Tab.Platform}" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                <GroupBox Margin="4,6,4,4" VerticalAlignment="Top">
                    <GroupBox.Header>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CubeOutline" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="{loc:Loc Connection.GroupPlatform}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </GroupBox.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Connection.VersionLabel}" VerticalAlignment="Center" Margin="0,3"/>
                        <Grid Grid.Row="0" Grid.Column="1" Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding PlatformVersion, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6" VerticalContentAlignment="Center"
                                     ToolTip="{loc:Loc Connection.PlatformVersionTooltip}"/>
                            <Button Grid.Column="1" Margin="6,0,0,0" Padding="8,3"
                                    Style="{DynamicResource SecondaryButton}"
                                    Click="OnPlatformSettings_Click">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CubeOutline" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Loc Connection.ChoosePlatform}" VerticalAlignment="Center" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Connection.ConfigurationLabel}" VerticalAlignment="Center" Margin="0,6,0,3"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,6,0,3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding ConfigurationName, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,6" VerticalContentAlignment="Center"
                                         ToolTip="{loc:Loc Connection.ConfigurationNameTooltip}"/>
                                <TextBox Grid.Column="2"
                                         Text="{Binding ConfigurationVersion, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,6" VerticalContentAlignment="Center"
                                         ToolTip="{loc:Loc Connection.ConfigurationVersionTooltip}"/>
                            </Grid>
                            <Button HorizontalAlignment="Left" Margin="0,6,0,0" Padding="8,3"
                                    Style="{DynamicResource SecondaryButton}"
                                    Click="OnDetectConfiguration_Click"
                                    ToolTip="{loc:Loc Connection.DetectConfigTooltip}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Loc Connection.DetectConfig}" VerticalAlignment="Center" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{loc:Loc Connection.ConfigurationManualHint}"
                                       FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Connection.ParametersLabel}" VerticalAlignment="Center" Margin="0,3"/>
                        <Grid Grid.Row="2" Grid.Column="1" Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding LaunchParameters, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1" Margin="6,0,0,0" Padding="8,3" Style="{DynamicResource SecondaryButton}" Click="OnLaunchParameters_Click">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Tune" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Loc Connection.Parameters}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </GroupBox>
                </ScrollViewer>
            </TabItem>

            <!-- Идентификатор -->
            <TabItem Style="{StaticResource ConnTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Identifier" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc Connection.Tab.Id}" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                <StackPanel Margin="8,12,8,8" VerticalAlignment="Top">
                    <TextBlock Text="{loc:Loc Connection.IdDescription}"
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <TextBlock Text="{loc:Loc Connection.IdLabel}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBox Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}"
                             Padding="6,4" MinHeight="28" FontSize="12"
                             VerticalContentAlignment="Center"
                             ToolTip="{loc:Loc Connection.IdTooltip}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Padding="10,5" Margin="0,0,8,0" Style="{DynamicResource SecondaryButton}"
                                Click="OnGenerateId_Click" ToolTip="{loc:Loc Connection.GenerateIdTooltip}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"
                                                         Foreground="#22C55E"/>
                                <TextBlock Text="{loc:Loc Connection.GenerateId}" VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <Button Padding="10,5" Style="{DynamicResource SecondaryButton}"
                                Click="OnCopyId_Click" ToolTip="{loc:Loc Connection.CopyIdTooltip}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentCopy" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc Connection.CopyId}" VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Padding="16,12"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Левая колонка нижней панели (кнопка вставки строки подключения
                     перенесена на вкладку «Подключение», доступна только там). -->

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Width="140" Height="36" Margin="0,0,10,0" IsDefault="True" Click="OnSave_Click"
                        IsEnabled="{Binding HasChanges}"
                        Background="#16A34A" BorderThickness="0" Cursor="Hand" Foreground="White">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#15803D"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#166534"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ContentSave" Width="16" Height="16" Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc Common.Save}" VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Button Width="140" Height="36" IsCancel="True" Click="OnCancel_Click"
                        Background="Transparent" Cursor="Hand" BorderThickness="1.5"
                        BorderBrush="#EF4444" Foreground="#EF4444">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8" Padding="12,8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#FEF2F2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Foreground="#EF4444" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc Common.Cancel}" VerticalAlignment="Center" Foreground="#EF4444" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
