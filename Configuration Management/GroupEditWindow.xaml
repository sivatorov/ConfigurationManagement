<Window x:Class="Configuration_Management.GroupEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Настройка группы"
        Icon="{StaticResource AppIcon}"
        Width="460"
        MinWidth="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI"
        FontSize="13"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <!-- Кнопка цвета палитры (фон задаётся в code-behind из Tag) -->
        <Style x:Key="PaletteColorButton" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#33000000"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ Основные параметры ============ -->
        <GroupBox Grid.Row="0" Header="Основные параметры" Padding="8" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Наименование:" VerticalAlignment="Center" Margin="0,4"/>
                <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" Margin="0,4" Padding="4,3"
                         Style="{DynamicResource ModernTextBox}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Родительская группа:" VerticalAlignment="Center" Margin="0,4"/>
                <ComboBox x:Name="ParentCombo" Grid.Row="1" Grid.Column="1" Margin="0,4" Padding="4,3"
                          ToolTip="Группа, внутри которой будет находиться данная группа"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Описание:" VerticalAlignment="Center" Margin="0,4"/>
                <TextBox x:Name="DescriptionBox" Grid.Row="2" Grid.Column="1" Margin="0,4" Padding="4,3"
                         Style="{DynamicResource ModernTextBox}"/>
            </Grid>
        </GroupBox>

        <!-- ============ Цвет группы ============ -->
        <GroupBox Grid.Row="1" Header="Цвет группы" Padding="8" Margin="0,0,0,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Border x:Name="ColorPreview" Width="40" Height="28" CornerRadius="4" Margin="0,0,8,0"
                            VerticalAlignment="Center" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1"/>
                    <TextBlock x:Name="ColorHexText" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                </StackPanel>
                <UniformGrid x:Name="PaletteGrid" Rows="2" Columns="8">
                    <Button Style="{StaticResource PaletteColorButton}" Tag="#EF4444" Click="OnPaletteColor_Click"/>
                    <Button Style="{StaticResource PaletteColorButton}" Tag="#F97316" Click="OnPaletteColor_Click"/>
                    <Button Style="{StaticResource PaletteColorButton}" Tag="#F59E0B" Click="OnPaletteColor_Click"/>
                    <Button Style="{StaticResource PaletteColorButton}" Tag="#EAB308" Click="OnPaletteColor_Click"/>
                    <Button Style="{StaticResource PaletteColorButton}" Tag="#84CC16" Click="OnPaletteColor_Click"/>
                    <Button Style="{StaticResource PaletteColorButton}" Tag="#22C55E" Click="OnPaletteColor_Click"/>
                    <Button Style="{StaticResource PaletteColorButton}" Tag="#10B981" Click="OnPaletteColor_Click"/>
                    <Button Style="{StaticResource PaletteColorButton}" Tag="#14B8A6" Click="OnPaletteColor_Click"/>
                    <Button Style="{StaticResource PaletteColorButton}" Tag="#06B6D4" Click="OnPaletteColor_Click"/>
                    <Button Style="{StaticResource PaletteColorButton}" Tag="#0EA5E9" Click="OnPaletteColor_Click"/>
                    <Button Style="{StaticResource PaletteColorButton}" Tag="#3B82F6" Click="OnPaletteColor_Click"/>
                    <Button Style="{StaticResource PaletteColorButton}" Tag="#2D6CDF" Click="OnPaletteColor_Click"/>
                    <Button Style="{StaticResource PaletteColorButton}" Tag="#6366F1" Click="OnPaletteColor_Click"/>
                    <Button Style="{StaticResource PaletteColorButton}" Tag="#8B5CF6" Click="OnPaletteColor_Click"/>
                    <Button Style="{StaticResource PaletteColorButton}" Tag="#A855F7" Click="OnPaletteColor_Click"/>
                    <Button Style="{StaticResource PaletteColorButton}" Tag="#D946EF" Click="OnPaletteColor_Click"/>
                </UniformGrid>
            </StackPanel>
        </GroupBox>

        <!-- ============ Кнопки ============ -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,0">
            <Button Width="120" Height="34" Style="{DynamicResource ModernButton}"
                    Margin="0,0,10,0" IsDefault="True" Click="OnSave_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="💾" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Сохранить" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Width="120" Height="34" Style="{DynamicResource SecondaryButton}" IsCancel="True">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✖" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Отмена" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>