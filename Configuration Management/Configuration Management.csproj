<Project Sdk="Microsoft.NET.Sdk">

  <!-- ======================================================================
       Переключатель кросс-платформенной сборки.
       По умолчанию целевой TFM и состав проекта выбираются по ОС сборки:
         * Windows -> net10.0-windows (WPF);
         * Linux   -> net10.0 (Avalonia).
       Чтобы собрать Linux-версию (net10.0 + Avalonia) НА Windows,
       передайте -p:ForceLinux=true (см. build-linux-single-file.ps1).
       ====================================================================== -->
  <PropertyGroup>
    <!-- BuildLinux = true при реальной сборке на Linux ИЛИ при ForceLinux=true. -->
    <BuildLinux Condition="'$(ForceLinux)' == 'true'">true</BuildLinux>
    <BuildLinux Condition="'$(BuildLinux)' == '' and !$([MSBuild]::IsOSPlatform('Windows'))">true</BuildLinux>
  </PropertyGroup>

  <!-- ======================================================================
       Windows-конфигурация (WPF): net10.0-windows
       TFM net10.0-windows автоматически определяет символ условной
       компиляции WINDOWS (и WINDOWS10_0_*), поэтому #if WINDOWS работает
       на Windows без дополнительной настройки.
       ====================================================================== -->
  <PropertyGroup Condition="'$(BuildLinux)' != 'true' and $([MSBuild]::IsOSPlatform('Windows'))">
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Точка входа написана вручную (Program.cs), а не сгенерирована из App.xaml:
         режим COM-агента нужно перехватывать до создания App и загрузки словарей тем.
         См. Program.Main и комментарий к ComReadHost. -->
    <StartupObject>Configuration_Management.Program</StartupObject>
  </PropertyGroup>

  <!-- ======================================================================
       Linux-конфигурация (Avalonia): net10.0 (без суффикса -windows)
       UseWPF / UseWindowsForms / System.Management / MaterialDesignThemes
       здесь не подключаются (нет WPF на Linux).
       ====================================================================== -->
  <PropertyGroup Condition="'$(BuildLinux)' == 'true' or !$([MSBuild]::IsOSPlatform('Windows'))">
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Символ LINUX для директив #if LINUX / #if !WINDOWS -->
    <DefineConstants>$(DefineConstants);LINUX</DefineConstants>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Общие свойства (применяются к обеим конфигурациям) -->
  <PropertyGroup>
    <!-- AssemblyName без пробела: иначе при single-file publish WPF не находит
         ресурс «app.xaml» (System.IO.IOException при запуске). -->
    <AssemblyName>ConfigurationManagement</AssemblyName>
    <RootNamespace>Configuration_Management</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyTitle>Управление конфигурациями 1С</AssemblyTitle>
    <Product>Управление конфигурациями 1С</Product>
    <!-- Примечание: .NET/NuGet поддерживают не более 4 числовых частей версии,
         поэтому AssemblyVersion/FileVersion/Version ограничены 4 частями, а точная
         пользовательская версия «0.3.1.1» задаётся через InformationalVersion
         и выводится в заголовок окна. -->
    <Version>0.3.9.43</Version>
    <AssemblyVersion>0.3.9.43</AssemblyVersion>
    <FileVersion>0.3.9.43</FileVersion>
    <InformationalVersion>0.3.9.43</InformationalVersion>
    <!-- RID/SelfContained только при publish, чтобы обычный dotnet run/build не ломался -->
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>embedded</DebugType>
    <!-- InvariantGlobalization здесь НЕ используется: на Windows/WPF он приводит к
         InvalidOperationException "Cannot find non-neutral culture related to 'en-us'"
         в XmlLanguage.GetSpecificCulture() при активации любой привязки с конвертером
         (в т.ч. {loc:Loc ...}), что роняет окно ещё на заголовке. Поэтому ICU-данные
         остаются в сборке; размер увеличивается, но WPF-интерфейс работает корректно. -->
  </PropertyGroup>

  <!-- Публикация self-contained single-file; RID зависит от ОС -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(BuildLinux)' != 'true' and $([MSBuild]::IsOSPlatform('Windows'))">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release' and ('$(BuildLinux)' == 'true' or !$([MSBuild]::IsOSPlatform('Windows')))">
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup Condition="'$(BuildLinux)' != 'true' and $([MSBuild]::IsOSPlatform('Windows'))">
    <!-- Тестам нужны чистые функции протокола и сборки строки подключения. Публичными
         их делать незачем: за пределами сборки они не имеют смысла. -->
    <InternalsVisibleTo Include="ConfigurationManagement.Tests" />
    <!-- Linux-подсистема автообновления собирается только на Linux (#if LINUX). Явно
         исключаем из Windows-сборки, чтобы она не попадала в компиляцию WPF. -->
    <Compile Remove="Services\UpdateService.Avalonia.cs" />
    <Compile Remove="Services\ManualUpdateWindow.Avalonia.cs" />
    <Compile Remove="Services\UpdateProgressWindow.Avalonia.cs" />
  </ItemGroup>

  <!-- WPF-ресурсы иконок (embedded, только Windows) -->
  <ItemGroup Condition="'$(BuildLinux)' != 'true' and $([MSBuild]::IsOSPlatform('Windows'))">
    <Resource Include="app.ico" />
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
    <Resource Include="tray.ico" />
    <EmbeddedResource Include="tray.ico" LogicalName="tray.ico" />
    <!-- Изображение во вкладке «О программе» (WPF: pack URI pack://application:,,,/donat.png) -->
    <Resource Include="donat.png" />
  </ItemGroup>

  <!-- App.xaml как Page, а не ApplicationDefinition: тогда генератор даёт
       InitializeComponent(), но не собственный Main, и точкой входа остаётся
       Program.Main из StartupObject выше. -->
  <ItemGroup Condition="'$(BuildLinux)' != 'true' and $([MSBuild]::IsOSPlatform('Windows'))">
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" SubType="Designer" Generator="MSBuild:Compile" />
  </ItemGroup>

  <!-- Пакеты: общие для обеих платформ -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
  </ItemGroup>

  <!-- ======================================================================
       Локализация: встроенные языки (ru, en) загружаются из ресурсов сборки
       на обеих платформах. Внешние языки (.json) подгружаются из папки
       Languages рядом с приложением и/или из каталога данных.
       ====================================================================== -->
  <ItemGroup>
    <EmbeddedResource Include="Localization\Languages\*.json"
                      LogicalName="cm_lang_%(Filename)%(Extension)" />
    <None Update="Localization\Languages\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Пакеты: только Windows (WPF). System.Management (Win32_Process) и
       MaterialDesignThemes (PackIcon) — Windows-only, для Linux исключены. -->
  <ItemGroup Condition="'$(BuildLinux)' != 'true' and $([MSBuild]::IsOSPlatform('Windows'))">
    <PackageReference Include="MaterialDesignThemes" Version="5.2.1" />
    <!-- Для чтения командной строки процессов 1cv8.exe (Win32_Process) при проверке
         блокировки запуска конфигуратора перед выгрузкой .dt / .cf. -->
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <!-- Разметку Avalonia окна грузят сами, вызовом AvaloniaXamlLoader.Load(this)
       из своего конструктора: компилятор превращает его в прямой вызов
       сгенерированного метода. Запасной путь через загрузчик по типу не
       используется, поэтому AVLN3001 («нет открытого конструктора без
       параметров») здесь не о чем: у части окон конструктор с параметрами,
       и заводить пустой ради инструмента значит портить их API. -->
  <PropertyGroup Condition="'$(BuildLinux)' == 'true' or !$([MSBuild]::IsOSPlatform('Windows'))">
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
  </PropertyGroup>

  <!-- Пакеты: только Linux (Avalonia). На этапе 1 подключаются как замена WPF;
       MaterialDesignThemes для Linux не подключается (полная замена иконок — позже). -->
  <ItemGroup Condition="'$(BuildLinux)' == 'true' or !$([MSBuild]::IsOSPlatform('Windows'))">
    <PackageReference Include="Avalonia" Version="11.3.20" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.20" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.20" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.20" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.20">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Иконки для трея (Linux): PNG встраиваются в сборку, чтобы трей имел иконку
       независимо от рабочего каталога. Загрузка через WindowIcon без System.Drawing. -->
  <ItemGroup Condition="'$(BuildLinux)' == 'true' or !$([MSBuild]::IsOSPlatform('Windows'))">
    <EmbeddedResource Include="tray_icon_preview.png" LogicalName="tray_icon_preview.png" />
    <EmbeddedResource Include="app_icon_preview.png" LogicalName="app_icon_preview.png" />
    <!-- Изображение во вкладке «О программе» (Avalonia/Linux): загрузка из ресурса -->
    <EmbeddedResource Include="donat.png" LogicalName="donat.png" />
  </ItemGroup>

  <!-- Не импортировать WinForms/Drawing глобально на Windows — иначе конфликт с типами WPF -->
  <ItemGroup Condition="'$(BuildLinux)' != 'true' and $([MSBuild]::IsOSPlatform('Windows'))">
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- ======================================================================
       Linux (Avalonia): исключаем WPF/Windows-only файлы из компиляции.
       Окна, контролы, конвертеры, темы и Windows-сервисы портируются на
       более поздних этапах (Этапы 3 и 5). Для Linux остаются: App.axaml/.cs,
       Program.cs, MainWindow.Avalonia.cs (заглушка), чистые .NET-модели и
       сервисы.
       .xaml-файлы здесь не компилируются (нет UseWPF/Avalonia для .xaml),
       поэтому достаточно удалить их code-behind (.cs).
       ====================================================================== -->
  <ItemGroup Condition="'$(BuildLinux)' == 'true' or !$([MSBuild]::IsOSPlatform('Windows'))">
    <!-- WPF App (вместо него — App.axaml/.cs) -->
    <Compile Remove="App.xaml.cs" />
    <!-- Окна (код за разметкой; разметка .xaml в Linux не компилируется).
         Окна лежат в Views/ (см. иерархию проекта в ARCHITECTURE.md). -->
    <Compile Remove="Views\MainWindow.xaml.cs" />
    <Compile Remove="Views\AddEditWindow.xaml.cs" />
    <Compile Remove="Views\CacheCleanWindow.xaml.cs" />
    <Compile Remove="Views\ColorPickerWindow.xaml.cs" />
    <Compile Remove="Views\ConnectionSettingsWindow.xaml.cs" />
    <Compile Remove="Views\ConnectionStringInputWindow.xaml.cs" />
    <Compile Remove="Views\CreateInfobaseWindow.xaml.cs" />
    <Compile Remove="Views\DeleteInfobaseWindow.xaml.cs" />
    <Compile Remove="Views\GroupEditWindow.xaml.cs" />
    <Compile Remove="Views\GroupPickerWindow.xaml.cs" />
    <Compile Remove="Views\LaunchParametersWindow.xaml.cs" />
    <Compile Remove="Views\LinkInputWindow.xaml.cs" />
    <Compile Remove="Views\NameInputWindow.xaml.cs" />
    <Compile Remove="Views\PlatformVersionPickerWindow.xaml.cs" />
    <Compile Remove="Views\SettingsWindow.xaml.cs" />
    <Compile Remove="Views\LoginWindow.xaml.cs" />
    <Compile Remove="Views\ProfilesPanel.xaml.cs" />
    <Compile Remove="Views\SettingsWindow.Accounts.cs" />
    <!-- Окна Этапа 1 (проверка обновлений конфигураций): WPF code-behind исключается,
         Avalonia-версии (*Window.Avalonia.cs) подключаются глобом ниже. -->
    <Compile Remove="Views\ConfigTypesEditWindow.xaml.cs" />
    <Compile Remove="Views\UpdateCheckWindow.xaml.cs" />
    <Compile Remove="Views\ActualReleasesWindow.xaml.cs" />
    <Compile Remove="Views\ConfigUpdateLinkWindow.xaml.cs" />
    <!-- Окна Этапа 2 (сценарии резервирования и список выгрузок): WPF code-behind
         исключается, Avalonia-версии (*Window.Avalonia.cs) подключаются глобом ниже. -->
    <Compile Remove="Views\BackupScenariosWindow.xaml.cs" />
    <Compile Remove="Views\BackupScenarioEditWindow.xaml.cs" />
    <Compile Remove="Views\ExportsListWindow.xaml.cs" />
    <!-- Кастомные контролы (WPF) исключаем, но возвращаем Avalonia-версии (*.Avalonia.cs) -->
    <Compile Remove="Controls\**\*.cs" />
    <Compile Include="Controls\*.Avalonia.cs" />
    <!-- Конвертеры (WPF) исключаем, но возвращаем Avalonia-версии (Converters/Avalonia/*) -->
    <Compile Remove="Converters\**\*.cs" />
    <Compile Include="Converters\Avalonia\*.cs" />
    <!-- Темы (WPF) исключаем; вместо них полный ThemeManager.Avalonia.cs
         (подключается автоматически дефолтным глобом). -->
    <Compile Remove="Themes\ThemeManager.cs" />
    <!-- ViewModels: подключаем Avalonia-версии (*.Avalonia.cs) и чистые .NET (без WPF-зависимостей).
         WPF-зависимые ViewModel (MainViewModel.cs, GroupNodeViewModel.cs, RelayCommand.cs и др.) исключаются. -->
    <Compile Remove="ViewModels\**\*.cs" />
    <Compile Include="ViewModels\*.Avalonia.cs" />
    <!-- MainViewModel.Avalonia.cs разбит на partial-файлы по ответственности
         (имена «MainViewModel.Avalonia.*.cs» не совпадают с глобом *.Avalonia.cs),
         поэтому каждый добавляется явно. -->
    <Compile Include="ViewModels\MainViewModel.Avalonia.Commands.cs" />
    <Compile Include="ViewModels\MainViewModel.Avalonia.Display.cs" />
    <Compile Include="ViewModels\MainViewModel.Avalonia.Launch.cs" />
    <Compile Include="ViewModels\MainViewModel.Avalonia.SwitchUser.cs" />
    <Compile Include="ViewModels\MainViewModel.Avalonia.Sync.cs" />
    <Compile Include="ViewModels\MainViewModel.Avalonia.Theme.cs" />
    <Compile Include="ViewModels\MainViewModel.Avalonia.Tools.cs" />
    <!-- Модель чипа тега панели быстрого отбора (Avalonia/Linux, #if LINUX): вынесена
         из монолита MainViewModel.Avalonia.cs, поэтому добавляется явно. -->
    <Compile Include="ViewModels\TagFilterItem.cs" />
    <!-- Чистая логика слотов закладок (горячие клавиши избранных): используется
         и Windows, и Linux, поэтому подключается явно (не попадает под глоб *.Avalonia.cs). -->
    <Compile Include="ViewModels\BookmarkSlotHelper.cs" />
    <Compile Include="ViewModels\ConnectionSettingsViewModel.cs" />
    <!-- Общая модель строки диалога «Определение конфигураций всех баз» (issue #236):
         чистый .NET без WPF-зависимостей, используется и Windows, и Linux. -->
    <Compile Include="ViewModels\DetectConfigRowViewModel.cs" />
    <!-- Общая модель строки диалога «Очистка истории запусков» (issue #246):
         чистый .NET без WPF-зависимостей, используется и Windows, и Linux. -->
    <Compile Include="ViewModels\ClearHistoryRowViewModel.cs" />
    <!-- Общие модели окна «Проверка обновлений конфигураций» (Этап 1, функции №21/№22):
         чистый .NET без WPF-зависимостей, используются и Windows, и Linux. -->
    <Compile Include="ViewModels\ConfigTypeItemViewModel.cs" />
    <Compile Include="ViewModels\UpdateCheckRowViewModel.cs" />
    <Compile Include="ViewModels\ActualReleasesViewModel.cs" />
    <!-- Команды проверки обновлений MainViewModel (Avalonia/Linux): файл не совпадает
         с глобом *.Avalonia.cs (имя «MainViewModel.Avalonia.*.cs»), добавляется явно. -->
    <Compile Include="ViewModels\MainViewModel.Avalonia.Updates.cs" />
    <!-- Общая модель строки диалога «Поиск потерянных баз 1С» (issue #247):
         чистый .NET без WPF-зависимостей, используется и Windows, и Linux. -->
    <Compile Include="ViewModels\FoundBaseRowViewModel.cs" />
    <!-- Модели и ViewModels Этапа 2 (сценарии резервирования, список выгрузок):
         чистый .NET без WPF-зависимостей, используются и Windows, и Linux. -->
    <Compile Include="ViewModels\BackupScenarioItemViewModel.cs" />
    <Compile Include="ViewModels\BackupScenarioEditViewModel.cs" />
    <Compile Include="ViewModels\ExportsListViewModel.cs" />
    <!-- Команды сценариев резервирования MainViewModel (Avalonia/Linux): имя
         «MainViewModel.Avalonia.*.cs» не совпадает с глобом *.Avalonia.cs, добавляется явно. -->
    <Compile Include="ViewModels\MainViewModel.Avalonia.Backup.cs" />
    <!-- Команды блокировки сеансов ИБ и временной блокировки приложения (Этап 3,
         функции №19/№20): имя не совпадает с глобом *.Avalonia.cs, добавляется явно. -->
    <Compile Include="ViewModels\MainViewModel.Avalonia.SessionLock.cs" />
    <!-- Команды администрирования ИБ (Этап 6, функция №29 + консоль серверов): имя
         не совпадает с глобом *.Avalonia.cs, добавляется явно. -->
    <Compile Include="ViewModels\MainViewModel.Avalonia.Admin.cs" />
    <!-- Автозапуск при старте ОС и копия экрана (Этап 8, функции №31/№30): имя
         «MainViewModel.Avalonia.*.cs» не совпадает с глобом *.Avalonia.cs, добавляется явно. -->
    <Compile Remove="ViewModels\MainViewModel.Avalonia.AutoStart.cs" />
    <Compile Include="ViewModels\MainViewModel.Avalonia.AutoStart.cs" />
    <!-- Режим функциональности (Этап 10 StartManager): имя «MainViewModel.Avalonia.*.cs»
         не совпадает с глобом *.Avalonia.cs, добавляется явно. -->
    <Compile Include="ViewModels\MainViewModel.Avalonia.Functional.cs" />
    <!-- Windows-only сервисы — Этап 5 -->
    <Compile Remove="Services\WpfDialogService.cs" />
    <!-- Проверка обновлений из GitHub Releases кроссплатформенная: на Linux тоже используется
         автообновлением (UpdateService.Avalonia.cs), поэтому файл НЕ исключается. -->
    <Compile Remove="Services\MaterialMessageWindow.xaml.cs" />
    <Compile Remove="Services\MaterialMessageKind.cs" />
    <Compile Include="Services\MaterialMessageKind.cs" />
    <!-- WPF-подсистема автообновления (UpdateService.cs) исключается; на Linux её заменяет
         UpdateService.Avalonia.cs. WPF-диалог обновления UpdateAvailableWindow также исключается:
         на Linux вопрос задаётся через AvaloniaDialogService. -->
    <Compile Remove="Services\UpdateService.cs" />
    <Compile Remove="Services\UpdateAvailableWindow.xaml.cs" />
    <Compile Remove="Services\OneCLauncher.cs" />
    <Compile Remove="Services\OneCLauncher.DesignerBatch.cs" />
    <Compile Remove="Services\OneCLauncher.Arguments.cs" />
    <Compile Remove="Services\OneCComConnector.cs" />
    <Compile Remove="Services\OneCComConnectorRegistrar.cs" />
    <Compile Remove="Services\ComReadHost.cs" />
    <!-- Интеграция с проводником Windows (функция №12): файлы под #if WINDOWS исключаются
         из Linux-сборки; заглушка ExplorerIntegrationService.Avalonia.cs включается глобом. -->
    <Compile Remove="Services\ExplorerCommandLine.cs" />
    <Compile Remove="Services\ExplorerIntegrationService.cs" />
    <Compile Remove="Services\PlatformVersionService.cs" />
    <Compile Remove="Services\InfobaseMaintenanceService.cs" />
    <Compile Remove="Services\InfobaseMaintenanceService.FileBase.cs" />
    <Compile Remove="Services\InfobaseMaintenanceService.Processes.cs" />
    <Compile Remove="Services\InfobaseMaintenanceService.Shortcuts.cs" />
    <!-- OneCTemplateService портирован на Linux (Этап 4): пути tmplts, чтение
         1cestart.cfg вместо реестра; реестр обёрнут в #if WINDOWS. -->
    <!-- Окна (Этап 3): портированные Avalonia-версии (*.Avalonia.cs) в Views/.
         Remove затем Include — чтобы не было конфликта с дефолтным глобом SDK. -->
    <Compile Remove="Views\*Window.Avalonia.cs" />
    <Compile Include="Views\*Window.Avalonia.cs" />
    <!-- MainWindow.Avalonia.cs разбит на partial-файлы по ответственности
         (имена «MainWindow.Avalonia.*.cs» не совпадают с глобом *Window.Avalonia.cs),
         поэтому каждый добавляется явно. -->
    <Compile Remove="Views\MainWindow.Avalonia.Controls.cs" />
    <Compile Include="Views\MainWindow.Avalonia.Controls.cs" />
    <Compile Remove="Views\MainWindow.Avalonia.Columns.cs" />
    <Compile Include="Views\MainWindow.Avalonia.Columns.cs" />
    <Compile Remove="Views\MainWindow.Avalonia.DragDrop.cs" />
    <Compile Include="Views\MainWindow.Avalonia.DragDrop.cs" />
    <Compile Remove="Views\MainWindow.Avalonia.Events.cs" />
    <Compile Include="Views\MainWindow.Avalonia.Events.cs" />
    <Compile Remove="Views\MainWindow.Avalonia.Hotkeys.cs" />
    <Compile Include="Views\MainWindow.Avalonia.Hotkeys.cs" />
    <Compile Remove="Views\MainWindow.Avalonia.Language.cs" />
    <Compile Include="Views\MainWindow.Avalonia.Language.cs" />
    <Compile Remove="Views\MainWindow.Avalonia.Scroll.cs" />
    <Compile Include="Views\MainWindow.Avalonia.Scroll.cs" />
    <Compile Remove="Views\MainWindow.Avalonia.Tags.cs" />
    <Compile Include="Views\MainWindow.Avalonia.Tags.cs" />
    <Compile Remove="Views\MainWindow.Avalonia.Tray.cs" />
    <Compile Include="Views\MainWindow.Avalonia.Tray.cs" />
    <Compile Remove="Views\MainWindow.Avalonia.Tree.cs" />
    <Compile Include="Views\MainWindow.Avalonia.Tree.cs" />
    <!-- SettingsWindow.Avalonia.cs разбит на partial-файлы по ответственности
         (имена «SettingsWindow.Avalonia.*.cs» не совпадают с глобом *Window.Avalonia.cs),
         поэтому каждый добавляется явно. -->
    <Compile Remove="Views\SettingsWindow.Avalonia.Accounts.cs" />
    <Compile Include="Views\SettingsWindow.Avalonia.Accounts.cs" />
    <Compile Remove="Views\SettingsWindow.Avalonia.Display.cs" />
    <Compile Include="Views\SettingsWindow.Avalonia.Display.cs" />
    <Compile Remove="Views\SettingsWindow.Avalonia.Fonts.cs" />
